<div class="combat-history-dialog">
    <table class="combat-history-table">
        <thead>
            <tr>
                <th>{{ localize "rmss.combat.history.character" }}</th>
                <th>{{ localize "rmss.combat.history.crits_inflicted" }}</th>
                <th>{{ localize "rmss.combat.history.crits_received" }}</th>
                <th>{{ localize "rmss.combat.history.hp_inflicted" }}</th>
                <th>{{ localize "rmss.combat.history.hp_received" }}</th>
                <th>{{ localize "rmss.combat.history.kills" }}</th>
            </tr>
        </thead>
        <tbody>
            {{#each rows as |row|}}
            <tr>
                <td class="character-cell">
                    {{#if row.img}}<img src="{{row.img}}" alt="{{row.name}}" width="32" height="32" class="character-portrait"/>{{/if}}
                    <span>{{ row.name }}</span>
                </td>
                <td>{{ row.critsInflicted }}</td>
                <td>{{ row.critsReceived }}</td>
                <td>{{ row.hpInflicted }}</td>
                <td>{{ row.hpReceived }}</td>
                <td>{{ row.kills }}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
