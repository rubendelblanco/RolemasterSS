<form id="rmss-critical-melee-confirmation">
    <h3><img src="{{enemy.img}}" alt="{{enemy.name}}" width="50" height="50"> {{ localize "rmss.combat.critical_roll" }}
    </h3>
    <div class="form-group attacker" style="flex-direction: row; flex-wrap: wrap; gap: 1em;">
        <div style="flex-direction: row; align-items: center; gap: 0.5em;">
            <label for="damage">{{ localize "rmss.combat.damage" }}</label>
            <input class="is-positive" type="hidden" id="damage-base" data-dtype="Number" name="damage-base"
                value="{{damage}}">
            <input class="is-positive" type="number" id="damage" data-dtype="Number" name="damage" value="{{initialDamage}}">
        </div>

        <div style="flex-direction: row; align-items: center; gap: 0.5em;">
            <label for="damage-mult">{{ localize "rmss.combat.multiplier" }}</label>
            <select id="damage-mult">
                <option value="1" {{#if (eq damageMultiplier 1)}}selected{{/if}}>x1</option>
                <option value="2" {{#if (eq damageMultiplier 2)}}selected{{/if}}>x2</option>
                <option value="3" {{#if (eq damageMultiplier 3)}}selected{{/if}}>x3</option>
                <option value="4" {{#if (eq damageMultiplier 4)}}selected{{/if}}>x4</option>
                <option value="5" {{#if (eq damageMultiplier 5)}}selected{{/if}}>x5</option>
                <option value="6" {{#if (eq damageMultiplier 6)}}selected{{/if}}>x6</option>
                <option value="7" {{#if (eq damageMultiplier 7)}}selected{{/if}}>x7</option>
                <option value="8" {{#if (eq damageMultiplier 8)}}selected{{/if}}>x8</option>
                <option value="9" {{#if (eq damageMultiplier 9)}}selected{{/if}}>x9</option>
                <option value="10" {{#if (eq damageMultiplier 10)}}selected{{/if}}>x10</option>
            </select>
        </div>

        <div style="flex-direction: row; align-items: center; gap: 0.5em;">
            <label for="severity">{{ localize "rmss.combat.critical_severity" }}</label>
            <select name="severity" id="severity">
                {{#if useLargeCreatureSeverityLabels}}
                <option value="normal" {{#if (eq severity "normal" )}}selected{{/if}}>{{ localize "rmss.combat.severity_normal" }}</option>
                <option value="magic" {{#if (eq severity "magic" )}}selected{{/if}}>{{ localize "rmss.combat.severity_magical" }}</option>
                <option value="mithril" {{#if (eq severity "mithril" )}}selected{{/if}}>{{ localize "rmss.combat.severity_mithril" }}</option>
                <option value="holy" {{#if (eq severity "holy" )}}selected{{/if}}>{{ localize "rmss.combat.severity_holy" }}</option>
                <option value="slaying" {{#if (eq severity "slaying" )}}selected{{/if}}>{{ localize "rmss.combat.severity_slaying" }}</option>
                {{else}}
                <option value="null" {{#if (eq severity "null" )}}selected{{/if}}>-</option>
                <option value="A" {{#if (eq severity "A" )}}selected{{/if}}>A</option>
                <option value="B" {{#if (eq severity "B" )}}selected{{/if}}>B</option>
                <option value="C" {{#if (eq severity "C" )}}selected{{/if}}>C</option>
                <option value="D" {{#if (eq severity "D" )}}selected{{/if}}>D</option>
                <option value="E" {{#if (eq severity "E" )}}selected{{/if}}>E</option>
                {{!-- F+ are not table columns (F = E+A, G = E+B, …); only A–E exist on critical tables. --}}
                {{/if}}
            </select>
        </div>

        <div style="flex-direction: row; align-items: center; gap: 0.5em;">
            <label>{{ localize "rmss.combat.critical_type" }}</label>
            <select id="critical-type">
                {{#each critDict}}
                <option value="{{@key}}" {{#if (eq @key ../critType)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>

        <div id="critical-subtype-container" style="flex-direction: row; align-items: center; gap: 0.5em;">
            <label>{{ localize "rmss.combat.critical_subtype" }}</label>
            <select id="critical-subtype">
                {{#each subcritdict}}
                <option value="{{@key}}" {{#if (eq @key ../subCritType)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>

        <div style="flex-direction: row; align-items: center; gap: 0.5em;">
            <label>{{ localize "rmss.combat.critical_modifier" }}</label>
            <input type="number" id="modifier" data-dtype="Number" name="modifier" value="{{modifier}}">
        </div>
    </div>
</form>