<form class="{{cssClass}}" autocomplete="off">
    <header class="sheet-header">
        <img src="{{item.img}}" data-edit="img" title="{{item.name}}" height="64" width="64"/>
        <h1><input name="name" type="text" value="{{item.name}}" placeholder="{{ localize 'Name' }}"/></h1>
    </header>
    <div class="sheet-content">
        <table>
            <tr>
                <th>{{localize "rmss.creature_attack.attack_table"}}</th>
                <th>{{localize "rmss.creature_attack.bonus"}}</th>
                <th>{{localize "rmss.creature_attack.multiplier"}}</th>
                <th>{{localize "rmss.creature_attack.attacks_number"}}</th>
                {{#if actorId}}
                    <th>{{localize "rmss.creature_attack.probability"}}</th>
                    <th>{{localize "rmss.creature_attack.special"}}</th>
                {{/if}}
            </tr>
            <tr>
                <td>
                    <select name="system.attack_table" class="app-stat-selector" value="{{system.attack_table}}" itemid="{{ item._id }}">
                        {{#each armsTables as |key|}}
                            <option value="{{key}}" {{#if (eq key ../system.attack_table)}}selected{{/if}}>
                                {{localize (concat "rmss.attack_table." key)}}
                            </option>
                        {{/each}}
                    </select>
                </td>
                <td>
                    <input name="system.bonus" type="text" value="{{system.bonus}}" data-dtype="Number"/>
                </td>
                <td>
                    <select name="system.multiplier" data-dtype="Number">
                        <option value="1" {{#if (or (eq system.multiplier 1) (eq system.multiplier "1"))}}selected{{/if}}>1D</option>
                        <option value="2" {{#if (or (eq system.multiplier 2) (eq system.multiplier "2"))}}selected{{/if}}>2D</option>
                        <option value="3" {{#if (or (eq system.multiplier 3) (eq system.multiplier "3"))}}selected{{/if}}>3D</option>
                        <option value="4" {{#if (or (eq system.multiplier 4) (eq system.multiplier "4"))}}selected{{/if}}>4D</option>
                        <option value="5" {{#if (or (eq system.multiplier 5) (eq system.multiplier "5"))}}selected{{/if}}>5D</option>
                        <option value="6" {{#if (or (eq system.multiplier 6) (eq system.multiplier "6"))}}selected{{/if}}>6D</option>
                    </select>
                </td>
                <td>
                    <input name="system.attacks_number" type="text" value="{{system.attacks_number}}" data-dtype="Number"/>
                </td>
                {{#if actorId}}
                <td>
                    <input name="system.probability" type="text" value="{{system.probability}}" data-dtype="Number"/>
                </td>
                <td>
                {{#unless (eq system.order 1)}}
                    <select name="system.special">
                        <option value="none" {{#if (eq system.special "none")}}selected{{/if}}>{{ localize "rmss.creature_attack.special_desc.none" }}</option>
                        <option value="same" {{#if (eq system.special "same")}}selected{{/if}}>{{ localize "rmss.creature_attack.special_desc.same" }}</option>
                        <option value="next" {{#if (eq system.special "next")}}selected{{/if}}>{{ localize "rmss.creature_attack.special_desc.next" }}</option>
                    </select>
                {{/unless}}
                {{/if}}
                </td>
            </tr>
        </table>

        <table class="rmss-creature-attack-effects">
            <tr>
                <th colspan="2">{{localize "rmss.creature_attack.attack_effects_header"}}</th>
            </tr>
            <tr>
                <td>{{localize "rmss.item.weapon_effects_effect_weapon"}}
                    <i class="fas fa-info-circle spell-info-icon" data-tooltip="{{localize 'rmss.item.weapon_effects_effect_weapon_hint'}}"></i></td>
                <td>
                    <div class="rmss-effect-weapon-selects">
                        <select name="system.attack_effects.effect_weapon" data-dtype="String">
                            <option value="" {{#unless system.attack_effects.effect_weapon}}selected{{/unless}}>{{localize "rmss.item.weapon_effects_none"}}</option>
                            <option value="minor" {{#if (eq system.attack_effects.effect_weapon "minor")}}selected{{/if}}>{{localize "rmss.item.weapon_effects_ew_minor"}}</option>
                            <option value="normal" {{#if (eq system.attack_effects.effect_weapon "normal")}}selected{{/if}}>{{localize "rmss.item.weapon_effects_ew_normal"}}</option>
                            <option value="greater" {{#if (eq system.attack_effects.effect_weapon "greater")}}selected{{/if}}>{{localize "rmss.item.weapon_effects_ew_greater"}}</option>
                            <option value="superior" {{#if (eq system.attack_effects.effect_weapon "superior")}}selected{{/if}}>{{localize "rmss.item.weapon_effects_ew_superior"}}</option>
                        </select>
                        <select name="system.attack_effects.effect_weapon_critical_type" data-dtype="String" title="{{localize 'rmss.item.weapon_effects_effect_weapon_critical_hint'}}">
                            <option value="" disabled {{#unless system.attack_effects.effect_weapon_critical_type}}selected{{/unless}}>{{localize "rmss.item.weapon_effects_ew_crit_placeholder"}}</option>
                            {{#each criticalTables as |key|}}
                            <option value="{{key}}" {{#if (eq key ../system.attack_effects.effect_weapon_critical_type)}}selected{{/if}}>{{localize (concat "rmss.critical_table." key)}}</option>
                            {{/each}}
                        </select>
                    </div>
                </td>
            </tr>
            <tr>
                <td>{{localize "rmss.item.weapon_effects_fixed_severity"}}
                    <i class="fas fa-info-circle spell-info-icon" data-tooltip="{{localize 'rmss.item.weapon_effects_fixed_severity_hint'}}"></i></td>
                <td>
                    <select name="system.attack_effects.effect_weapon_fixed_severity" data-dtype="String">
                        <option value="" {{#unless system.attack_effects.effect_weapon_fixed_severity}}selected{{/unless}}>{{localize "rmss.item.weapon_effects_fixed_severity_none"}}</option>
                        <option value="A" {{#if (eq system.attack_effects.effect_weapon_fixed_severity "A")}}selected{{/if}}>A</option>
                        <option value="B" {{#if (eq system.attack_effects.effect_weapon_fixed_severity "B")}}selected{{/if}}>B</option>
                        <option value="C" {{#if (eq system.attack_effects.effect_weapon_fixed_severity "C")}}selected{{/if}}>C</option>
                        <option value="D" {{#if (eq system.attack_effects.effect_weapon_fixed_severity "D")}}selected{{/if}}>D</option>
                        <option value="E" {{#if (eq system.attack_effects.effect_weapon_fixed_severity "E")}}selected{{/if}}>E</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>{{localize "rmss.item.weapon_effects_increased_critical"}}
                    <i class="fas fa-info-circle spell-info-icon" data-tooltip="{{localize 'rmss.item.weapon_effects_increased_critical_hint'}}"></i></td>
                <td><input type="checkbox" name="system.attack_effects.increased_critical" {{checked system.attack_effects.increased_critical}}/></td>
            </tr>
        </table>
    </div>
</form>
