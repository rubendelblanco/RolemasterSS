<table class="skills-table">
    <thead>
        <tr>
            <th>{{ localize "rmss.pc_sheet_skills.favorite" }}</th>
            <th></th>
            <th>{{ localize "rmss.pc_sheet_skills.skill_name" }}</th>
            <th class="sortable-header" data-sort-key="development_cost">{{ localize "rmss.pc_sheet_skill_categories.dev_cost" }}</th>
            <th class="sortable-header" data-sort-key="ranks">{{ localize "rmss.pc_sheet_skills.ranks" }}</th>
            <th>{{ localize "rmss.pc_sheet_skills.new_ranks" }}</th>
            <th>{{ localize "rmss.pc_sheet_skills.rank_bonus" }}</th>
            <th>{{ localize "rmss.pc_sheet_skills.category_bonus" }}</th>
            <th>{{ localize "rmss.pc_sheet_skills.item_bonus" }}</th>
            <th>{{ localize "rmss.pc_sheet_skills.special_bonus" }}</th>
            <th>{{ localize "rmss.pc_sheet_skills.special_bonus" }}</th>
            <th class="sortable-header" data-sort-key="total_bonus">{{ localize "rmss.pc_sheet_skills.total_bonus" }}</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {{#each skills as |skill id|}}
        <tr class="skill-row" draggable="true" data-type="Item" data-uuid="Actor.{{skill.actorId}}.Item.{{skill._id}}" data-item-id="{{skill._id}}" data-category-group="{{skill.categoryGroup}}" data-total-bonus="{{skill.system.total_bonus}}" data-development-cost="{{skill.system.development_cost}}" data-ranks="{{skill.system.ranks}}">
            <td data-search="{{skill.name}}">
                {{#if skill.system.favorite}}
            <a class="skill-favorite" data-item-id="{{skill._id}}"><i class="fa-regular fa-square-check"></i></a>
                {{else}}
            <a class="skill-favorite" data-item-id="{{skill._id}}"><i class="fa-regular fa-square"></i></a>
                {{/if}}
            </td>
            <td data-search="{{skill.name}}"><span class="list-item-icon-wrap"><img class="list-item-icon" src="{{skill.img}}" alt="{{skill.name}}" width="32" height="32"/></span></td>
            <td class="skill-name-cell" data-search="{{skill.name}}" {{#if (eq skill.system.designation "Occupational" )}} style="color:blue;" {{else if (eq skill.system.designation "Everyman" )}} style="color:green;" {{else if (eq skill.system.designation "Restricted" )}} style="color:red;" {{/if}}>
                <a class="item-roll" title="Roll Check" data-item-id="{{skill._id}}">{{skill.name}}<i class="fas fa-dice"></i></a>{{#if skill.system.description}}
                <i class="fas fa-info-circle spell-info-icon"
                   data-tooltip="{{skill.system.description}}"></i>
                {{/if}}
            </td>
            <td data-search="{{skill.name}}">{{skill.system.development_cost}}</td>
            <td data-search="{{skill.name}}">{{skill.system.ranks}}</td>
            <td data-search="{{skill.name}}">
                <a class="skill-newrank" data-category-id="{{skill.system.category}}" data-item-id="{{skill._id}}" value="{{skill.system.new_ranks.value}}">
                    {{#times skill.newRankMax}}
                    {{#if (lt this ../system.new_ranks.value)}}<i class="fa-regular fa-square-check"></i>{{else}}<i class="fa-regular fa-square"></i>{{/if}}
                    {{/times}}
                </a>
            </td>
            <td data-search="{{skill.name}}">{{skill.system.rank_bonus}}</td>
            <td data-search="{{skill.name}}">{{skill.system.category_bonus}}</td>
            <td data-search="{{skill.name}}">{{skill.system.item_bonus}}</td>
            <td data-search="{{skill.name}}">{{skill.system.special_bonus_1}}</td>
            <td data-search="{{skill.name}}">{{skill.system.special_bonus_2}}</td>
            <td data-search="{{skill.name}}">{{skill.system.total_bonus}}</td>
            <td data-search="{{skill.name}}">
                <a class="item-edit" title="Edit Skill" data-item-id="{{skill._id}}"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="Delete Skill" data-item-id="{{skill._id}}"><i class="fas fa-trash"></i></a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>
