{{!-- BE/DE elemental: mismo layout que attack-result; cálculos con .rmss-chat-gm-only (hooks.js) --}}
<div style="border: 1px solid #444;margin-bottom:10px; border-radius: 8px; padding: 10px; background: rgba(0,0,0,0.3); box-shadow: 0 0 6px rgba(0,0,0,0.5); font-family: 'Signika', sans-serif;">

    <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 8px;">
        <div style="text-align: center;">
            <img title="{{actorName}}" src="{{actorImg}}" width="50" height="50" style="border-radius: 6px; border: 1px solid #666;">
            <div style="font-size: 1.2em; color: #fff;">{{actorName}}</div>
        </div>
        <div style="font-weight: bold; font-size: 1.1em; color: #ffcc00; text-shadow: 0 0 6px #000;">VS</div>
        <div style="text-align: center;">
            <img title="{{targetName}}" src="{{targetImg}}" width="50" height="50" style="border-radius: 6px; border: 1px solid #666;">
            <div style="font-size: 1.2em; color: #fff;">{{targetName}}</div>
        </div>
    </div>

    <div style="text-align: center; color: #fff; font-size: 1.2em; line-height: 1.4;">
        {{{publicBylineHtml}}}
    </div>

    <div class="rmss-chat-gm-only" style="text-align: left; color: #e8e8e8; font-size: 0.95em; line-height: 1.5; margin-top: 6px; padding: 4px 2px; border: 1px solid #3a3a3a; border-radius: 6px; background: rgba(0,0,0,0.2);">
        <div style="font-weight:700; color:#ffd35c; margin-bottom:4px; border-bottom:1px solid #444; padding-bottom:4px;">
            {{localize "rmss.spells.be_attack_breakdown_title"}}
        </div>
        <div>
            <span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_step_roll"}}</span>
            {{naturalRoll}}{{#if isExplosive}} <span style="color:#ff9f4a;">→ {{rollTotal}}</span> <span style="color:#999;font-size:0.88em;">({{localize "rmss.spells.open_ended_short"}})</span>{{/if}}
        </div>
        <div>
            <span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_step_diff"}}</span> <strong>{{diffFmt}}</strong>
        </div>
        {{#if isUm}}
        <div>
            <span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_step_ear"}}</span>
            <strong style="color:#7cfcb0;">{{baseEnergy}}</strong>
            <span style="color:#8ec5ff; font-size:0.9em;"> — {{localize "rmss.spells.unmodified"}}</span>
        </div>
        {{else}}
        <div>
            <span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_subtotal_mod"}}</span> <strong>{{finalResult}}</strong>
        </div>
        <div>
            <span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_step_ear"}}</span> <strong style="color:#7cfcb0;">{{baseEnergy}}</strong>
        </div>
        {{/if}}
        {{#if isAreaBall}}
        <div><span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_step_db_no_shield"}}</span> <strong style="color:#f8a0a0;">{{targetDefense}}</strong></div>
        {{#if hasCenterBonus}}
        <div><span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_step_center"}}</span> <strong style="color:#7cfcb0;">+{{centerBonus}}</strong></div>
        {{/if}}
        {{else}}
        <div><span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_step_db"}}</span> <strong style="color:#f8a0a0;">{{targetDefense}}</strong></div>
        {{#if hasAreaPenalty}}
        <div><span style="color:#9cf;">{{localize "rmss.spells.be_attack_breakdown_step_area_multi"}}</span> <strong style="color:#f8a0a0;">−{{areaPenalty}}</strong></div>
        {{/if}}
        {{/if}}
        <div style="margin-top:4px; padding-top:4px; border-top:1px solid #3a3a3a;">
            <span style="color:#ccc;">{{localize "rmss.spells.be_attack_breakdown_index"}}</span>
            <strong style="color:#ffe066;">{{finalForTarget}}</strong>
        </div>
        <div>
            <span style="color:#aaa;">{{localize "rmss.spells.be_attack_breakdown_table_cell"}}</span>
            <strong style="color:#fff;">{{tableCellDisplay}}</strong>
        </div>
    </div>

    <hr style="border:none; border-top:1px solid #333; margin:8px 0;">

    <div style="
      text-align: center;
      background: radial-gradient(circle, rgba(255,215,0,0.2) 0%, rgba(255,165,0,0.1) 80%);
      color: #fff;
      font-size: 1.1em;
      font-weight: bold;
      text-shadow: 0 0 5px #000, 0 0 8px #ff0;
      border-radius: 6px;
      padding: 6px;
      margin-top: 4px;
      ">
        {{{publicRollSummaryHtml}}}
    </div>
</div>
