<div class="rmss-critical-chat-card" style="border: 1px solid #444; margin-bottom: 10px; border-radius: 8px; padding: 10px; background: rgba(0,0,0,0.3); box-shadow: 0 0 6px rgba(0,0,0,0.5); font-family: 'Signika', sans-serif;">

    <div style="text-align: center; color: #ffd700; font-size: 1.15em; font-weight: bold; text-shadow: 0 0 4px #000; margin-bottom: 8px;">
        {{localize "rmss.combat.critical_roll_banner"}}
    </div>

    {{#if targetDisplay}}
    <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 8px;">
        <div style="text-align: center;">
            <img title="{{attacker.name}}" src="{{attacker.img}}" width="50" height="50" style="border-radius: 6px; border: 1px solid #666;">
            <div style="font-size: 1.2em; color: #fff;">{{attacker.name}}</div>
        </div>
        <div style="font-weight: bold; font-size: 1.1em; color: #ffcc00; text-shadow: 0 0 6px #000;">VS</div>
        <div style="text-align: center;">
            <img title="{{targetDisplay.name}}" src="{{targetDisplay.img}}" width="50" height="50" style="border-radius: 6px; border: 1px solid #666;">
            <div style="font-size: 1.2em; color: #fff;">{{targetDisplay.name}}</div>
        </div>
    </div>
    {{else}}
    <div style="display: flex; justify-content: center; margin-bottom: 8px;">
        <div style="text-align: center;">
            <img title="{{attacker.name}}" src="{{attacker.img}}" width="50" height="50" style="border-radius: 6px; border: 1px solid #666;">
            <div style="font-size: 1.2em; color: #fff;">{{attacker.name}}</div>
        </div>
    </div>
    {{/if}}

    <div style="text-align: center; color: #fff; font-size: 1.05em; line-height: 1.4;">
        {{damageStr}}
    </div>

    {{#if isNullResult}}
        <hr style="border: none; border-top: 1px solid #333; margin: 8px 0;">
        <p style="text-align: center; margin: 0; color: #fff; font-style: italic;">
            {{localize "rmss.combat.attack_no_result"}} 😢
        </p>
    {{else if hpDamageOnly}}
        <hr style="border: none; border-top: 1px solid #333; margin: 8px 0;">
        <p style="text-align: center; margin: 0; color: #cfe8ff; font-size: 0.95em;">
            {{hpDamageOnlyLine}}
        </p>
    {{else if criticals.length}}
        <hr style="border: none; border-top: 1px solid #333; margin: 8px 0;">

        <div class="rmss-chat-criticals-list" style="display: flex; flex-direction: column; gap: 8px; align-items: stretch;">

            {{#each criticals}}
            <div class="rmss-crit-slot-host">
                <button class="chat-critical-roll"
                        type="button"
                        data-crit-slot="{{@index}}"
                        data-attacker="{{../attacker.id}}"
                        data-attacker-uuid="{{../attacker.uuid}}"
                        data-damage="{{damage}}"
                        data-severity="{{severity}}"
                        data-crittype="{{critType}}"
                        {{#if ../mainSeverity}}data-main-severity="{{../mainSeverity}}"{{/if}}
                        {{#if effectWeaponPair.duplicatePrimary}}data-effect-weapon-dup="1"{{/if}}
                        {{#if effectWeaponPair.secondSeverity}}data-effect-weapon-second="{{effectWeaponPair.secondSeverity}}"{{/if}}
                        {{#if effectWeaponPair.extraCritType}}data-effect-weapon-extra-crit-type="{{effectWeaponPair.extraCritType}}"{{/if}}
                        {{#if effectWeaponPair}}data-effect-weapon-roll-mod="{{effectWeaponPair.ewRollModifier}}"{{/if}}
                        {{#if effectWeaponPair.superiorEChain}}data-effect-weapon-superior-e-chain="1"{{/if}}
                        {{#if ../targetDisplay}}data-target-id="{{../targetDisplay.id}}"{{/if}}
                        {{#if ../weaponItemId}}data-weapon-item-id="{{../weaponItemId}}"{{/if}}>
                    <div class="chat-critical-roll-inner">
                        <div class="chat-critical-roll-main">
                            <span style="font-size:1.1em;">⚔️</span>
                            <span>{{localize "rmss.combat.critical_roll"}} {{inc @index}}</span>
                            {{localize "rmss.combat.critical_type"}}:
                            <span style="color: #ffb;">{{critType}}</span> /
                            {{localize "rmss.combat.critical_severity"}}:
                            {{{criticalSeverityIcon severity}}}
                        </div>
                        {{#if effectWeaponPair}}
                        <div class="chat-critical-roll-effect-hint">
                            {{#if effectWeaponPair.duplicatePrimary}}
                            {{localize "rmss.combat.critical_effect_weapon_dup_grade"}}
                            {{else if effectWeaponPair.superiorEChain}}
                            {{localize "rmss.combat.critical_effect_weapon_superior_e_chain"}}
                            {{else}}
                            {{localize "rmss.combat.critical_effect_weapon_extra"}} {{#unless (eq effectWeaponPair.extraCritType critType)}}<span class="rmss-ew-extra-type">({{localize "rmss.combat.critical_type"}} {{effectWeaponPair.extraCritType}})</span> {{/unless}}{{{criticalSeverityIcon effectWeaponPair.secondSeverity}}}
                            {{/if}}
                        </div>
                        {{/if}}
                    </div>
                </button>
            </div>
            {{/each}}

        </div>
    {{/if}}

</div>
