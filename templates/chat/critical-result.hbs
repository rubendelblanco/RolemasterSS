{{#if isEffectWeaponExtra}}
<p class="rmss-effect-weapon-extra-chat-label"><i class="fas fa-bolt"></i> {{localize "rmss.combat.critical_effect_weapon_extra_chat"}}</p>
{{/if}}
{{#if rollTotal}}
<p class="critical-roll-result"><i class="fas fa-dice"></i> <span class="critical-roll-value">{{rollTotal}}</span>
    {{#if naturalD100HintText}}
    <span class="rmss-critical-natural-d100-hint" style="display:block;font-size:0.9em;color:#aaa;margin-top:4px;">{{naturalD100HintText}}</span>
    {{/if}}
</p>
{{/if}}
<p class="critical-description">{{result.text}}</p>
<table class="rwd-table">
    <tr>
{{#if result.metadata.HP}}
    <td> <img width="20" src="systems/rmss/assets/default/hearts.svg"> <span>{{result.metadata.HP}}</span></td>
{{/if}}
{{#if result.metadata.STUN}}
    <td>
        <img width="20" src="systems/rmss/assets/default/stunned.svg"> {{result.metadata.STUN.ROUNDS}}
    </td>
{{/if}}
{{#if result.metadata.P}}
    <td><img width="20" src="systems/rmss/assets/default/sword-clash.svg"> {{result.metadata.P.ROUNDS}}
        {{#if result.metadata.P.VALUE}} ({{result.metadata.P.VALUE}}){{/if}}
    </td>
{{/if}}
{{#if result.metadata.PE}}
    <td><img width="20" src="systems/rmss/assets/default/broken-bone.svg">
        {{#if result.metadata.PE.ROUNDS}}  {{result.metadata.PE.ROUNDS}}({{result.metadata.PE.VALUE}})
        {{else}}
            {{result.metadata.PE.VALUE}}
        {{/if}}
    </td>
{{/if}}
{{#if result.metadata.HPR}}
    <td><img width="20" src="systems/rmss/assets/default/bleeding.svg"> {{result.metadata.HPR}}</td>
{{/if}}
{{#if result.metadata.NP}}
    <td><img width="20" src="systems/rmss/assets/default/shield-disabled.svg"> {{result.metadata.NP}}</td>
{{/if}}
{{#if result.metadata.BONUS}}
    <td><img width="20" src="systems/rmss/assets/default/bonus.svg">
        {{#if result.metadata.BONUS.ROUNDS}}  {{result.metadata.BONUS.ROUNDS}}({{result.metadata.BONUS.VALUE}})
        {{else}}
            {{result.metadata.BONUS.VALUE}}
        {{/if}}
    </td>
{{/if}}
    </tr>
</table>
{{#if expData}}
<div class="critical-exp-section chat-exp-message" style="
    background: linear-gradient(145deg, #1f1f1f, #272727);
    border: 1px solid #444;
    border-radius: 8px;
    padding: 8px 10px;
    color: #fff;
    font-family: 'Segoe UI', sans-serif;
    box-shadow: 0 0 6px rgba(0,0,0,0.3);
    margin-top: 8px;
">
    <h3 style="
      margin: 0 0 4px 0;
      font-size: 1.1em;
      color: #58a6ff;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.5px;
  ">
        {{localize "rmss.experience.experience_gained"}}
    </h3>

    <p style="text-align:center; margin:4px 0;">
        <strong style="color:#fff;">{{expData.actorName}}</strong>
        {{localize "rmss.experience.has_gained"}}
        <strong style="color:#6cf;">{{expData.expGained}}</strong>
        {{localize "rmss.experience.experience_points"}}
    </p>

    <p class="click-to-toggle" style="
      text-align:center;
      font-size:0.85em;
      color:#aaa;
      margin:4px 0;
      cursor:pointer;
  ">
        + Info
    </p>

    <div class="breakdown-details" style="
      display:none;
      font-size:0.85em;
      background:#181818;
      border-radius:6px;
      padding:6px 10px;
      margin-top:6px;
      text-align:left;
  ">
        <ol style="margin:0; padding-left:18px;">
            {{#each expData.expBreakdown}}
                {{#if this}}
                    <li><span style="color:#58a6ff;">{{localizeKey @key}}</span>: {{this}}</li>
                {{/if}}
            {{/each}}
        </ol>
    </div>
</div>
{{/if}}