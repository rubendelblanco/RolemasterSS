    "description": "Magent Base 7.2 - Disguise Mastery. Spells for studying and physically disguising as a person, illusory facades, misleading race/profession/level/presence detection (the Misfeel family), obscuring involvement from divination, and full nondetection.",
    "spells": [
      {
        "name": "01. Study Disguise",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "caster",
          "duration": "—",
          "range": "500'",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster studies a person for use with disguise spells later on this list. The caster can only have as many disguises studied as he has levels."
        }
      },
      {
        "name": "02. Light Glamour",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "1 object",
          "duration": "1 day/lvl",
          "range": "touch",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Changes the visual appearance of one object. The target of the spell must be no larger than 10 pounds per level of the caster."
        }
      },
      {
        "name": "03. Facade I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "caster",
          "duration": "1 hour/lvl",
          "range": "self",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster has a limited illusion on himself that allows him to look like any humanoid race within 20% of his own size. The illusion moves as the caster moves."
        }
      },
      {
        "name": "04. Shadow Assassin",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 4,
          "area_of_effect": "caster",
          "duration": "varies",
          "range": "self",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "All deeds performed (while this spell is active) are \"shadowed\" to divination spells. For the purposes of a divination spell, the information gained about the caster will be shrouded in shadows. For example, a Death's Memory cast on the scene of a murder might reveal a shadowy figure performing the deeds (but no details about the identity of the figure)."
        }
      },
      {
