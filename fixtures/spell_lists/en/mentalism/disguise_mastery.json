        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "no_pp": true,
          "level": 5,
          "area_of_effect": "caster",
          "duration": "C",
          "range": "self",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "For the purposes of mental or magical detections, the caster appears to be of any race he chooses (racial type must be selected at the time of casting)."
        }
      },
      {
        "name": "06. Facade II",
