          "duration": "C",
          "range": "100'",
          "type": "F",
          "subType": "m",
          "attack_table": "",
          "skillName": "",
          "description": "Caster may mentally speak with any one thinking being. They must be able to see each other or the caster must know the exact location of the target or the caster must use Focus Mind to locate the target (in all cases, the target must be within range)."
        }
      },
