          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "caster",
          "duration": "C",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "The caster enters a trance-like state to prepare his mind to be the recipient for a Mind Tongue spell. While he is under the effects of this spell, any \"incoming\" Mind Tongue spell has its range increased by 10 times."
        }
      },
      {
        "name": "03. Mind Tongue I *",
        "img": "systems/rmss/assets/default/spell.svg",
