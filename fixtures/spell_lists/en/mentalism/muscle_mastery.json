          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "touch",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster acquires complete understanding of any muscle and/or tendon damage, including the tools and methods required for healing. Caster does not receive the skill or power necessary to perform the cure."
        }
      },
      {
        "name": "03. Muscle Repair I",
        "img": "systems/rmss/assets/default/spell.svg",
