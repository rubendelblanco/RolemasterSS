    "description": "Closed Mentalism 3.7 - Shifting. Spells for altering the caster's own form: balance and contortion bonuses, face shifting, breathing water/gas, changing into a humanoid race or any organic form, solid/liquid/mist forms, and full shapeshifting mastery. Special Notes: See Section 15.20 (p. 100) for more on the abilities gained/retained when changing forms.",
    "spells": [
      {
        "name": "01. Balance *",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": true,
          "level": 1,
          "area_of_effect": "caster",
          "duration": "varies",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Gives a special bonus of +50 to any rolls for one slow maneuver requiring balance (e.g., walking a 3\" beam, etc.)."
        }
      },
      {
        "name": "02. Contraction",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "caster",
          "duration": "C",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows caster to disjoint limbs, contract muscles, etc. to escape manacles/ropes and to slip through small places. Gives a special bonus of +25 to +50 to Contortions maneuvers."
        }
      },
      {
        "name": "03. Face Shifting",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "caster",
          "duration": "10 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows caster to alter the form of his face. The caster may specify a specific person, but the change will not be exact."
        }
      },
      {
        "name": "05. Waterlungs",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 5,
          "area_of_effect": "caster",
          "duration": "1 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "For the duration, the caster can breathe water but not air."
        }
      },
      {
        "name": "07. Change to Kind",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 7,
          "area_of_effect": "caster",
          "duration": "10 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster can alter his form to the form of any desired humanoid race. The form cannot be a specific form. For example, a human caster could take on the form of a Dwarf, but not the Dwarven king. Only physical form is gained (e.g., a target who becomes a Dwarf would not receive the Dwarves' ability to see in the dark). The caster can only alter his size by up to 25%."
        }
      },
      {
        "name": "08. Gaslungs",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 8,
