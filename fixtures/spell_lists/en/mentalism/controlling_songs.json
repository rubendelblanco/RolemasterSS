          "level": 2,
          "area_of_effect": "1 target",
          "duration": "C",
          "range": "50'",
          "type": "F",
          "subType": "m",
          "attack_table": "",
          "skillName": "",
          "description": "As Calm Song, except target only has 25% of his normal activity each round."
        }
      },
      {
