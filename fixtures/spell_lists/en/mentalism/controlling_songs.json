        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 target",
          "duration": "C",
          "range": "50'",
          "type": "F",
          "subType": "m",
          "attack_table": "",
          "skillName": "",
          "description": "Target is calmed and cannot take aggressive (offensive) action, while caster concentrates."
        }
      },
      {
        "name": "02. Holding Song",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
