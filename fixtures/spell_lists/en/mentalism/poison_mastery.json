        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 17,
          "area_of_effect": "1 poison",
          "duration": "varies",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "As Apply Poison II, except affects up to four doses."
        }
      },
      {
        "name": "18. Contact Poison",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 18,
          "area_of_effect": "1 poison",
          "duration": "P",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "As Venom, except converts the poison into a contact poison (a poison that affects its victim upon contact with the victim's skin—regardless of its normal method of affecting the target)."
        }
      },
      {
        "name": "19. Transfer Poison III",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 19,
          "area_of_effect": "1 poison",
          "duration": "P",
          "range": "10'",
          "type": "F",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "The caster can transfer a single dose of a poison in any target he is touching into any other target within range of the spell."
        }
      },
      {
        "name": "20. Venom's Breath",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 20,
          "area_of_effect": "caster",
          "duration": "10 min/lvl",
          "range": "self",
          "type": "F",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "The caster can ingest a single dose of a poison. For the duration of this spell, he will be unaffected by the poison. Anytime before the duration expires, the caster can attempt to transfer the poison to a single target. The target must be no further away than 5' and the caster's mouth must be capable of delivering the poison (either through a kiss, a whisper, spitting, etc.). The target gets an RR to avoid the effects of this spell (in addition to the RR for the poison)."
        }
      },
      {
        "name": "25. Venom's Glare",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 25,
          "area_of_effect": "1 target",
          "duration": "10 min/lvl",
          "range": "100'",
          "type": "F",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "As Venom's Breath, except the caster can transfer the poison to any single target within the range. The caster must be able to cast an obvious, evil glare at the target. The target gets an RR to resist the effects of this spell (in addition to the RR for the poison)."
        }
      },
      {
        "name": "30. Venom's Cloud",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 30,
          "area_of_effect": "varies",
          "duration": "10 min/lvl",
          "range": "10'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "The caster can disperse a poison into a misty cloud. The size of the mist is 1' radius per dose of the poison used. The poison will linger in the area normally until the duration of the spell expires (i.e., the mist will be subject to wind, etc.). When the duration expires, the poison disperses."
        }
      },
      {
        "name": "50. Venom's Sight",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 50,
          "area_of_effect": "1 target",
          "duration": "10 min/lvl",
          "range": "10'/lvl",
          "type": "F",
          "subType": "-",
          "attack_table": "",
