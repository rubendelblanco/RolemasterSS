    "description": "Bard Base 6.3 - Item Lore. Spells for assessing the value of an item, detecting and analyzing its magical abilities, learning its origins, significance, curses, and past events. Special Notes: See Section 15.13 (p. 98) for more on information spells.",
    "spells": [
      {
        "name": "01. Jewel/Metal Assessment",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 object",
          "duration": "—",
          "range": "touch",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster can assess the value of jewels and metals to within 10% of their actual value. This spell allows the caster to calculate different values for the different cultures he is familiar with. This spell only assesses the value of the materials (not the craftsmanship)."
        }
      },
      {
        "name": "02. Item Assessment",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "1 object",
          "duration": "—",
          "range": "touch",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "As Jewel and Metal Assessment, except will determine the value of the object including the craftsmanship of the object. Magic capabilities are not included."
        }
      },
      {
        "name": "03. Detect Power",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "1 object",
          "duration": "1 rnd/lvl(C)",
          "range": "touch",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Detects power in an item, but not the realm or how much. One item can be examined each round by concentrating."
        }
      },
      {
