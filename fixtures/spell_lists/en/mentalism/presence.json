    "description": "Mentalist Base 5.5 - Presence. Spells for sensing sentient presence, analyzing/storing/transferring mental patterns of beings, and finding/pointing toward a stored mental pattern at increasing range.",
    "spells": [
      {
        "name": "01. Presence",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": true,
          "no_pp": true,
          "level": 1,
          "area_of_effect": "10'R/lvl",
          "duration": "C",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster is aware of the presence of all sentient/thinking beings within his range."
        }
      },
      {
        "name": "02. Feel I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": true,
          "level": 2,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "10'/lvl",
          "type": "P",
          "subType": "m",
          "attack_table": "",
          "skillName": "",
          "description": "Caster gets general idea of the race and level of one being. The target must first be located by Presence or Presence True."
        }
      },
      {
        "name": "03. Mind Store",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": true,
          "level": 3,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "10'/lvl",
          "type": "P",
          "subType": "m",
          "attack_table": "",
          "skillName": "",
          "description": "As Feel I, except caster stores mental pattern of target. This can be used with other spells (both on this list and others). The caster can only have as many patterns stored as the sum of his Memory and Presence temporary stats (not the bonuses). The caster can choose to release a stored pattern at any given time (the GM should require that a character keep track of all the patterns he has stored)."
        }
      },
      {
        "name": "04. Transfer Mind Store",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 4,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "The caster can transfer a copy of any one Mind Stored person to another caster from the Mentalism realm (i.e., both casters now have the person stored). The target of this spell must know the Mind Store spell."
        }
      },
      {
        "name": "05. Feel III",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": true,
          "level": 5,
          "area_of_effect": "3 targets",
          "duration": "—",
          "range": "10'/lvl",
          "type": "P",
          "subType": "m",
          "attack_table": "",
          "skillName": "",
          "description": "As Feel I, except analyzes 3 targets at once (all targets must be within range)."
        }
