          "duration": "10 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster can see 100' on a clear night as if it were day. At least some small amount of residual light is required for this spell to work. See Section 15.12 (p. 98)."
        }
      },
