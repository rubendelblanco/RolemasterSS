          "level": 1,
          "area_of_effect": "50' beam",
          "duration": "10 min/lvl",
          "range": "self",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "A beam of light (like a flashlight) springs from the caster's palm. This beam has a 50' effective range. When his hand is made into a fist, the light will \"shut off\" until the fist is opened again."
        }
      },
      {
