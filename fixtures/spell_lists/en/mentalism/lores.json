    "description": "Bard Base 6.4 - Lores. Spells for total recall, learning languages faster, identifying languages and translations, rapid reading, and scanning a target's mind for specific knowledge.",
    "spells": [
      {
        "name": "01. Recall",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "caster",
          "duration": "C",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows the caster to access his memory as if he had total recall. Any skill resolution involving Memory gets a special bonus. If the skill uses Memory as one of its applicable stats (Science/Analytic skills), the bonus is +10. If the skill uses Memory as two of its applicable stats (Lore skills), the bonus is +25, if the skill uses Memory as all three of its applicable stats (i.e., a straight \"memory\" check), the bonus is +50."
        }
      },
      {
        "name": "02. Learn Language II",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "caster",
          "duration": "C",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Doubles the rate at which the caster can learn a language. Every rank of language developed (i.e., DPs spent), results in two ranks being learned. It is assumed that this spell is cast and in effect while the language is being learned—that is, whenever the development points are allocated."
        }
      },
      {
        "name": "03. Language Lore",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "caster",
          "duration": "—",
          "range": "self",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster learns what language a piece of text is written in, and the author if he was noteworthy or the caster has seen his work."
        }
      },
