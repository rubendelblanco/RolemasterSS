    "description": "Lay Healer Base 4.2 - Bone Mastery. Spells for understanding and repairing fractures, cartilage, skulls, joints, transplanting and regenerating bone, and reattaching severed limbs. Special Notes: (1) See RMFRP Section 24.1 (p. 75) for more on damage and healing. (2) Some spells on this list require an operation to be effective. These spells have the same name as other healing spells (from the Channeling realm) and the GM may decide that the operation is not required.",
    "spells": [
      {
        "name": "01. Bone Lore",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "touch",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster acquires complete understanding of any bone damage, including the tools and methods required for healing. Caster does not receive the skill or power to perform the cure."
        }
      },
      {
        "name": "02. Minor Fracture Repair",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "1 target",
          "duration": "P",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows caster to mend one simple fracture (not compound fracture, shatters, joint damage, etc.). Recovery time is 1 day. Will not work on skull fractures."
        }
      },
      {
        "name": "03. Cartilage Repair",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "1 target",
          "duration": "P",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows caster to repair all the cartilage around one joint. Recovery time is one day."
        }
      },
      {
