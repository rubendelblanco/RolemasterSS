          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows caster to completely mend a damaged minor blood vessel (a vessel that bleeds at up to 3 hits per round, not major arteries or veins)."
        }
      },
