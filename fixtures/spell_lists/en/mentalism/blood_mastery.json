          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows caster to repair any one damaged artery. Target cannot move (under his own power) without reopening wound. Recovery time is 1-10 days depending upon the size of the artery and the severity of the damage."
        }
