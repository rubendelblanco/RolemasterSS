    "description": "Lay Healer Base 4.1 - Blood Mastery. Spells for stopping bleeding, repairing blood vessels/veins/arteries, reattaching severed limbs, suspending life to prevent death, removing blood clots, and restoring blood. Special Notes: (1) See RMFRP Section 24.1 (p. 75) for more on healing. (2) When a bleeding wound does not specify whether the wound is on a vein or an artery, roll d100. A 01-60 results in a vein; a 61 or more results in an artery.",
    "spells": [
      {
        "name": "01. Flowstop III",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster can stop bleeding on a wound that is bleeding up to 3 hits per round (total). Target may not be moved or bleeding will resume at prior rate."
        }
      },
      {
        "name": "02. Clotting I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster may stop bleeding on a wound that is bleeding 1 hit per round. For 1 hour, target can move at no more than a walking pace or bleeding will resume at prior rate."
        }
      },
      {
        "name": "03. Cut Repair I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "1 target",
          "duration": "P",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows caster to stop bleeding from 1 wound that is bleeding at rate of 1 hit per round."
        }
      },
      {
        "name": "04. Clotting III",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 4,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "As Clotting I, except that caster can stop up to 3 hits per round (total) of bleeding in a wound."
        }
      },
      {
