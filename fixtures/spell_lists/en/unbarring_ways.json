          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 lock",
          "duration": "—",
          "range": "100'",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster can cause any lock he can see within 100' to be locked (the lock is just normally locked and can be opened normally)."
        }
      },
