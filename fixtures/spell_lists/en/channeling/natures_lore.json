{
  "name": "Nature's Lore",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "channeling",
    "profession": "Animist",
    "is_container": true,
    "container": {
      "maxCapacity": 50,
