    },
    "description": "Animist Base List 4.3 - Nature's Lore. Spells to detect traps and magic, find paths and landmarks, predict weather, monitor an area, and commune with elementals and pools of water.",
    "spells": [
      { "name": "01. Trap Detection", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "5'R", "duration": "1 min/lvl", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster has a 75% chance of detecting a trap in the area of effect. The caster can concentrate on a different area each round. There must be living plants or animals in the area of effect or no information will be gained." } },
      { "name": "02. Nature's Awareness I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "100'R", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can monitor animate activity in the area of effect (e.g., he will be aware of subtle movements). For duration of this spell, caster cannot move." } },
      { "name": "03. Pathfinding", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "100'R", "duration": "—", "range": "100'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns the location(s) of any 'path(s)' within 100'. The spell gives the nearest point on the path, but not the path's course." } },
      { "name": "04. Detect Magic", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster has a 75% chance of detecting active magic in the area of effect. The caster can concentrate on a different area each round. There must be living plants or animals in the area of effect or no information will be gained." } },
      { "name": "05. Weather Prediction I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "caster", "duration": "—", "range": "1 mi/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Gives a 95% chance of predicting time, type, and severity of weather over the next 24 hour period." } },
      { "name": "06. Nature's Awareness II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "200'R", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Awareness I, except for the area of effect." } },
      { "name": "07. Weather Prediction III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "caster", "duration": "—", "range": "1 mi/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Weather Prediction I, except period is 3 days." } },
      { "name": "08. Locate Landmark I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "100'/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "For the duration of this spell, the caster will know the direction and distance to any unique natural feature that the caster is familiar with. The feature must be within range or no information is gained." } },
      { "name": "09. Waiting Awareness I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "10'R", "duration": "1 hr/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to set up a natural 'alarm system' in the area of effect. Any disturbing activity will cause caster to be alerted." } },
      { "name": "10. Nature's Awareness III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "300'R", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Awareness I, except for the area of effect." } },
      { "name": "11. Weather Prediction V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "caster", "duration": "—", "range": "1 mi/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Weather Prediction I, except period is 5 days." } },
      { "name": "12. Memory's Path", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "caster", "duration": "1 hr/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can remember an exact route he travelled; whether or not he was without one or more of his senses when he made his original journey (e.g., a 12th level caster could remember the course of 12 hours of a trip, even if he had been blindfolded). To be effective, this spell must be cast within one month per level of the journey." } },
      { "name": "13. Waiting Awareness II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "50'R", "duration": "1 hr/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waiting Awareness I, except for area of effect." } },
      { "name": "14. Locate Landmark II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "300'/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Locate Landmark I, except for the range." } },
      { "name": "15. Nature's Eye I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "100'R", "duration": "—", "range": "1 mi", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to visualize and sense activity in a known area (100' radius)." } },
      { "name": "16. Nature's Awareness V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "500'R", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Awareness I, except for the area of effect." } },
      { "name": "17. Elemental Communication", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "caster", "duration": "C", "range": "100'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "The caster can communicate with any elemental force within range. The elemental force must be able to communicate with the caster (i.e., this spell does not confer communication abilities upon the force). Elemental forces include all magically created elementals, water spirits, forest spirits, etc." } },
      { "name": "18. Water Visions", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 pool", "duration": "C", "range": "10'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "The target of this spell is a small pool of water. The water must be calm (and remain calm for the duration of the spell). The caster may designate a topic and a vision will appear in the pool that relates to the topic. The vision takes 1-50 rounds." } },
      { "name": "19. Locate Landmark True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "1000'/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Locate Landmark I, except for the range." } },
      { "name": "20. Nature's Eye II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "500'R", "duration": "C", "range": "10 mi", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Eye I, except for the range and area of effect." } },
      { "name": "25. Weather Prediction True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "caster", "duration": "—", "range": "1 mi/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Weather Prediction I, except period is 1 day per level." } },
      { "name": "30. Nature's Eye III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "500'R", "duration": "C", "range": "100 mi", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Eye I, except for the range and area of effect." } },
      { "name": "50. Animist's Eye", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "100'R", "duration": "C", "range": "varies", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to monitor an area of 100' radius that he has both been to and become acquainted with (i.e., spent at least 1 day meditating in or 30 days living in)." } }
    ]
  }
}
