{
  "name": "Nature's Way",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "channeling",
    "profession": "Ranger",
    "is_container": true,
    "container": {
      "maxCapacity": 50,
      "usedCapacity": 0,
      "capacityType": "quantity",
      "allowedTags": ["spell"]
    },
    "description": "Ranger Base List 7.5 - Nature's Way. Spells to detect traps, find water/food/shelter, start fire, purify water, build magical traps, predict weather, and sense nearby activity.",
    "spells": [
      { "name": "01. Trap Detection", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "5'R", "duration": "1 min/lvl", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster has a 75% chance of detecting a trap in the area of effect. The caster can concentrate on a different area each round. There must be living plants or animals in the area of effect or no information will be gained." } },
      { "name": "02. Water Finding I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 mile R", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can locate the closest natural source of running water, exposed groundwater, etc. exceeding 1 gallon. He will learn the approximate size and quality of source." } },
      { "name": "03. Fire Starting", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1'R", "duration": "—", "range": "1'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to set a fire of 1' radius. Fire will burn as long as there is fuel. A target in the 1' radius will take an 'A' Heat critical." } },
      { "name": "05. Food Finding I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 mile R", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns location, type, and approximate quantity of edible food (e.g., dead animal matter, plants, etc.). The food source must exceed 1 pound." } },
      { "name": "06. Water Purification", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "varies", "duration": "P", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to purify a number of gallons of water equal to his level." } },
      { "name": "07. Shelter Finding I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 mile R", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns location, type, and approximate size of any waterproof, covered space exceeding 125 cubic feet. The shelter must have an entry (exceeding 2' radius) opening onto open air." } },
      { "name": "08. Lesser Traps", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1-10'R", "duration": "P", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "This spell creates a minor, normal trap (constructed magically). The trap can deliver up to a 'B' critical strike (must be either a Slash, a Krush, or a Puncture; specified by the caster at the time of casting) to any one target. The size of the trap can vary from 1' radius to 10' radius. The time to construct the trap is 1 round per 1' radius." } },
      { "name": "09. Weather Prediction I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "caster", "duration": "—", "range": "1 mi/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Gives caster a 95% chance of predicting time, type, and severity of weather over next 24 hour period." } },
      { "name": "10. Nature's Awareness I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "100'R", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can monitor animate activity in the area (e.g., he will be aware of subtle movements). For the duration of this spell, the caster cannot move." } },
      { "name": "11. Water Finding II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "10 mile R", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Water Finding I, except range is 10 miles." } },
      { "name": "12. Waiting Awareness I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "10'R", "duration": "1 hr/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to set up a natural 'alarm system' in the area of effect. Any disturbing activity will cause caster to be alerted." } },
      { "name": "13. Food Finding II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "10 mile R", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Food Finding I, except range is 10 miles." } },
      { "name": "14. Major Traps", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "10'R", "duration": "P", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Lesser Traps, except trap can deliver an 'E' critical hit." } },
      { "name": "15. Shelter Finding II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "10 mile R", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Shelter Finding I, except range is 10 miles." } },
      { "name": "16. Nature's Awareness III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "300'R", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Awareness I, except for the area of effect." } },
      { "name": "17. Water Finding True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "varies", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Finds the closest water source (as defined in Water Finding I). This spell gives only direction and distance; no information about the size and quality of the water source is gained." } },
      { "name": "18. Food Finding True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "varies", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Finds the closest source of food (as defined in Food Finding I). This spell gives only direction and distance; no information about the quantity or quality of the food source is gained." } },
      { "name": "19. Shelter Finding True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "varies", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Finds the closest shelter (as defined in Shelter Finding I). This spell gives only direction and distance; no information about the size or type of shelter is gained." } },
      { "name": "20. Nature's Awareness V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "500'R", "duration": "C", "range": "500'R", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Awareness I, except for the area of effect." } },
      { "name": "25. Weather Prediction V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "caster", "duration": "—", "range": "1 mi/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Weather Prediction I, except period is 5 days." } },
      { "name": "30. Waiting Awareness II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "50'R", "duration": "1 hr/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waiting Awareness I, except that the radius is 50'." } },
      { "name": "50. Nature's Awareness True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "100'R/lvl", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Awareness I, except for the area of effect." } }
    ]
  }
}
