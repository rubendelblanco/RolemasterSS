    "description": "Open Channeling 2.3 - Detection Mastery. Passive spells to detect realms of magic, life, curses, undead, traps, invisibility, poisons and spell power, plus location spells.",
    "spells": [
      { "name": "01. Detect Channeling", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Detects any active spell or item from the Channeling realm; caster can concentrate on a different 5 foot radius each round." } },
      { "name": "02. Detect Essence", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except realm is Essence." } },
      { "name": "03. Detect Mentalism", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except realm is Mentalism." } },
      { "name": "04. Detect Life", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except detects living beings." } },
      { "name": "05. Detect Curse", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except detects curses on people or things." } },
      { "name": "06. Detect Undead", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except detects the presence of Undead." } },
      { "name": "07. Detect Traps", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except it gives a 75% chance of detecting a trap (trap sophistication modifiers may reduce or enhance this chance)." } },
      { "name": "08. Life Typing", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 target", "duration": "—", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except it analyzes one living being; giving race, age, and current state of health." } },
      { "name": "09. Detect Invisible", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except detects invisible things. All attacks against an invisible target suffer a -50 penalty (instead of the standard -100)." } },
      { "name": "10. Perceive Power I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except it will give an estimate of the power (i.e., level) of the person, item, or spell examined." } },
      { "name": "11. Poison Analysis", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 target", "duration": "—", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except it gives an analysis of any poisons on a single object or in a single being." } },
      { "name": "13. Power Typing", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except it analyzes general spell type (in item or cast) and what spell list it was cast from. In the case of a person, it gives his exact profession." } },
      { "name": "15. Detect Spell", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except detects any spell that has ever been cast in the area examined." } },
      { "name": "17. Perceive Power II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "50'R", "duration": "1 min/lvl (C)", "range": "500'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Perceive Power I, except range is 500' and area is 50' radius." } },
      { "name": "18. Location", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "caster", "duration": "—", "range": "300'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Gives the direction and distance to any specific object or place that the caster is familiar with or has had described in detail. The caster must have the dimensions of the object exact within 10% of actual size and know at least two other attributes that make the item unique (color, texture, weight, etc.)." } },
      { "name": "20. Curse Analysis", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except a curse may be analyzed for level, effect and required cure." } },
      { "name": "25. Life Analysis", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 target", "duration": "—", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Life Typing, except also gives exact profession, alignment, and other pertinent details." } },
      { "name": "30. Detect True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "varies", "duration": "1 min/lvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Channeling, except any of the lower level spells on this list can be used once per round." } },
      { "name": "50. Location True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "caster", "duration": "—", "range": "1 mi/lvl", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Location, except range is 1 mile per level." } }
    ]
