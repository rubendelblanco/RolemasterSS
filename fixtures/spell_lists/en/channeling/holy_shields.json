    "description": "Paladin Base List 6.5 - Holy Shields. Protective spells: protection prayers, aura, shield, blur, sustaining extra hits, and deflecting missiles and melee attacks.",
    "spells": [
      { "name": "01. Protection Prayer I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Everyone in the area of effect who is aligned with the caster (GM's discretion) subtracts 5 from all elemental attacks against them. They may also add 5 to all RRs versus spells. These bonuses are not conferred to the caster." } },
      { "name": "02. Aura", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates a bright aura about the caster, making him appear more powerful and subtracting 10 from all attacks against him." } },
      { "name": "03. Shield", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 3, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates an invisible force shield in front of the caster. This functions as a normal shield (subtracting 25 from appropriate attacks, etc.), except it does not occupy a hand. This spell cannot be combined with a 'real' shield." } },
      { "name": "04. Blur", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 4, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes target to appear blurred to attackers. This subtracts 10 from all attacks directed at the target." } },
      { "name": "05. Unpain I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 5, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Caster is able to sustain an additional 25% of his total concussion hits before passing out. Hits are still taken and remain when the spell lapses." } },
      { "name": "06. Protection Prayer II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection Prayer I, except bonuses are 10." } },
      { "name": "07. Deflections I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 7, "area_of_effect": "1 missile", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can deflect any one missile that passes within 10' of him (caster must be able to see the missile). This causes 100 to be subtracted from the missile's attack." } },
      { "name": "08. True Aura", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Aura, except it makes the caster appear very powerful; subtracting 15 from all attacks against him." } },
      { "name": "09. Bladeturn I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 9, "area_of_effect": "1 attack", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can deflect any one melee attack that he can see (and is within range). This causes 50 to be subtracted from the attack." } },
      { "name": "10. Unpain II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 10, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Unpain I, except an additional 50% can be sustained." } },
      { "name": "11. Protection Prayer III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection Prayer I, except bonuses are 15." } },
      { "name": "12. Deflections II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 12, "area_of_effect": "2 missiles", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Deflections I, except will deflect up to two missiles." } },
      { "name": "13. Aim Untrue I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 13, "area_of_effect": "1 missile", "duration": "—", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can deflect any one missile that passes within 100' of him (caster must be able to see the missile). This causes the missile to automatically miss." } },
      { "name": "14. Bladeturn II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 14, "area_of_effect": "2 attacks", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Bladeturn I, except affects 2 attacks." } },
      { "name": "15. Unpain III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 15, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Unpain I, except an additional 75% can be sustained." } },
      { "name": "16. Protection Prayer IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection Prayer I, except bonuses are 20." } },
      { "name": "17. Deflections III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 17, "area_of_effect": "3 missiles", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Deflections I, except will deflect up to three missiles." } },
      { "name": "18. Aim Untrue II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 18, "area_of_effect": "2 missiles", "duration": "—", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Aim Untrue I, except affects up to two missiles." } },
      { "name": "19. Bladeturn III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 19, "area_of_effect": "3 attacks", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Bladeturn I, except affects 3 attacks." } },
      { "name": "20. Unpain IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Unpain I, except an additional 100% can be sustained." } },
      { "name": "25. Protection Prayer True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection Prayer I, except bonuses are 25." } },
      { "name": "30. Mass Deflections", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 missile/lvl", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Deflections I, except will deflect one missile per level of the caster." } },
      { "name": "50. Holy Shields True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "varies", "duration": "1 rnd/lvl", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster may use any lower level spell on this list once per round." } }
    ]
