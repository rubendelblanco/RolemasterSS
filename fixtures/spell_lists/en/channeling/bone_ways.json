      { "name": "25. Cartilage Regeneration True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Cartilage Regeneration, except that caster can regenerate all of the lost cartilage in his body. Recovery time is 1-10 hours." } },
