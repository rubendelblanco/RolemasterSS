    "description": "Healer Base List 8.2 - Bone Ways. Self-healing spells for fractures, cartilage, skull, joints, shatters, bone/cartilage regeneration, and reattaching a severed limb (Joining, shared with Blood/Muscle/Organ Ways).",
    "spells": [
      { "name": "01. Minor Fracture Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Allows caster to mend one simple fracture (not compound fractures, shatters, joint damage, etc.). Recovery time is 1-10 hours." } },
      { "name": "02. Cartilage Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Allows caster to repair all cartilage damage around one joint. Recovery time is 1-2 hours." } },
      { "name": "03. Major Fracture Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Minor Fracture Repair, except that caster can also repair compound fractures." } },
      { "name": "04. Skull Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Allows caster to mend one fracture in his skull (but not a shattered area). Recovery time is 1-10 hours." } },
      { "name": "05. Joint Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Allows caster to repair one broken (but not shattered) joint. Recovery time is 1-10 hours." } },
      { "name": "06. Minor Fracture Repair True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Minor Fracture Repair, except recovery is instantaneous." } },
