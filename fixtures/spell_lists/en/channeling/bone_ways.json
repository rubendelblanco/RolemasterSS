      { "name": "50. Skeletal Regeneration True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Caster can regenerate all of the lost bone and/or cartilage in his body. Recovery is instantaneous." } }
