{
  "name": "Nature's Summons",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "channeling",
    "profession": "Ranger",
    "is_container": true,
    "container": {
      "maxCapacity": 50,
      "usedCapacity": 0,
      "capacityType": "quantity",
      "allowedTags": ["spell"]
    },
    "description": "Ranger Base List 7.4 - Nature's Summons. Spells to summon animals for nourishment, warmth, guidance, protection or as a mount, spread wild plants, and pray to one's deity for fog, rain, storms, hail, lightning, tornadoes or clear weather.",
    "spells": [
      { "name": "01. Summon Nourishment", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 creature", "duration": "—", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "An animal will arrive bearing some form of nourishment: berries, nuts, or tubers (vegetable matter). The animal will drop the food and return to the wilderness." } },
      { "name": "02. Summon Warmth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 creature", "duration": "8 hours", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "A heavily-furred animal will arrive and lie down near the caster. The animal will allow the caster (and only the caster) to lie down next to it." } },
      { "name": "03. Summon Guide", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 creature", "duration": "24 hours (C)", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "An animal who knows the path to a specific location will arrive. The animal will guide the caster to that location as long as he concentrates on the desired location." } },
      { "name": "04. Summon Guardian", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 creature", "duration": "8 hours", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "A suitable large animal that is capable of inflicting at least Medium animal attacks will arrive. This animal will attempt to protect the caster from hostile attacks. If the caster leaves the general area in which the spell was cast, the animal will not travel with him (i.e., it will leave)." } },
      { "name": "05. Summon Mount", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 creature", "duration": "24 hours", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "A large animal will arrive and serve as a mount for the caster." } },
      { "name": "06. Summon Hunter", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 creature", "duration": "—", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Summon Nourishment, except animal brings a recently killed prey (some form of meat)." } },
      { "name": "07. Summon Sense", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 creature", "duration": "24 hours (C)", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "An animal with a specified heightened sense will arrive. For the duration of the spell, the animal will 'perceive' for the caster. The caster can concentrate to have the animal communicate what he has been perceiving." } },
      { "name": "09. Summon Group", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 group", "duration": "24 hours", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "A 'group' of animals will arrive and stay near the area where the spell was cast. For the purposes of this spell, the animals summoned must normally travel in groups (e.g., wolves, deer, birds, etc.)." } },
      { "name": "10. Mass Summons", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 creature/lvl", "duration": "varies", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "The caster can use any lower level spells on this list, except that one animal per level will be summoned." } },
      { "name": "12. Spread Plants", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "20'R", "duration": "P", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "This spell produces ground covering of grasses and small plants of other varieties. The plants must already exist in the area of effect. This spell simply allows them to multiply and grow faster (coverage takes 20+d100 hours)." } },
      { "name": "13. Fog Prayer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster prays to his deity for fog. The chance that the prayer is answered is 2% per level of the caster." } },
      { "name": "14. Rain Prayer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fog Prayer, except generates a light rain." } },
      { "name": "15. Spread Plants II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "20'R", "duration": "P", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Spread Plants, except will also spread saplings and small trees." } },
      { "name": "16. Storm Prayer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fog Prayer, except will generate a heavy thunderstorm." } },
      { "name": "17. Hail Prayer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fog Prayer, except generates a hail storm." } },
      { "name": "19. Lightning Prayer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fog Prayer, except will generate a lightning storm." } },
      { "name": "20. Tornado Prayer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fog Prayer, except will generate weather that results in a tornado." } },
      { "name": "25. Clear Weather Prayer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fog Prayer, except will ensure clear weather." } },
      { "name": "30. Weather Prayer True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fog Prayer, except caster's deity will grant whatever weather would be most beneficial to the caster's current goal." } },
      { "name": "50. Prayer Mastery", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "500'R/lvl", "duration": "varies", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As any of the Prayer spells on this list, except chance of getting the effect is 95%." } }
    ]
  }
}
