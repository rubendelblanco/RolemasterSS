      { "name": "20. Preservation True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 body", "duration": "1 year/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Preservation I, except for duration." } },
