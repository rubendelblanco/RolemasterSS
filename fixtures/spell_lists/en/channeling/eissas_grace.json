      { "name": "35. Sacrifice True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 35, "area_of_effect": "1 target", "duration": "any", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can restore life to a dead body by giving up his own soul. The target's soul is returned to his body with no ill effects (although he is still subject to any wounds he had). The caster's soul departs, however this spell also acts as a Preservation True (1 yr/lvl) spell on the caster's body." } },
      { "name": "40. Dispel Undead True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 40, "area_of_effect": "1 target/lvl", "duration": "P", "range": "10'/lvl", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Dispel Undead, but affects 1 target/lvl within 10'/lvl of caster." } },
