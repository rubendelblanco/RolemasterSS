      { "name": "23. Dispel Undead XX", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 23, "area_of_effect": "20 targets", "duration": "-", "range": "50'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Dispel Undead I, but affects up to 20 targets." } },
