      { "name": "25. Restful Spirit True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "10'r/lvl", "duration": "Permanent", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "All corpses within radius are blessed and unable to rise up as undead." } },
