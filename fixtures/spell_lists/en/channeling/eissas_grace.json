    "description": "Open Channeling - Eissa's Grace. Spells to preserve life, delay death and repel the undead, granted through the cult of Eissa. Not an official Rolemaster list - a setting-specific addition.",
    "spells": [
      { "name": "01. Life Analysis", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 target", "duration": "-", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can detect the existence of a soul in a target, or if the target is dead how long ago the soul has departed, up to 1 year/lvl." } },
      { "name": "02. Restful Spirit", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 Corpse", "duration": "Permanent", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target corpse will not be able to rise as undead or house any animating spirit or otherwise be made to occupy a state other than peaceful death or true resurrection that returns the body to life and re-houses the soul." } },
      { "name": "03. Preservation I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 body", "duration": "1 day/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can preserve a dead body or body part, preventing decomposition. Preservation can only be used on bodies (or parts) of living beings that are or were capable of life, it cannot be used to preserve other organic matter." } },
      { "name": "04. Lifekeeping I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 target", "duration": "1 hr/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster prevents the soul of a target from leaving its body (thus preventing actual death), although the body will continue to take damage (from bleeding or other effects) for the duration. If the body is not capable of sustaining life at the end of the duration, then the soul will depart." } },
      { "name": "05. Dispel Undead I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "-", "range": "50'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can \"dispel\" an undead corporeal or non-corporeal entity." } },
      { "name": "06. Eissa's Sanctuary I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster is ignored by any foes who fail an RR vs 10th level." } },
      { "name": "07. Sacrifice I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 target", "duration": "1 hr/lvl", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can restore life to a recently dead body (within 1hr/lvl) by giving up his own soul. The target's soul is returned to his body with no ill effects (although he is still subject to any wounds he had). The caster's soul departs, however this spell also acts as a Preservation I (1 day/lvl) spell on the caster's body." } },
      { "name": "08. Preservation II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 body", "duration": "1 week/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Preservation I, except for duration." } },
      { "name": "09. Lifekeeping II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 target", "duration": "1 day/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Lifekeeping I, except for duration." } },
      { "name": "10. Lifegiving I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 body", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can return the soul of a being (that has not been dead for more than 1 min/lvl) to its body. If the body is not capable of sustaining life, then the soul will depart again. The target gets a -15 to all stats (which can be restored via Heal Life Essence)." } },
      { "name": "11. Dispel Undead V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "5 targets", "duration": "-", "range": "50'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Dispel Undead I, but affects up to 5 targets." } },
      { "name": "12. Eissa's Sanctuary II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster is ignored by any foes who fail an RR vs 20th level." } },
      { "name": "13. Sacrifice II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 target", "duration": "1 day/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can restore life to a recently dead body (within 1 day/lvl) by giving up his own soul. The target's soul is returned to his body with no ill effects (although he is still subject to any wounds he had). The caster's soul departs, however this spell also acts as a Preservation II (1 week/lvl) spell on the caster's body." } },
      { "name": "14. Preservation III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 body", "duration": "1 month/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Preservation I, except for duration." } },
      { "name": "15. Lifekeeping III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 target", "duration": "1 week/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Lifekeeping I, except for duration." } },
      { "name": "16. Lifegiving II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 target", "duration": "P", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Lifegiving I, except body can have been dead for up to 1 hour/level." } },
      { "name": "17. Dispel Undead X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "10 targets", "duration": "-", "range": "50'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Dispel Undead I, but affects up to 10 targets." } },
