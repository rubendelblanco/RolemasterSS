    "description": "Paladin Base List 6.2 - Exorcisms. Spells to repel and disintegrate Undead, repel and banish Demons, and neutralize or dispel curses.",
    "spells": [
      { "name": "01. Repel Undead I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "varies", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes Undead to flee or disintegrate. All Undead have a class assigned to them. This spell will affect 1 point of Undead (Class I Undead count as 1 point, Class II Undead count as 2 points, etc.). Animated Dead are treated as Class I Undead and are not entitled to an RR (they automatically disintegrate if the spell does not fail). Each target is entitled to an RR. If the target fails the RR by 50 or less, it will flee (if it cannot flee, it will remain motionless). If it fails by more than 50, it disintegrates. One Base Attack Roll is applied to all targets. The RR of any single Undead can be modified by concentrating the effects of the spell on that target: for each additional point of the spell allocated to a target (beyond those normally needed to affect it), that target's RR is modified by -5." } },
      { "name": "02. Detect Undead", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "10'R", "duration": "1 min/lvl(C)", "range": "10'/lvl", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Detects the presence of Undead in the area of effect. Caster can move the area of effect 5' each round." } },
      { "name": "03. Repel Undead III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "varies", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Undead I, except affects 3 points of Undead." } },
      { "name": "04. Repel Demon I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "5'R/lvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "For as long as the caster concentrates, Type I Demons that are in the area of effect may not leave, and Type I Demons that are outside the area of effect may not enter." } },
      { "name": "05. Repel Undead V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "varies", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Undead I, except affects 5 points of Undead." } },
      { "name": "06. Repel Demon II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "5'R/lvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Demon I, except affects up to Type II Demons." } },
      { "name": "07. Banish Demon I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 Demon", "duration": "1 mo/lvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Banishes the target Type I Demon from this plane of existence for the duration of the spell." } },
      { "name": "08. Neutralize Curse I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "[RR Mod: -20] Nullifies a curse for the duration of this spell. The curse is not dispelled and takes effect after the duration of this spell." } },
      { "name": "09. Repel Demon III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "5'R/lvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Demon I, except affects up to Type III Demons." } },
      { "name": "10. Repel Undead X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "varies", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Undead I, except affects 10 points of Undead." } },
      { "name": "11. Banish Demon II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 Demon", "duration": "1 mo/lvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Banish Demon I, except affects up to a Type II Demon." } },
      { "name": "12. Repel Undead XII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "varies", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Undead I, except affects 12 points of Undead." } },
      { "name": "13. Repel Demon IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "5'R/lvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Demon I, except affects up to Type IV Demons." } },
      { "name": "14. Neutralize Curse II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 target", "duration": "1 hr/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Neutralize Curse I, except for duration." } },
      { "name": "15. Repel Undead XV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "varies", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Undead I, except affects 15 points of Undead." } },
      { "name": "16. Repel Demon V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "5'R/lvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Demon I, except affects up to Type V Demons." } },
      { "name": "17. Banish Demon III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 Demon", "duration": "1 mo/lvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Banish Demon I, except affects up to a Type III Demon." } },
      { "name": "18. Neutralize Curse III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 target", "duration": "1 day/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Neutralize Curse I, except for duration." } },
      { "name": "19. Repel Demon VI", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "5'R/lvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Demon I, except affects up to Type VI Demons." } },
      { "name": "20. Repel Undead True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "varies", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Undead I, except one Undead of type V or less is disintegrated. Type VI Undead are sent fleeing." } },
      { "name": "25. Repel Demon True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "10'R/lvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Demon VI, except for area of effect." } },
      { "name": "30. Uncurse True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "[RR Mod: -50] Dispels a curse if the curse fails an RR. The curse's level is the level of the caster of the original curse. If the curse is not dispelled, the caster cannot try again until he has gone up another level of experience." } },
      { "name": "50. Banish Demon True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 Demon", "duration": "1 mo/lvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Banish Demon I, except affects up to a Type IV Demon." } }
