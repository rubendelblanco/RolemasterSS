    "description": "Closed Channeling 3.5 - Locating Ways. Spells to find paths, get guidance from one's deity, locate objects and places, and remember routes.",
    "spells": [
      { "name": "02. Guess", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "When faced with a choice about which he has little or no information (e.g., which corridor leads outside the quickest) the caster may cast this spell and the Gamemaster will determine which way he goes, biasing the choice favorable by 25% (e.g., roll 1-100: correct on 26-100, incorrect on 01-25)." } },
      { "name": "03. Pathfinding I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "caster", "duration": "—", "range": "100'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns the location(s) of any 'path(s)' within 100'; gives the nearest point on path, but not the path's course." } },
      { "name": "04. Guidance", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "caster", "duration": "10 min/lvl(C)", "range": "100'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "The caster is subtly directed (hints and clues) towards a specific destination (within 100' per level of the caster) by guidance from his deity. The exact form of the guidance may vary from deity to deity (e.g., a deity of water might leave hints in the rocks of a stream, etc.). For the duration of the spell, the caster must concentrate on following the guidance." } },
      { "name": "05. Location I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "—", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Gives the direction and distance to any specific object or place that the caster is familiar with or has had described in detail." } },
      { "name": "06. Pathfinding III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "caster", "duration": "—", "range": "300'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Pathfinding I, except range is 300'." } },
      { "name": "08. Location III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 target", "duration": "—", "range": "300'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Location I, except range is 300'." } },
      { "name": "09. Pathfinding V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "caster", "duration": "—", "range": "500'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Pathfinding I, except range is 500'." } },
      { "name": "10. Location V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 target", "duration": "—", "range": "500'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Location I, except range is 500'." } },
      { "name": "11. Memory's Path", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "caster", "duration": "1 hr/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can remember an exact route he traveled; whether or not he was without one or more of his senses when he made his original journey (e.g., a 12th level caster could remember the course of 12 hours of a trip even if he had been blindfolded). To be effective, this spell must be cast within 1 month of the journey." } },
      { "name": "12. Pathfinding X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "caster", "duration": "—", "range": "1 mile", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Pathfinding I, except range is 1 mile." } },
      { "name": "13. Divine Guidance", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "caster", "duration": "1 hr/lvl", "range": "1 mi/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Guidance, except the form of the guidance is that of an animal companion sent by the deity. The caster can follow the animal to a specific destination. If more than 24 hours pass without the caster making progress towards the destination, the animal will leave." } },
      { "name": "15. Finding I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 object", "duration": "—", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can locate any 1 object he describes, if indeed it exists and is in range (e.g., caster could describe a type of mace he had never seen or heard of)." } },
      { "name": "16. Location X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 target", "duration": "—", "range": "1 mile", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Location I, except range is 1 mile." } },
      { "name": "17. Pathfinding True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "caster", "duration": "—", "range": "10 mi", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Pathfinding I, except range is 10 miles." } },
      { "name": "18. Finding III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 object", "duration": "—", "range": "300'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Finding I, except range is 300'." } },
      { "name": "20. Lord Location", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 target", "duration": "—", "range": "20 miles", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Location I, except range is 20 miles." } },
      { "name": "25. Paths True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 mi R/lvl", "duration": "—", "range": "1 mi/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Pathfinding I, except range is 1 mile per level and exact route(s) within the range are ascertained." } },
      { "name": "30. Location True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 target", "duration": "—", "range": "1 mi/lvl", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Location I, except range is 1 mi per level." } },
      { "name": "50. Finding True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 object", "duration": "—", "range": "100'/lvl", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Finding, except range is 100' per level." } }
    ]
  }
