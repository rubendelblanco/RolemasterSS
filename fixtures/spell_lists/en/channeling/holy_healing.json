    "description": "Paladin Base List 6.4 - Holy Healing. Spells to heal concussion hits, stop bleeding, mend fractures, relieve stun and frost/burn damage, resist disease and poison, and cure paralysis.",
    "spells": [
      { "name": "01. Healing I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target is healed of d10 concussion hits." } },
      { "name": "02. Flowstop I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to stop bleeding on a wound that is bleeding 1 hit per round. Target may not be moved, or bleeding will resume at prior rate." } },
      { "name": "03. Frost/Burn Relief I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target is healed of one area of mild frostbite or first degree burn." } },
      { "name": "04. Minor Fracture Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to mend one simple fracture (not compound fractures, shatters, joint damage, etc.). Recovery time is one day." } },
      { "name": "05. Healing III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Healing I, except heals 3d10 concussion hits." } },
      { "name": "06. Stun Relief I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 6, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Target is relieved of one round's worth of accumulated stun." } },
      { "name": "07. Major Fracture Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Minor Fracture Repair, except that the caster can also repair compound fractures. Recovery time is one day." } },
      { "name": "08. Disease Resistance I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "For the duration of this spell, the target gets an additional RR versus any disease(s)." } },
      { "name": "09. Poison Resistance I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "For the duration of this spell, the target gets an additional RR versus any poison(s)." } },
      { "name": "10. Minor Vessel Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to completely mend a damaged minor blood vessel (a vessel that bleeds at up to 2 hits per round, not major arteries or veins)." } },
      { "name": "11. Healing V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Healing I, except heals 5d10 concussion hits." } },
      { "name": "12. Muscle/Tendon Repair I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to repair (not replace) one damaged muscle or tendon. Recovery time is 1 hour." } },
      { "name": "13. Frost/Burn Relief III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Frost/Burn Relief I, except caster can heal 3 areas of mild damage or 1 area of severe damage (e.g., third degree burns) or a combination of 1 mild and 1 moderate area of damage." } },
      { "name": "14. Stun Relief II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 14, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Stun Relief I, except relieves 2 rounds of stun." } },
      { "name": "15. Unparalysis", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can cure any one paralysis problem." } },
      { "name": "16. Healing X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Healing I, except heals 10d10 concussion hits." } },
      { "name": "17. Frost/Burn Relief IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Frost/Burn Relief I, except caster can heal 4 mild or 2 moderate or 1 mild and 1 severe or 2 mild and 1 moderate areas of damage." } },
      { "name": "18. Undisease", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can remove any one disease from the target." } },
      { "name": "19. Unpoison", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can remove any one poison from the target." } },
      { "name": "20. Stun Relief True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 20, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Stun Relief I, except relieves all rounds of stun." } },
      { "name": "25. Healing XV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Healing I, except heals 15d10 concussion hits." } },
      { "name": "30. Healing True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Healing I, except heals all concussion damage." } },
      { "name": "50. Laying on Hands True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 target", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can use any lower level spell on this list once per round." } }
    ]
