      { "name": "20. Nature's Awareness V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "caster", "duration": "C", "range": "500'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nature's Awareness I, except that the radius is 500'." } },
      { "name": "25. Earth Empathy", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 object", "duration": "1 min/lvl", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can understand and/or visualize the thoughts and emotions of any 1 animal, plant, stone, or dead organic object. The caster can change targets once per round." } },
      { "name": "30. Mastery", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 species", "duration": "C", "range": "10'/lvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Animal Mastery I, except caster can control all of the animals of a given species within a range equal to 10' x his level (e.g., at 30th level you could control all of the ferrets or minks within 300')." } },
