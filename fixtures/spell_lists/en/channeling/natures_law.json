    "description": "Open Channeling 2.6 - Nature's Law. Spells of plant/herb/stone lore, animal and plant tongues, animal mastery and empathy, and nature's awareness.",
    "spells": [
      { "name": "02. Plant Lore", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 plant", "duration": "—", "range": "10'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns nature, history, and value of any 1 plant." } },
