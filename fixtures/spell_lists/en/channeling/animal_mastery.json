      {
        "name": "14. Animal Reviving I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 14,
          "area_of_effect": "1 animal",
          "duration": "P",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Will return any animal up to 10 pounds in weight from the dead. The dead animal must make a roll (d100, open-ended) and add 2 times its previous level. There is an additional modifier of -2 per day that the animal was dead. If the result is over 100, the animal is returned from the dead. If the result is less than 100, the animal may not be returned from the dead by this caster (until the caster gains another level). The animal will be at -100 to all actions for a number of days equal to 20 days per day dead."
        }
      },
