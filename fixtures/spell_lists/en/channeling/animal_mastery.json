        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 15,
          "area_of_effect": "1 animal",
          "duration": "P",
          "range": "touch",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "When cast upon any domesticated animal, that animal will return to its \"wild\" state. The animal will have no difficulty adapting to the harsh requirements of the wilderness (and will not want to return to domestication)."
        }
