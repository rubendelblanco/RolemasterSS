    "description": "Spell Law 4.1 - Animist Base List. Spells for controlling, healing, summoning, and communicating with animals.\n\nSPECIAL NOTES: When allowed to choose more than one option on summoning spells, the same option may be chosen more than once. For example, with Animal Summons III, two options are available. This means that if both options are used for the same thing: three first-level creatures could be summoned, or one third-level creature could be summoned, or one first-level creature could be summoned for four times as long.",
    "spells": [
      {
        "name": "01. Animal Sleep I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 animal",
          "duration": "1 min/lvl",
          "range": "100'",
          "type": "F",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Puts any animal (i.e., non-humanoid) to sleep. Will not affect enchanted creatures or creatures with greater than animal intelligence."
        }
      },
      {
        "name": "02. Animal Restoration I",
        "img": "systems/rmss/assets/default/spell.svg",
