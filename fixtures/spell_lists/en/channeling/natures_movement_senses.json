    },
    "description": "Spell Law 4.4 - Animist Base List. Spells that grant the caster animal-like movement, senses, and physical attributes.\n\nSPECIAL NOTES: With the exception of Chameleon Skin, Lion Claws, and Viperfang, the caster does not physically change with any of the spells on this list.",
    "spells": [
      {
        "name": "01. Cat Step",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "caster",
          "duration": "1 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster moves as quietly as a cat. Adds +20 to all Stalking maneuvers."
        }
      },
      {
        "name": "02. Chameleon Skin",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "caster",
          "duration": "1 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster's skin takes on the coloration of the surrounding terrain. Adds +10 to +50 to all Stalking/Hiding maneuvers. As caster moves, coloration changes to match the surrounding terrain. This spell does not affect gear or clothing."
        }
      },
      {
        "name": "03. Wolf Sense",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "caster",
          "duration": "1 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster gains an increased sense of smell and hearing (subtle smells and higher sonic ranges included). Adds +50 to Perceptions with only these senses; +20 to Perceptions using these senses combined with others."
        }
      },
      {
        "name": "04. Deer Speed I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 4,
          "area_of_effect": "caster",
          "duration": "10 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster can run at two times normal pace (i.e., Run pace) and expend exhaustion points as if only walking."
        }
      },
      {
        "name": "05. Bat Sense",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 5,
          "area_of_effect": "caster",
          "duration": "1 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Increases caster's ability to maneuver without his sight. When blinded or otherwise without sight, this spell adds +10 to +50 to maneuver rolls in the dark. Note that this spell does not negate penalties for blindness; it simply decreases them."
        }
      },
      {
        "name": "06. Otterlungs",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 6,
          "area_of_effect": "caster",
          "duration": "1 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster can safely hold his breath for the duration of this spell."
        }
      },
      {
        "name": "07. Glide I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 7,
          "area_of_effect": "caster",
          "duration": "1 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster can glide like a bird. The product of the caster's altitude and horizontal speed cannot exceed 100' per round. For example, a caster can glide along at a rate of 5' per round if he were 20' off the ground; or he could glide at the rate of 50' per round if he were 2' off the ground. Note that the total must equal 100' (i.e., the caster cannot choose to have a total less than or more than 100')."
        }
      },
      {
        "name": "08. Hawk Sense",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 8,
          "area_of_effect": "caster",
          "duration": "1 min/lvl",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster gains the visual acuity of a hawk. Adds +50 to all Perceptions involving only sight; +20 to all Perceptions involving this sense combined with others."
        }
      },
      {
