    "description": "Animist Base List 4.6 - Plant Mastery. Spells to learn about, grow, restore, control and animate plants, and summon a wall of thorns.",
    "spells": [
      { "name": "01. Plant Lore", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 plant", "duration": "—", "range": "touch", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns nature and history of any 1 plant." } },
      { "name": "02. Speed Growth I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "10'R", "duration": "1 day", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to increase speed of growth for any 1 species of plant within the area of effect by 10 times." } },
      { "name": "03. Plant Tongues", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "touch", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to understand and 'speak' the language of any 1 plant species." } },
      { "name": "04. Plant Restore", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 plant", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Heals damage to one plant that is less complex than a tree (especially severe damage may get a RR to avoid the effects of this spell, GM discretion)." } },
      { "name": "05. Speed Growth II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "10'R", "duration": "1 day", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Speed Growth I, except growth rate is 100 times normal." } },
      { "name": "06. Plant Location", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 mi R", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can locate members of any 1 species of plant or he can find out what species are in the area of effect." } },
      { "name": "07. Plant Growth II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 plant", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to double the size of any 1 plant. The growth takes place over the course of 1 day." } },
      { "name": "08. Plant Control I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 plant", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Caster can control the automatic and/or mental processes of any 1 plant. The caster can also control the plant's movements, though this spell doesn't allow movement beyond normal allowances." } },
      { "name": "09. Speed Growth III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "100'R", "duration": "1 day", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Speed Growth I, except the area of effect is 100' radius, and the range is 100'." } },
      { "name": "10. Plant Growth III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 plant", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Plant Growth I, except size increase is 3 times." } },
      { "name": "11. Plant Control III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "3 plants", "duration": "1 min/lvl", "range": "touch", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Plant Control I, except caster can control any 3 plants." } },
      { "name": "12. Tree Restore", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 tree", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Plant Restore, except it can affect any plant (including trees)." } },
      { "name": "13. Plant Growth V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 plant", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Plant Growth I, except size increase is 5 times." } },
      { "name": "14. Speed Growth IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "100'R", "duration": "1 day", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Speed Growth II, except the area of effect is 100' radius and the range is 100'." } },
      { "name": "15. Plant Control V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "5 plants", "duration": "1 min/lvl", "range": "touch", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Plant Control I, except caster can control any 5 plants." } },
      { "name": "16. Wall of Thorns", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "10'x10'x5'", "duration": "10 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Summons a wall of very tough (but pliable) thorns. The wall is up to 10' x 10' x 5'. Anyone moving through the wall receives d10 dagger attacks (use a +50 dagger attack on the Dagger Attack Table, if available) per foot of wall moved through. The wall must rest on a solid surface." } },
      { "name": "17. Firestop", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "10'R/lvl", "duration": "10 min/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "This spell will put out any fires upon living materials that are in the area of effect." } },
      { "name": "18. Plant Growth X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 plant", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Plant Growth I, except size increase is 10 times." } },
      { "name": "20. Plant Growth True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "100'R", "duration": "P", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Plant Growth I, except affects all plants in the area of effect." } },
      { "name": "25. Speed Growth True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "10'R/lvl", "duration": "1 day", "range": "10'/lvl", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Speed Growth I, except for the range and area of effect." } },
      { "name": "30. Plant Control True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "100'R", "duration": "1 min/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Plant Control I, except caster can control all plants within the area of effect." } },
      { "name": "50. Plant Animation", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 plant", "duration": "1 min/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can animate any 1 plant. The plant can then move slowly, carrying any root system it may possess along." } }
    ]
  }
