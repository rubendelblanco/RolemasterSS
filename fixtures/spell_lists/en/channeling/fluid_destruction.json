    "description": "Sorcerer Base List 9.2 - Fluid Destruction. Spells to vaporize, freeze, evaporate and disintegrate liquids, calm water, stop rain, dehydrate, and cause earthquake-like humidity shifts.",
    "spells": [
      { "name": "01. Vaporize Fluid", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "10 cu'/lvl", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "For each level of the caster, he may vaporize 10 cubic feet of liquid." } },
      { "name": "02. Freeze Fluid", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "10 cu'/lvl", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "For each level of the caster, he may freeze 10 cubic feet of liquid. Caster is immune to the cold." } },
      { "name": "03. Evaporate I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1000 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes 1,000 cubic feet of liquid to rapidly evaporate (over the course of 1 hour)." } },
      { "name": "04. Unwater I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Instantly disintegrates 100 cubic feet of water." } },
      { "name": "05. Calm Water", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "100'R", "duration": "C", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Water within the area of effect is calmed. Waves are cut 20' in center and less towards the perimeter." } },
      { "name": "06. Water Bolt I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 target", "duration": "—", "range": "100'", "type": "DE", "subType": "-", "attack_table": "", "skillName": "", "description": "A bolt of water is shot from the palm of the caster. Attack is resolved on the Water Bolt Attack Table." } },
      { "name": "07. Unrain", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "100'R", "duration": "4 hrs/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "No precipitation will occur in the area of effect for the duration of this spell." } },
      { "name": "08. Dehydrate", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Removes all the liquid (usually water) from 1 cubic foot of inanimate material." } },
      { "name": "09. Evaporate II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "10,000 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Evaporate I, except 10,000 cubic feet are affected." } },
      { "name": "10. Unwater II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1000 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unwater I, except 1000 cubic feet are affected." } },
      { "name": "11. Unrain True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "500'R/lvl", "duration": "1 day/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unrain, except for area of effect and duration." } },
      { "name": "12. Dehydrate True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "10 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Dehydrate, except affects 10 cubic feet." } },
      { "name": "13. Evaporate III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "100,000 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Evaporate I, except affects 100,000 cubic feet." } },
      { "name": "14. Unwater III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "10,000 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unwater I, except affects 10,000 cubic feet." } },
      { "name": "15. Greater Calm Water", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "100'R/lvl", "duration": "C", "range": "100'/lvl", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Calm Water, except waves are cut by 50' in center." } },
      { "name": "17. Long Fluid Destruction", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "varies", "duration": "varies", "range": "300'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As any single 10th level or lower spell on this list, except with a range of 300'." } },
      { "name": "19. Desiccation", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 target", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "The target immediately begins to dehydrate and weather as if in a wind-blown, sandy desert. The target is immediately at -10% to activity and takes 1% of his total hits. For each round that the caster concentrates, the target loses another 5% activity and 1% of his total hits. If the caster maintains concentration for 28 consecutive rounds, animate targets will be reduced to dried out husks. The hits may be healed normally, but the activity penalty only recovers at the rate of 10% per day (or via a Cure Disease spell, GM's discretion)." } },
      { "name": "20. Dehumidify", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 mi R", "duration": "P", "range": "1 mi", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "For every minute that the caster concentrates, the humidity drops 1% of the original humidity (up to 50%). The humidity will gradually increase at a rate of 5% (of original humidity) per day until the original humidity is reached." } },
      { "name": "25. Evaporate True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1,000,000 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Evaporate I, except 1,000,000 cubic feet can be affected." } },
      { "name": "30. Calm Water True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1000'R/lvl", "duration": "C", "range": "1000'/lvl", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Calm Water, except area of effect is 1,000' radius per level of the caster." } },
      { "name": "50. Dehumidify True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1000'R/lvl", "duration": "P", "range": "1000'/lvl", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Every minute that the caster concentrates, the humidity drops 5% of the original humidity (up to 95%). The humidity increases as in Dehumidify." } }
    ]
  }
