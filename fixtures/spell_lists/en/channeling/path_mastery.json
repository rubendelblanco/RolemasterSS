    "description": "Ranger Base List 7.6 - Path Mastery. Spells of pathfinding, tracking, detecting ambush, animal/plant/stone tongues, and nightvision.",
    "spells": [
      { "name": "01. Pathlore", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "10'R", "duration": "—", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns origin and nearest 'destination' of the closest path within the area of effect." } },
      { "name": "02. Nightvision", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can see 100' on a normal night as if it were daylight." } },
      { "name": "03. Tracking I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster gets a special bonus of +50 for all Tracking maneuvers." } },
      { "name": "04. Path Tale", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster acquires visual image of any user(s) of a given path, up to 1 hour in the past per level of the caster." } },
      { "name": "05. Pathfinding I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "caster", "duration": "C", "range": "1 mile", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns the location(s) of any path(s) within 1 mile. This spell reveals the nearest point on path, but not the path's course." } },
      { "name": "06. Tracks Lore", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "caster", "duration": "—", "range": "touch", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster learns origin of tracks, and acquires a visual image of the one who left them. Caster will gain a special bonus of +25 when tracking this particular being or animal." } },
      { "name": "07. Detect Ambush I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "50'R", "duration": "10 min/lvl(C)", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster is aware of any being within the area of effect that has hostile intentions towards him. The hostility must be directed specifically at the caster. The being's hostility must be active (i.e., the being intends to perform aggressive actions), not passive (i.e., no action is planned)." } },
      { "name": "08. Passing Lore", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 object", "duration": "—", "range": "touch", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster acquires visual and aural (sound) image of any being or animal that has passed within a 50' radius of a specific object. The being or animal can have passed up to 1 hour per level earlier. If more than one being or animal has passed, the caster will see them one image at a time, 1 image per round (starting with the oldest image)." } },
      { "name": "09. Pathfinding V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "caster", "duration": "C", "range": "5 miles", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Pathfinding I, except range is 5 miles." } },
      { "name": "10. Animal Tongues", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to understand and 'speak' the language of any 1 animal species." } },
      { "name": "11. Tracks Analysis", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "100'R", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster acquires a visual image of all beings or animals who left tracks in the area. This provides a special bonus of +50 when later tracking that particular being or animal. If more than one being or animal has left tracks, the caster will see them one image at a time, one image per round (starting with the oldest image)." } },
      { "name": "12. Plant Tongues", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to understand and 'speak' the language of any 1 plant species." } },
      { "name": "13. Pathfinding XX", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "caster", "duration": "C", "range": "20 miles", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Pathfinding I, except for range." } },
      { "name": "14. Detect Ambush II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "caster", "duration": "10 min/lvl(C)", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Ambush I, except area of effect is 100' radius." } },
      { "name": "15. Stonespeech", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to understand and 'speak' the language of any 1 'stone.'" } },
      { "name": "16. Tracking II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Tracking I, except bonus is +75." } },
      { "name": "17. Detect Ambush III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "150'R", "duration": "10 min/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Ambush I, except area of effect is 150' radius." } },
      { "name": "19. Paths True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "caster", "duration": "—", "range": "1 mi/lvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Pathfinding I, except range is 1 mile per level and exact route(s) within the range are ascertained." } },
      { "name": "20. Detect Ambush True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "10'R/lvl", "duration": "10 min/lvl(C)", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Ambush, except area of effect is 10' radius per level." } },
      { "name": "25. Know Path", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to ascertain the proper path to what he seeks (includes the course along that path). For example, he will always know the best way to a known destination." } },
      { "name": "30. Tracking True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Tracking, except that it will negate any Hide Tracks spell (except for Hide Tracks True), and will always give tracker a special +100 Tracking bonus." } },
      { "name": "50. Tracks Ahead", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 mi/lvl", "duration": "C", "range": "100'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to know entire course of the tracks in the area of effect (i.e., exactly where and how they go). This will not negate Hide Tracks True." } }
    ]
  }
}
