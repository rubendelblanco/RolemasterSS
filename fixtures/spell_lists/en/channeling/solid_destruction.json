{
  "name": "Solid Destruction",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "channeling",
    "profession": "Sorcerer",
    "is_container": true,
    "container": {
      "maxCapacity": 50,
      "usedCapacity": 0,
      "capacityType": "quantity",
      "allowedTags": ["spell"]
    },
    "description": "Sorcerer Base List 9.5 - Solid Destruction. Spells to melt ice, loosen and erode earth and stone, vaporize doors, shatter and disintegrate inorganic material, and cause earthquakes.",
    "spells": [
      { "name": "01. Melt Ice", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "10 cu'/lvl", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "For each level of the caster, he may melt up to 10 cubic feet of ice." } },
      { "name": "02. Loosen Earth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Loosens 100 cubic feet of earth to the consistency of plowed ground." } },
      { "name": "03. Erosions", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "100 cu'/lvl", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "For each level of the caster, he causes a 100 cubic foot section of inorganic material to erode and deteriorate at 1,000x normal rate." } },
      { "name": "04. Cracks Call", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "10'x10'x10'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Any previous cracks or flaws in a material section up to 10'x10'x10' will extend to their limit." } },
      { "name": "05. Undoor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "10'x10'x6\"", "duration": "P", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Will vaporize a non-magic door up to 6\" thick, 10' high, and 10' wide (if the door is thicker than 6\" it will vaporize the closest 6 inches). This will only work on an object that is used as a door (e.g., a caster cannot Undoor a section of wall)." } },
      { "name": "06. Stone/Earth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Changes 100 cubic feet of stone to packed earth. Change is gradual (taking 3 rounds for full effect)." } },
      { "name": "08. Earth/Mud", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Stone/Earth, except changes earth to soft mud." } },
      { "name": "10. Corridor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "3'x6'x1'/lvl", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates a 3'x6' corridor that is 1' per level long. It can cut through any non-metal, inorganic material. The corridor is created at a rate of 1' (length) per round as long as the caster concentrates." } },
      { "name": "11. Shatter", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Can shatter an inorganic object, up to 1 cubic foot. All within a 5' radius take an 'A' Impact critical and holder takes a 'C'. Metal objects get a special +30 RR modification." } },
      { "name": "12. Unearth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Disintegrates 100 cubic feet of earth." } },
      { "name": "13. Unstone", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unearth, except affects stone." } },
      { "name": "14. Undoor True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 door", "duration": "P", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Undoor, except any single door is vaporized." } },
      { "name": "15. Unmetal", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unearth, except affects 1 cubic foot of metal." } },
      { "name": "17. Long Solid Destruction", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "varies", "duration": "varies", "range": "300'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As any single 10th level or lower spell on this list, except with a range of 300'." } },
      { "name": "19. Crevasse", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "100'x10'x200'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes a large crack to open in the ground. The size of the crack will be up to 10' wide, up to 100' deep, and up to 200' long. The crack takes 2 rounds to open." } },
      { "name": "20. Solid Destruction True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 cu'/lvl", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unearth, except it will disintegrate 1 cubic foot per level of the caster of any inanimate solid." } },
      { "name": "25. Tremors", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "varies", "duration": "1 rnd", "range": "100'/lvl", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes a very minor earthquake which could cause shoddy construction to collapse (can be very terrifying). This is approximately 5.5 on the Richter scale." } },
      { "name": "30. Great Crack", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "varies", "duration": "P", "range": "300'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes a large crevice to open in the ground (up to 10' per level deep, 1' per level wide and 20' per level long). The crevice takes 2 rounds to open. The caster can concentrate for 3 rounds to close the crevice." } },
      { "name": "50. Quake", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "varies", "duration": "varies", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can cause an earthquake, with the spot he touches as the epicenter. The quake can be delayed up to 1 round per level. The severity of the quake on the Richter scale is determined by a d100 roll: (01-20) = 5.5, (21-45) = 6, (46-65) = 6.5, (66-80) = 7.0, (81-90) = 7.5, (91-95) = 8.0, (96-98) = 8.5, (99-100) = 9.0." } }
    ]
  }
}
