      "allowedTags": ["spell"]
    },
    "description": "Sorcerer Base List 9.4 - Mind Destruction. Mental attack spells that inflict pain, stun, disorientation, forgetting, blanked minds, horror, and lost experience.",
    "spells": [
      { "name": "01. Minor Pain", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 target", "duration": "10 min/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target takes 25% of his remaining concussion hits (i.e., those not already taken). These hits are restored when the duration is up, provided target has not died." } },
      { "name": "02. Jolts I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 target", "duration": "1 rnd/10 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target is stunned." } },
      { "name": "03. Disorientation", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 target", "duration": "1 day/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target must subtract 25 from all orientation and perception rolls, and 5 from all initiative rolls." } },
      { "name": "04. Unbalance", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 target", "duration": "1 day/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target must subtract 25 from all maneuver rolls." } },
      { "name": "05. Distortions", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "1 day/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target must subtract 25 from all attack rolls." } },
      { "name": "06. Jolts III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 target", "duration": "3 rnd/10 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Jolts I, except for duration." } },
      { "name": "07. Major Pain", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 target", "duration": "10 min/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Minor Pain, except 50% of remaining hits are taken." } },
      { "name": "08. Forget", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 target", "duration": "P", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target forgets a period of (1 minute per level) of his past, as desired by the caster." } },
      { "name": "09. Word of Pain", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 9, "area_of_effect": "1 target", "duration": "P", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Major Pain, except hits must be healed normally." } },
      { "name": "10. Mind Shock", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 target", "duration": "1 day/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Disorientation, Unbalance, and Distortions (all at once)." } },
      { "name": "11. Mind Death", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 target", "duration": "P", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target's mind blanks out for a period of 10 minutes each day at random. Target is incapable of activity or thought during this period." } },
      { "name": "12. Jolts V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 target", "duration": "5 rnd/10 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Jolts I, except for duration." } },
      { "name": "13. Unminding", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 target", "duration": "10 rnd/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target's mind is completely blank for the duration. He cannot perceive events, time, or activity. At the end of the duration of this spell, he is stunned for 1 round after his mind comes back." } },
      { "name": "14. Mass Disorientation", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 target/lvl", "duration": "1 hr/5 fail", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Disorientation, except affects a number of targets equal to the caster's level." } },
      { "name": "15. Mind Break", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 target", "duration": "1 day/10 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target is a blathering idiot. He can be led around, but he can take no action." } },
      { "name": "16. Mass Unbalance", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 target/lvl", "duration": "1 day/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Unbalance, except affects a number of targets equal to the caster's level." } },
      { "name": "17. Long Mind Destruction", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 target", "duration": "varies", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As any single 10th level or lower spell on this list, except with a range of 300'." } },
      { "name": "18. Mass Distortions", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 target/lvl", "duration": "1 day/5 fail", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Distortions, except affects a number of targets equal to the caster's level." } },
      { "name": "19. Horror", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 target", "duration": "varies", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "[RR Mod: -20] The target believes he is being engaged by a creature of his own worst fears. The target will be attacked each round by the creature (who has a +100 Martial Arts Strikes Rank I attack; the damage is real). Regardless of the damage done by the target (to the creature), the creature will only be defeated when the target makes his RR (one RR each minute), or when he loses consciousness." } },
      { "name": "20. Lost Experience I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 target", "duration": "P", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target loses 5% of his collected experience (usually experience points). Note that the target will not lose a level, only experience points (which means he will have to gain that many more experience points to gain his next level)." } },
      { "name": "25. Mass Pain", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 target/lvl", "duration": "10 min/5 fail", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Major Pain, except as many targets as the caster's level are affected, the duration is until healed, and the range is 300'." } },
      { "name": "30. Mass Mind Shock", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 target/lvl", "duration": "1 day/5 fail", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Mind Shock, except as many targets as the caster's level can be affected and the range is 300'." } },
      { "name": "50. Mass Unminding", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 target/lvl", "duration": "1 rnd/5 fail", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Unminding, except as many targets as the caster's level can be affected and the range is 300'." } }
    ]
  }
}
