    },
    "description": "Ranger Base List 7.2 - Moving Ways. Spells to run and swim without tiring across rock, limbs, water and sand, hide tracks, pass without a trace, and merge into organic material.",
    "spells": [
      { "name": "01. Rockrunning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can run on any nearly horizontal rocky and earthen surfaces as if he was on level ground. He will expend exhaustion points as if he were walking." } },
      { "name": "02. Limbwalking", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to walk along tree limbs as if he were on level ground." } },
      { "name": "03. Swimming", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can swim without expending energy (i.e., will expend no exhaustion points)." } },
      { "name": "04. Waterwalking", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can walk on water as if he were on level dry ground. This may not be used on rough water." } },
      { "name": "05. Sandrunning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can run on sandy surfaces as if he was on level ground. He will expend exhaustion points as if he were walking." } },
      { "name": "06. Limbrunning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Limbwalking, except caster can move at two times normal pace (i.e., Run pace). He will expend exhaustion points as if he were walking." } },
      { "name": "07. Traceless Passing", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can walk without leaving tracks or other visible signs of his passing." } },
      { "name": "08. Hide Tracks I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "tracks of 1", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can hide the tracks of any 1 being. This spell and Traceless Passing can be used simultaneously and caster will still maintain 50% activity (i.e., he can concentrate on both spells at the same time)." } },
      { "name": "09. Waterrunning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waterwalking, except caster can move at two times normal pace (i.e., Run pace). He will expend exhaustion points as if he were walking." } },
      { "name": "10. Hide Tracks II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "tracks of 2", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Hide Tracks I, except it hides 2 beings' tracks." } },
      { "name": "11. Swimming True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Swimming, except target can swim as fast as he could run. He will expend exhaustion points as if he were walking." } },
      { "name": "12. Hide Tracks V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "tracks of 5", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Hide Tracks I, except it hides 5 beings' tracks." } },
      { "name": "13. Running True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As any of the Running spells above, except any one of the spells can be used each round (e.g., the caster could run on sand, then on water, then on limbs, etc.)." } },
      { "name": "14. Traceless Passing True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Traceless Passing, except caster need not concentrate." } },
      { "name": "15. Merging Organic", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can merge into organic material (live or dead). While merged, the caster cannot move or perceive. When the caster emerges from the material, he can emerge from any side or face of the material. The caster cannot move 'through' material greater in width than his own body size plus 2 feet." } },
      { "name": "16. Hide Tracks X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "tracks of 10", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Hide Tracks I, except it hides 10 beings' tracks." } },
      { "name": "17. Traceless Running", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Traceless Passing, except caster can move at two times normal pace (i.e., at a Run pace)." } },
      { "name": "18. Hide Tracks XV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "tracks of 15", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Hide Tracks I, except it hides 15 beings' tracks." } },
      { "name": "19. Traceless Running True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Traceless Passing True, except caster can move at two times normal pace (i.e., Run pace)." } },
      { "name": "20. Great Merging Organic", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Merging Organic, except caster may turn within material and perceive the world outside the material." } },
      { "name": "25. Hide Tracks XX", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "tracks of 20", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Hide Tracks I, except it hides 20 beings' tracks." } },
      { "name": "30. Merging True Organic", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Great Merging Organic, except caster may use spells on himself while merged." } },
      { "name": "50. Hide Tracks True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "varies", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Hide Tracks I, except caster can either absolutely hide his own tracks (preventing discovery via any method, including magic) or he can hide the tracks of a number of beings equal to his level." } }
    ]
  }
}
