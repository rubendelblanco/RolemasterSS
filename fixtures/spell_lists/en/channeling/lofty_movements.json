    "description": "Open Channeling 2.5 - Lofty Movements. Spells to walk or run on edges, limbs, stone, water, and wind, merge into organic material, and return to a stored sanctuary.",
    "spells": [
      { "name": "02. Edgewalking", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can walk along narrow edges (down to 2\" wide) that can support his weight. Maneuver rolls are not normally required." } },
      { "name": "04. Limbwalking", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can walk along tree limbs as if he were on level ground." } },
      { "name": "05. Stonewalking", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can walk on stone surfaces of up to 60° as if he were on level ground." } },
      { "name": "06. Waterwalking", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can walk on water as if he were on level ground; may not be used on rough water." } },
      { "name": "07. Merging Organic", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can merge into organic material (live or dead). While merged, the target cannot move or perceive. When the target emerges from the material, he can emerge from any side or face of the material. The target cannot move 'through' material greater in width than his own body size plus 2 feet." } },
      { "name": "08. Store Sanctuary", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "caster", "duration": "P", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster 'stores' a location for use with certain other spells on this list. While casting this spell, the caster must meditate for one hour in the location that will be stored. The caster can only have one sanctuary stored at a time. As long as this location remains 'stored,' it will detect as a magical (i.e., 'holy') place." } },
      { "name": "09. Limbrunning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Limbwalking, except target can run." } },
      { "name": "10. Stonerunning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Stonewalking, except target can run." } },
      { "name": "11. Waterrunning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waterwalking, except target can run." } },
      { "name": "12. Windwalking", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can walk on calm air. This spell only allows for horizontal movement. Vertical movement must be achieved by other means." } },
      { "name": "13. Returning I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster may return to his stored sanctuary so long as the sanctuary is no more than 1 mile away." } },
      { "name": "15. Great Merging Organic", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Merging Organic, except target may turn within the material and perceive the world outside of the material." } },
      { "name": "16. Returning V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Returning I, except the sanctuary can be up to 5 miles away." } },
      { "name": "18. Windrunning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Windwalking, except target can run." } },
      { "name": "19. Returning X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Returning I, except the sanctuary can be up to 10 miles away." } },
      { "name": "20. Merging True Organic", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Great Merging Organic, except target may use spells on himself while merged." } },
      { "name": "25. Windrunning True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Windrunning, except target can run up to twice the normal speed on calm air without expending energy." } },
      { "name": "30. Word of Return", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 30, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Returning I, except the sanctuary can be any distance away up to 10 miles per level of the caster." } },
      { "name": "50. Rereturning", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 50, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster may go to his sanctuary (as per Word of Return), stay up to 1 round per level, and then return to the point where he cast his spell (thus making it a round trip)." } }
    ]
  }
}
