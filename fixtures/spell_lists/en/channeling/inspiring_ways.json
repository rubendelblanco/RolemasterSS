    "description": "Paladin Base List 6.6 - Inspiring Ways. Spells to bolster courage and inspire allies in battle, and mental attack spells to make a target believe the caster's words as friendship, reason, caution, or command.",
    "spells": [
      { "name": "01. Courage", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "10'R", "duration": "1 rnd/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "For the duration of this spell, all within the area of effect (including the caster) may make a second RR versus any fear or panic effect. This second RR is made with an additional +10 modifier." } },
      { "name": "02. Inspirations I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 2, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster inspires all allies who are within the area of effect (they must be aware of the caster). All allies gain +5 to melee attacks and moving maneuvers for the duration of the spell. This spell will only work during combat or highly religious moments (e.g., an oratory presentation prior to a large battle). These bonuses do not apply to the caster." } },
      { "name": "03. Voice of Friendship", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 3, "area_of_effect": "1 target", "duration": "varies", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "For as long as they speak together, the target of this spell will believe that the caster is a good friend and is acting in the target's best interest." } },
      { "name": "04. Inspirations II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 4, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Inspirations I, except bonuses are +10." } },
      { "name": "05. Voice of Reason", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 5, "area_of_effect": "1 target", "duration": "varies", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "For as long as the caster speaks, the target will believe that the reasoning and ideas that the caster expresses are correct and valid." } },
      { "name": "06. Inspirations III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 6, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Inspirations I, except bonuses are +15." } },
      { "name": "07. Voice of Caution", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 7, "area_of_effect": "1 target", "duration": "varies", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "For as long as the caster speaks, the target will become more cautious (less rash) and will tend to obey the caster's warnings without hesitation or doubt." } },
      { "name": "08. Command I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 8, "area_of_effect": "1 target", "duration": "C", "range": "10'/lvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target must obey the caster. However, he will not perform any act that is completely alien to him (e.g., no suicide suggestions, no blinding himself suggestions, etc.)." } },
      { "name": "09. Inspirations IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 9, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Inspirations I, except bonuses are +20." } },
      { "name": "10. Words of Friendship", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 10, "area_of_effect": "varies", "duration": "varies", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Voice of Friendship, except will affect all who can hear the caster." } },
      { "name": "11. Inspirations V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 11, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Inspirations I, except bonuses are +25." } },
      { "name": "13. Command II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 13, "area_of_effect": "2 targets", "duration": "C", "range": "10'/lvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Command I, except affects two targets." } },
      { "name": "14. Words of Reason", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 14, "area_of_effect": "varies", "duration": "varies", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Voice of Reason, except will affect all who can hear the caster." } },
      { "name": "15. Inspirations VI", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 15, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Inspirations I, except bonuses are +30." } },
      { "name": "16. Courage True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "10'R", "duration": "1 rnd/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Courage, except the second RR automatically succeeds." } },
      { "name": "17. Inspirations VII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 17, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Inspirations I, except bonuses are +35." } },
      { "name": "18. Words of Caution", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 18, "area_of_effect": "varies", "duration": "varies", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Voice of Caution, except will affect all who can hear the caster." } },
      { "name": "19. Inspirations VIII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 19, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Inspirations I, except bonuses are +40." } },
      { "name": "20. Voice of Conviction", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 target", "duration": "varies", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "[RR Mod: -50] After casting this spell, the caster must tell the truth (as he knows it). All targets who fail their RR will believe the caster is speaking the absolute truth." } },
      { "name": "25. Inspirations True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 25, "area_of_effect": "20'R", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Inspirations I, except bonuses are +50." } },
      { "name": "30. Words of Conviction", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "varies", "duration": "varies", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Voice of Conviction, except will affect all who can hear the caster." } },
      { "name": "50. Inspirations Mastery", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "varies", "duration": "1 rnd/lvl", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can use any lower level spell from this list once per round." } }
    ]
  }
