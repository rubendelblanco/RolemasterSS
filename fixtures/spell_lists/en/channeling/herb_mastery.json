          "duration": "1 rnd/lvl",
          "range": "100'",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows caster to locate any 1 specific variety of herb that is sought, regardless of physical obstacles (gives exact direction, distance, and quantity)."
        }
      },
