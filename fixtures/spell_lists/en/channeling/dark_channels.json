    "description": "Closed Channeling (Evil) - Dark Channels. Spells for stunning, sleep, blinding, channeling spells to others, soul destruction, and communion with evil deities. See Spell Law Section 15.23 (Black Channels), 15.24 (Evil spell lists), 24.1 (soul destruction).",
    "spells": [
      {
        "name": "02. Dark Stunning",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "1 target",
          "duration": "1 rnd/5 fail",
          "range": "100'",
          "type": "D",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "[RR Mod: -10] Caster points his arm (elbow locked and fist clenched) at the target and channels raw power source (usually a deity). The target is stunned."
        }
      },
      {
        "name": "03. Channels I",
        "img": "systems/rmss/assets/default/spell.svg",
