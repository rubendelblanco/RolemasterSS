    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Warrior Mage Base 14.6.6 - Will of the Warrior. Spells of mental fortitude that let the caster shrug off stun, pain, wounds, and exhaustion through sheer force of will.",
    "spells": [
      { "name": "02. Extended Endurance I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "While this spell is in effect, the caster only expends two-thirds of the normal exhaustion points for any actions he performs." } },
      { "name": "03. Stun Relief I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 3, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Caster is relieved of one round's worth of accumulated stun." } },
      { "name": "04. Unpain I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 4, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Caster is able to sustain an additional 25% of his total concussion hits before passing out. Hits are still taken and remain when the spell lapses." } },
      { "name": "05. Concentration II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 5, "area_of_effect": "caster", "duration": "1 rnd", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Adds +20 to any one maneuver. No other action can be performed the round this maneuver is resolved." } },
      { "name": "06. Extended Endurance II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Extended Endurance I, except the caster only expends one-third of the normal exhaustion points." } },
      { "name": "07. Stun Relief II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 7, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Stun Relief I, except 2 rounds of stun are relieved." } },
      { "name": "08. Ignore Wound I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 8, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Cuts the maneuver penalty from any one wound in half for the duration of the spell." } },
      { "name": "09. Unpain II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 9, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Unpain I, except 50% additional hits may be sustained." } },
      { "name": "10. Interrogation Resistance", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 10, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster gains a +50 to RRs versus interrogation and +50 to RRs versus mind reading spells the caster is aware of." } },
      { "name": "11. Concentration IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 11, "area_of_effect": "caster", "duration": "1 rnd", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Concentration II, except bonus is +40." } },
      { "name": "12. Moment of Clarity", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 12, "area_of_effect": "caster", "duration": "1 rnd", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can ignore all penalties and accumulated stun rounds from all wounds he has taken for 1 round. He may also ignore any penalties for the total concussion hits he has taken." } },
      { "name": "13. Extended Endurance III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Extended Endurance I, except the caster only expends half of the normal exhaustion points." } },
      { "name": "14. Unstun", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 14, "area_of_effect": "caster", "duration": "—", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Caster can ignore all stun rounds incurred from any one wound." } },
      { "name": "15. Unpain III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 15, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Unpain I, except 75% additional hits may be sustained." } },
      { "name": "16. Ignore Elements", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster is unaffected by natural extremes of temperature. He may move about comfortably in the hottest desert (200°F) or the coldest arctic waste (-100°F) in only light clothing." } },
      { "name": "17. Ignore Wound II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 17, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Ignore Wound I, except that the penalty is reduced by 75%." } },
      { "name": "18. Concentration V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 18, "area_of_effect": "caster", "duration": "1 rnd", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Concentration II, except bonus is +50." } },
      { "name": "19. Focus", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 19, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster gains a +20 bonus to all maneuvers he attempts that bring him closer to a goal he sets at the time of casting. This goal must be attainable in the spell's duration. Once the goal is set, the caster will be reluctant to perform any action that does not carry him closer to his goal." } },
      { "name": "20. Unpain IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 20, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Unpain I, except 100% additional hits may be sustained." } },
      { "name": "25. Extended Endurance IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "While this spell is in effect, the caster expends no exhaustion points for any actions he performs." } },
      { "name": "30. Ignore Wound III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 30, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "As Ignore Wound I, except that the penalty is reduced by 90%." } },
      { "name": "50. Warriors Will True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 50, "area_of_effect": "caster", "duration": "1 rnd/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "For the duration, caster cannot be stunned, takes no maneuver penalties from wounds, and expends no exhaustion points. At the end of the spell, the caster goes unconscious for 1 hour for every round the spell was in effect." } }
    ]
  }
