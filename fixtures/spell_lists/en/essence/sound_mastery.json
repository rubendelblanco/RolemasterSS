    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Open Essence 14.2.5 - Sound Mastery. Spells to enhance and project hearing and voice, silence and wall off sound, deafen and mute a target, and shatter objects with sound.",
    "spells": [
      { "name": "01. Sly Ears", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target gains double normal hearing. This results in +50 to Awareness maneuvers involving only hearing; +25 involving hearing and other senses." } },
      { "name": "02. Volume Control", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can modify the volume of all natural noises produced by the target to x0.5 to x2 original volume (the volume must be selected at the time of casting)." } },
      { "name": "03. Quiet I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates a 1'R area around the target, into and out of which sound cannot travel; if the point is on a mobile object or being, it will move with the object/being; +25 to Stalking attempts. See Section 7.1.7 in Spell Law." } },
      { "name": "04. Selective Hearing", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can select a specific source of sound that he can hear clearly. All other forms of noise will be muted. This spell effectively screens out all forms of background noise. Caster must make an Alertness maneuver to recognize any other sound for the duration of this spell." } },
      { "name": "05. Long Voice I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 point", "duration": "1 min/lvl (C)", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster designates a point within the range of the spell. Caster can speak and his voice will be heard as if it originates at that point." } },
      { "name": "06. Soundwall I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "20'x20'", "duration": "10 min/lvl", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates a plane (up to 20'x20'), through which sound will not pass." } },
      { "name": "07. Long Ear I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 point", "duration": "1 min/lvl (C)", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster's point of hearing may be moved independently up to 100' away (moves at the rate of 10' per round). He must physically be able to go there (e.g. he could not send his point of hearing through walls or doors)." } },
      { "name": "08. Silence I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Quiet I, except affects a 10'R." } },
      { "name": "09. Quiet III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "3 targets", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Quiet I, except may affect up to three targets." } },
      { "name": "10. Sounding", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Target's voice has its loudness quadrupled. This has no effect on spell casting capabilities (it simply allows the target to make himself heard without difficulty over long distances)." } },
      { "name": "11. Soundwall V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "(20'x20')x5", "duration": "10 min/lvl", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Soundwall I, except 5 such walls are created. Each Soundwall must be connected to at least one other Soundwall." } },
      { "name": "12. Long Voice III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 point", "duration": "C", "range": "300'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Long Voice I, except range is 300'." } },
      { "name": "13. Quiet V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "5 targets", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Quiet I, except may affect up to five targets." } },
      { "name": "14. Long Ear III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 point", "duration": "C", "range": "300'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Long Ear I, except range is 300'." } },
      { "name": "15. Deafen", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 target", "duration": "1 rnd/5% fail", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Target's ears begin ringing so loud that he can hear nothing for the duration." } },
      { "name": "16. Silence V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "50'R", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Quiet I, except affects a 50'R." } },
      { "name": "17. Long Voice V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 point", "duration": "C", "range": "500'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Long Voice I, except range is 500'." } },
      { "name": "18. Shatter Blast", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 object", "duration": "—", "range": "20'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Target object must make a resistance roll or break. Glass items resist at -25 and metal items resist at +25." } },
      { "name": "19. Long Ear V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 point", "duration": "C", "range": "500'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Long Ear I, except range is 500'." } },
      { "name": "20. Mute", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 target", "duration": "1 rnd/5% fail", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target is incapable of vocalizing any sound for 1 round per 5% failure." } },
      { "name": "25. Mass Soundwalls", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "varies", "duration": "10 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Soundwall V, except as many Soundwalls as the target's level can be created." } },
      { "name": "30. Silence True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "100'R", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Quiet I, except affects a 100'R." } },
      { "name": "50. Sound Mastery", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "caster", "duration": "1 rnd/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster may use any lower level spell on this list each round for the duration of this spell." } }
    ]
  }
}
