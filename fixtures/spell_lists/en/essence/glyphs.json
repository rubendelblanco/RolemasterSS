{
  "name": "Glyphs",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "essence",
    "profession": "Mana Molder",
    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Mana Molder Base List 14.5.6 - Glyphs. Spells for imbedding spells on air, water, or other in-flux mediums as triggered glyphs, and for deciphering, extending, or erasing them. Research Glyph is also the only way to learn the list's separate table of special researched glyphs (Light, Sleep, Stun, Fear, Death, etc., not modeled as individual spells here).",
    "spells": [
      { "name": "01. Research Glyph", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "varies", "duration": "8 hours", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to know the origins and parameters of a glyph. This is the only way for the caster to learn any special glyphs." } },
      { "name": "02. Glyph I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to 'trace' a glowing visible glyph on an in-flux medium that can be triggered by one of the following (decided by the caster at the time of casting): a) specified time has passed, b) specified movements within 20', c) specified sounds within 20', or d) touch. Power points for both spell and glyph must be expended, but only casting time for the glyph is used. A glyph can be a first level spell or a special glyph that has been researched." } },
      { "name": "03. Decipher Glyph", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 glyph", "duration": "1 rnd/lvl", "range": "self", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to decipher a glyph and know exactly what it does without setting it off (presuming it hasn't already been set off). It takes one round per level of the glyph to decipher it. Nothing is learned if this spell expires prior to completion of deciphering." } },
      { "name": "04. Glyph II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except a second level glyph can be traced." } },
      { "name": "05. Waiting Glyph II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "10'R", "duration": "1 day/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Extends the duration of a Glyph I or Glyph II." } },
      { "name": "06. Glyph III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except a 3rd level glyph can be traced." } },
      { "name": "07. Unglyph III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 glyph", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to erase a glyph of up to third level. This will not set off the glyph in question (unless the specified activation for the glyph were when the glyph is erased)." } },
      { "name": "08. Glyph IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except a fourth level glyph can be traced." } },
      { "name": "09. Waiting Glyph IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "10'R", "duration": "1 day/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waiting Glyph II, except it applies to glyphs up to fourth level." } },
      { "name": "10. Glyph V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except a fifth level glyph can be traced." } },
      { "name": "11. Multi-Glyph II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to place two spells into the same glyph. The glyph spell only needs to be cast once (but it must be cast within one minute of the completion of this spell)." } },
      { "name": "12. Glyph VI", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except a sixth level glyph can be traced." } },
      { "name": "13. Unglyph VI", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 glyph", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unglyph III, except that up to sixth level glyphs can be affected." } },
      { "name": "14. Glyph VII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except a seventh level glyph can be traced." } },
      { "name": "15. Waiting Glyph VII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "10'R", "duration": "1 day/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waiting Glyph II, except that up to a seventh level glyph has its duration extended." } },
      { "name": "16. Glyph VIII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except an eighth level glyph can be traced." } },
      { "name": "17. Multi-Glyph III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Multi-Glyph II, except that three spells may be placed in the same glyph." } },
      { "name": "18. Glyph IX", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except a ninth level glyph can be traced." } },
      { "name": "19. Glyph X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except a tenth level glyph can be traced." } },
      { "name": "20. Waiting Glyph X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "10'R", "duration": "1 day/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waiting Glyph II, except that up to a tenth level glyph can be delayed." } },
      { "name": "25. Unglyph X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 glyph", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unglyph III, except that up to tenth level glyphs can be affected." } },
      { "name": "30. Lord Glyph", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Glyph I, except that up to a twentieth level glyph can be traced." } },
      { "name": "50. Lord Unglyph", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 glyph", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unglyph III, except that up to twentieth level glyphs can be erased without discharging them." } }
    ]
  }
}
