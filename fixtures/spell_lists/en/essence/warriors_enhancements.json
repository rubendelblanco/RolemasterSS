{
  "name": "Warrior's Enhancements",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "essence",
    "profession": "Warrior Mage",
    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Warrior Mage Base 14.6.4 - Warrior's Enhancements. Personal enhancement spells granting heightened senses and the ability to survive and act in hostile environments (water, fire, vacuum, poison, extreme temperatures).",
    "spells": [
      { "name": "01. Battle Awareness I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 1, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster may make a Situational Awareness (Combat) maneuver with a special modification of +25. This maneuver is granted by this spell and requires no separate action to be declared." } },
      { "name": "02. Nightvision", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can see 100' on a normal night as if it were daylight." } },
      { "name": "03. Sidevision", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster has a 300 degree field of vision. The flank bonus for attacks against the caster is lowered to +5 and the rear bonus is lowered to +15." } },
      { "name": "04. Watervision", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nightvision, except the caster can see 100' in even murky water." } },
      { "name": "05. Battle Awareness II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 5, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Battle Awareness I, except bonus to the maneuver is +50." } },
      { "name": "06. Waterlungs", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can breathe water but not air." } },
      { "name": "07. Water Warrior", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target can swim without expending energy (i.e., will expend no exhaustion points)." } },
      { "name": "08. Gasvision", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nightvision, except the caster can see 100' in smoke, fog, rain, or any gas that would normally impede vision." } },
      { "name": "09. Gaslungs", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waterlungs, except the caster can breathe any gas as normal air." } },
      { "name": "10. Darkvision", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Nightvision, except that any darkness can be seen through. Also, no light is needed for this spell to work." } },
      { "name": "11. Resist Poison", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "caster", "duration": "1 hour/lvl", "range": "self", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Delays the effect of a poison on the caster. If poison is not eliminated before the spell expires, the caster will be affected by the poison at that time." } },
      { "name": "12. Water Maneuvering", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Swimming, except the caster can also perform any maneuvers (including melee combat) as though he were on dry land." } },
      { "name": "13. Changing Lungs", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Waterlungs, except caster can breathe water, air, and/or any gas at will." } },
      { "name": "14. Ignore Pressure", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can ignore the effects of high pressures such as those found deep under water." } },
      { "name": "15. Fire Maneuvering", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster and his equipment are immune to the effects of normal (non-magical) fire for the duration. He may perform any movement or maneuvers as normal." } },
      { "name": "17. Water Dwelling", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Combines the effects of Watervision, Waterlungs, and Water Maneuvering." } },
      { "name": "18. Airless Lungs", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster does not need to breathe to survive for the duration." } },
      { "name": "19. Fire Dwelling", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Combines the effects of Gasvision, Gaslungs, and Fire Maneuvering." } },
      { "name": "20. Ignore Vacuum", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster and his equipment are immune to the effects of airless environments for the duration. This spell gives the caster a +50 RR versus vacuum attacks. Note that this spell does not confer any protection against the heat or cold of the vacuum of space." } },
      { "name": "25. Temperature Resistance", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster and his equipment can ignore the effects of any natural (non-magical) temperatures." } },
      { "name": "30. Water Dwelling True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "caster", "duration": "1 hr/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Water Dwelling except for duration." } },
      { "name": "50. Changing Environment", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can survive comfortably and move and maneuver as normal in any of the hostile environments the lower level spells on this list protect against." } }
    ]
  }
}
