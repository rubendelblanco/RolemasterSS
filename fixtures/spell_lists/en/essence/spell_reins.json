    "description": "Closed Essence 3.9 - Spell Reins. Spells for storing spells, identifying casting, Spell Hold, Spell Bending, Reverse Spell, Power Loan, and true versions.",
    "spells": [
      {
        "name": "01. Spell Store",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 spell",
          "duration": "varies",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster may cast this spell with any spell he wants to store. The spell to be stored must be cast within one minute after the Spell Store is cast. The stored spell may then be cast later as an instantaneous spell. The Spell Store costs the same number of PPs as the spell that is stored. No other spell may be cast while a spell is stored."
        }
      },
      {
        "name": "02. Identify Casting",
