    },
    "description": "Evil Essence 10.4 - Entity Summons. Spells to summon elementals and demons and to control, master, order, and contain entities. Entities include Demons and other extra-planar creatures appropriate to the GM's world (including elementals). See Section 15.22 (p. 100). See Section 15.24 (p. 101) for evil spell lists.",
    "spells": [
      {
        "name": "02. Summon Elemental I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "1 elemental",
          "duration": "2 rnds",
          "range": "100'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster summons an Elemental Servant (a Type I Entity) that gradually appears over the course of two rounds. If it is not \"controlled\" or \"Mastered\" (usually by one of the spells on this list), it will attack random targets until it fades away after 2-20 rounds."
        }
      },
      {
        "name": "03. Control Entity I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "1 entity",
          "duration": "C",
          "range": "10'/lvl",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows the caster to totally control a Type I Entity (the chance of non-control is [the Entity's Type x 2%]). The Entity leaves when the caster stops concentrating. The Entity will not speak with the summoner."
        }
      },
      {
        "name": "04. Summon Elemental II",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 4,
          "area_of_effect": "1 elemental",
          "duration": "2 rnds",
          "range": "100'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "As Summon Elemental I, except the caster summons a Weak Elemental (a Type II entity)."
        }
      },
      {
        "name": "05. Lesser Demonic Gate",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 5,
          "area_of_effect": "1 Demon",
          "duration": "2 rnds",
          "range": "10'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster summons a Demon who gradually appears over the course of 2 rounds. Roll d100 (not open-ended) for Type. A result of 01-60 is a Type I; a result of 61-90 is a Type II; a result of 91-100 is a Type III. If the Demon is not \"Controlled\" or \"Mastered\" (i.e., usually by one of the spells on this list) before the Demon materializes, the caster suffers an effect as outlined in Section 15.22 (p. 100)."
        }
      },
      {
        "name": "06. Entity Mastery I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 6,
          "area_of_effect": "1 entity",
          "duration": "varies",
          "range": "10'/lvl",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "As Control Entity I, except the caster need not concentrate to control the Entity. The chance of failure is 5 times the Entity's Type. The Entity will remain and obey the caster until the caster is killed or the Entity is outside the range limit or the caster releases him. A maximum of two Entities can be mastered at one time by one being. Obtaining information may only be accomplished by using spells off the Evil Magician's Base list, Dark Contacts."
        }
      },
      {
