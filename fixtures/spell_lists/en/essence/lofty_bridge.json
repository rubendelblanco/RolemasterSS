    "description": "Closed Essence 3.5 - Lofty Bridge. Spells for movement: Leaping, Landing, Levitation, Fly, Leaving, Long Door, Teleport, Portal, and mass versions.",
    "spells": [
      {
        "name": "01. Leaping",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 target",
          "duration": "1 rnd",
          "range": "100'",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows the target to leap 50' laterally or 20' vertically in the round that the spell is cast."
        }
      },
      {
        "name": "02. Landing",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "1 target",
          "duration": "varies",
          "range": "100'",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows the target to land safely after a fall up to 20' per level of the caster. In addition, the target may take that distance off the severity of any longer fall."
        }
      },
      {
        "name": "03. Leaving I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "1 target",
          "duration": "—",
          "range": "10'",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Caster teleports the target to a point up to 100' away. There can be no intervening \"barriers\" in a direct line between the target and the point. A \"barrier\" is defined as anything the target could not physically go through (e.g., a closed door is a barrier, a pit is not)."
        }
      },
      {
        "name": "04. Levitation",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 4,
          "area_of_effect": "1 target",
          "duration": "1 min/lvl",
          "range": "10'",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Allows target to move up and down vertically at a rate of 10' per round. The spell does not confer any ability to control horizontal movement."
        }
      },
      {
        "name": "05. Fly I",
        "img": "systems/rmss/assets/default/spell.svg",
