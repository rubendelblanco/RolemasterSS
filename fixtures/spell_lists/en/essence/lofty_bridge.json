          "duration": "1 min/lvl",
          "range": "10'",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Target can fly at a rate of 75' per round (approximately 5 mph). While Fly is active, normal movement (e.g., walking, running, etc.) is not allowed."
        }
      },
      {
