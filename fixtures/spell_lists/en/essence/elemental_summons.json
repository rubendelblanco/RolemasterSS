    "description": "Closed Essence 14.3.4 - Elemental Summons. Spells to repel, control, banish, and summon Elemental Servants, Weak, Strong, and Guardian elementals, and communicate with elementals.",
    "spells": [
      { "name": "02. Repel Elemental Servant", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "The target Elemental Servant must make a RR each round. If it fails this RR, it will attempt to move away from the caster." } },
      { "name": "03. Control Elemental Servant", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 3, "area_of_effect": "1 target", "duration": "C", "range": "10'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster total control of an Elemental Servant. When caster stops concentrating the Servant will either return to its normal plane of existence or attack the summoner (equal chance of either)." } },
      { "name": "04. Banish Elemental Servant", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 target", "duration": "—", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Banishes an Elemental Servant to its normal plane of existence. The Servant does get a RR to avoid this." } },
      { "name": "05. Summon Elemental Servant", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "varies", "range": "10'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to summon an Elemental Servant. The caster must be in range of necessary materials for the elemental type he is attempting to summon (campfire for Fire Servant, ice for Cold Servant, etc.). The Elemental will gradually manifest itself over the course of 2 rounds." } },
      { "name": "06. Master Elemental Servant", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 6, "area_of_effect": "1 target", "duration": "—", "range": "5'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Control Elemental Servant, except caster need not concentrate to control elemental. The elemental will remain and obey the caster until the caster is killed, the elemental is outside the range limit, or the elemental is killed. If the elemental is ever freed from this bond, it will either return to its normal plane of existence or attack the summoner (equal chance of either). A maximum of three Elemental Servants can be mastered by any one being at one time." } },
      { "name": "07. Repel Weak Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Elemental Servant, except it repels Weak Elementals." } },
      { "name": "08. Control Weak Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 8, "area_of_effect": "1 target", "duration": "C", "range": "10'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Control Elemental Servant, except affects Weak Elementals." } },
      { "name": "09. Banish Weak Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 target", "duration": "—", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Banish Elemental Servant, except affects Weak Elementals." } },
      { "name": "10. Summon Weak Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 target", "duration": "varies", "range": "10'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Summon Elemental Servant, except affects Weak Elementals." } },
      { "name": "11. Elemental Communication", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "For the duration, the caster can communicate freely with the target Elemental. This spell allows no control of the Elemental and does not automatically make it friendly toward the caster." } },
      { "name": "12. Master Weak Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 12, "area_of_effect": "1 target", "duration": "—", "range": "5'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Master Elemental Servant, except affects Weak Elementals." } },
      { "name": "14. Repel Strong Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Repel Elemental Servant, except it repels Strong Elementals." } },
      { "name": "15. Control Strong Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 15, "area_of_effect": "1 target", "duration": "C", "range": "10'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Control Elemental Servant, except affects Strong Elementals." } },
      { "name": "16. Banish Strong Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 target", "duration": "—", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Banish Elemental Servant, except affects Strong Elementals." } },
      { "name": "18. Elemental Communication True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "50'R", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Elemental Communication, except caster may communicate with all Elementals of one type within 50' radius." } },
      { "name": "20. Summon Strong Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 target", "duration": "varies", "range": "10'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Summon Elemental Servant, except affects Strong Elementals." } },
      { "name": "25. Master Strong Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 25, "area_of_effect": "1 target", "duration": "—", "range": "5'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Master Elemental Servant, except affects Strong Elementals." } },
      { "name": "30. Control Elemental Guardian", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 target", "duration": "C", "range": "10'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Control Elemental Servant, except affects Elemental Guardians." } },
      { "name": "50. Summon Elemental Guardian", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 target", "duration": "varies", "range": "10'/lvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Summon Elemental Servant, except affects Elemental Guardians." } }
