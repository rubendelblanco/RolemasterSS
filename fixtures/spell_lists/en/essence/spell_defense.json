    "profession": "Warrior Mage",
    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Warrior Mage Base 14.6.3 - Spell Defense. Detection and protection spells that let the caster sense active magic of every realm and shield himself and allies from it.",
    "spells": [
      { "name": "01. Detect Essence", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Detects any active spell or item from the Essence realm. Caster can concentrate on a 5'R area each round." } },
      { "name": "02. Protection I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Subtracts 5 from elemental attack rolls against the target and adds 5 to all of the target's RRs versus spells." } },
      { "name": "03. Detect Mentalism", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Essence, except realm is Mentalism." } },
      { "name": "04. Essence Protection", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 spell", "duration": "varies", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "When the caster of this spell is a target of a spell from the realm of Essence, the 'incoming' spell must first make an RR before the caster makes an RR. For RR purposes, each spell uses a level equal to its caster's level. If the 'incoming' spell passes the RR, it may target the caster of this spell normally; otherwise the incoming spell has no effect on this target. Essence Protection remains in effect until its caster has been the target of any 1 Essence spell." } },
      { "name": "05. Detect Channeling", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Essence, except realm is Channeling." } },
      { "name": "06. Mentalism Protection", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 spell", "duration": "varies", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Essence Protection, except affects spells from the realm of Mentalism." } },
      { "name": "07. Detect Invisible", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Essence, except detects invisible things. All attacks against something so detected are modified by -50." } },
      { "name": "08. Channeling Protection", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 spell", "duration": "varies", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Essence Protection, except affects spells from the realm of Channeling." } },
      { "name": "09. Protection Sphere II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection I, except bonuses are 10 and all beings within 10'R of target get the benefits." } },
      { "name": "10. Spell Detection I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster becomes aware an instant before anyone within 10' casts a spell. This should allow enough time to cast any instantaneous spell." } },
      { "name": "11. Elemental Parry", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "caster", "duration": "1 rnd", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can use up to half of his normal OB with the weapon he has in his hands to parry an elemental bolt spell." } },
      { "name": "12. Detect Intangible", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Invisible, except also detects things that are Astral, Ethereal, out of phase, etc." } },
      { "name": "13. Protection III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection I, except bonuses are 15." } },
      { "name": "14. Detect Power", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "5'R", "duration": "1 min/lvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Detect Essence, except detects active spells, magic items, or spell users of any realm." } },
      { "name": "15. Protection Sphere III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection III, except has a 10'R as in Protection Sphere II." } },
      { "name": "16. Spell Detection II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "20'R", "duration": "1 min/lvl", "range": "self", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Spell Detection I, except it detects spells cast within a 20'R and the caster learns who is casting the spell." } },
      { "name": "17. Protection IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection I, except bonuses are 20." } },
      { "name": "18. Spell Parry", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "caster", "duration": "1 rnd", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can add up to half of his normal OB (with the weapon he has in his hands) to his RR versus any spell that targets him and of which he is aware." } },
      { "name": "19. Realm Protection Sphere", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "10'R", "duration": "varies", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Essence Protection, except that spells of any realm are affected and it has a 10'R." } },
      { "name": "20. Protection Sphere IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "10'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Protection IV, except has a 10'R as in Protection Sphere II." } },
      { "name": "25. Spell Detection III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "30'R", "duration": "1 min/lvl", "range": "self", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Spell Detection II, except it detects spells cast within a 30'R and the caster learns what realm they are casting." } },
      { "name": "30. Spell Detection IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "50'R", "duration": "1 min/lvl", "range": "self", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "As Spell Detection III, except it detects spells cast within 50'R and the caster learns the exact spell they are casting." } },
      { "name": "50. Spell Bane", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "caster", "duration": "1 rnd/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster may utilize any one of the lower level spells on this list each round." } }
    ]
  }
}
