    "description": "Dabbler Base 6.2 - Influences. Spells to put targets to sleep, charm animals and humanoids, suggest or compel a course of action, hold a target immobile, read surface thoughts, and bind a target to a quest, culminating in Quest True.",
    "spells": [
      { "name": "01. Sleep III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "varies", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Causes target(s) to fall into a natural sleep. This spell can affect a number of targets whose levels total up to 3. The caster must be able to see all targets. At the time of casting, the caster should designate target priority (e.g., affect 1st target; if levels are left, affect 2nd target; etc.). The first 2 rounds of sleep is magical (the target cannot be awakened through normal means)." } },
      { "name": "02. Charm Animals", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 animal/lvl", "duration": "1 hour", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target animal(s) will believe the caster is a good friend." } },
      { "name": "03. Charm Kind", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 target", "duration": "1 hr/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target humanoid believes the caster is a good friend." } },
      { "name": "04. Sleep V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "varies", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Sleep III, except affects a total of 5 levels." } },
      { "name": "05. Suggestion", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "varies", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target will follow a single suggested act that is not completely alien to him (e.g., no suicide suggestions, no blinding himself suggestions, etc.)." } },
      { "name": "06. Telepathy I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 target", "duration": "1 rnd/lvl(C)", "range": "2'/lvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Caster receives surface thoughts from target. If target makes his RR by more than 25 he realizes that someone is trying to read his thoughts." } },
      { "name": "07. Sleep VII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "varies", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Sleep III, except affects a total of 7 levels." } },
      { "name": "08. Hold Kind", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 target", "duration": "C", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target humanoid is held to 25% activity." } },
      { "name": "09. Greater Charm Kind", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 target/5 lvl", "duration": "1 hr/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Charm Kind, except will affect one target for every five levels (or fraction thereof) of the caster." } },
      { "name": "10. Sleep X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "varies", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Sleep III, except affects a total of 10 levels." } },
      { "name": "11. Greater Suggestion", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 target/5 lvl", "duration": "1 hr/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Suggestion, except will affect one target for every five levels (or fraction thereof) of the caster." } },
      { "name": "12. Master of Kind", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target humanoid must obey caster. However, he will not perform any act that is completely alien to him (e.g., no suicide orders, no blinding orders, etc.)." } },
      { "name": "13. Sleep XII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "varies", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Sleep III, except affects a total of 12 levels." } },
      { "name": "14. Greater Hold Kind", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 target/5 lvl", "duration": "C", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Hold Kind, except will affect one target for every five levels (or fraction thereof) of the caster." } },
      { "name": "15. Telepathy II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 target", "duration": "1 rnd/lvl(C)", "range": "5'/lvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Telepathy I, except for range." } },
      { "name": "16. Sleep XV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "varies", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Sleep III, except affects a total of 15 levels." } },
      { "name": "18. Greater Master of Kind", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 target/5 lvl", "duration": "10 min/lvl", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Master of Kind, except will affect one target for every five levels (or fraction thereof) of the caster." } },
      { "name": "19. Quest", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 target", "duration": "varies", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target is given one task. Failure results in a penalty determined by the GM (task must be within the capabilities of the target). If the target ignores the quest, he will suffer the same effects as for failure." } },
      { "name": "20. Lord Sleep", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "varies", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Sleep III, except affects a total of 20 levels." } },
      { "name": "25. Sleep True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "varies", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Sleep III, except affects a total number of levels equal to the caster's level." } },
      { "name": "30. Telepathy True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 target", "duration": "1 rnd/lvl(C)", "range": "10'/lvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Telepathy I, except for range." } },
      { "name": "50. Quest True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 target", "duration": "varies", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Quest, except failure is punished by the target suffering five 'E' criticals (choose which critical types randomly)." } }
    ]
