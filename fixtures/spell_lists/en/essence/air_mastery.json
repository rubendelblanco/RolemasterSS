    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Open Essence 14.2.1 - Air Mastery. Spells to purify and control air, resist choking and turbulence, whisper and track by scent, fly, and assume a gaseous form.",
    "spells": [
      { "name": "01. Zephyr", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 1, "area_of_effect": "target", "duration": "1 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can run at one better pace category than normally allowed for his armor and encumbrance. For example, an unarmored man could move at his base rate x6 (expending 75 exhaustion points per round) instead of x5. If the caster stops running, the spell ends. The spell does not give the caster any modifier to the maneuver difficulty nor does it give exhaustion bonuses." } },
      { "name": "02. Long Breath I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster does not have to breathe for the duration of this spell." } },
      { "name": "03. Long Whisper I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 point", "duration": "C", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can whisper and the whisper can be heard at any point he chooses within the range." } },
      { "name": "04. Tracking", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "caster", "duration": "varies", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster is able to track by sense of smell. This spell gives the caster a +25 to his Tracking skill or +25 to his Observation skill where a sense of smell could help him track (i.e., not underwater)." } },
      { "name": "05. Minor Turbulence", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "varies", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "This spell sets up random wind currents and eddies around a target for one round per 10% failure. The target is at -25 to all moving maneuvers and combat for the duration. Anyone attempting to attack the target suffers a penalty of -5 to their OB." } },
      { "name": "06. Purify Air", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 cu/rnd", "duration": "P", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "The caster can convert any gas to normal, breathable air at a rate of 1 cubic foot/round." } },
      { "name": "07. Fly I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "caster", "duration": "C", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can fly at a rate of 75' per round. While Fly is active, normal movement (e.g., walking, running) is not allowed." } },
      { "name": "08. Choke", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 target", "duration": "C", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "If the target fails his RR he takes damage equal to 10% of his remaining hits each round that the caster concentrates." } },
      { "name": "09. Cross Winds I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "10'R", "duration": "1 rnd/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster causes all missile attacks to be blown off course, giving them a -100 attack modification." } },
      { "name": "10. Concealing Mist", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "100'R", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates a dense mist in a 100' radius; normal visibility is 10'." } },
      { "name": "11. Favorable Winds", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 11, "area_of_effect": "1 missile", "duration": "—", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster reduces all range penalties for one missile attack by 50 (to a maximum of +0)." } },
      { "name": "12. Air Form", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "caster", "duration": "1 rnd/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "The caster's body and gear assumes a gaseous state. The caster may not make or be the target of physical attacks nor perform any action requiring physical manipulation (picking locks, opening doors, lifting, moving objects). The caster is especially vulnerable to wind magic. For the duration of this spell, the caster can move through small openings, pass through bars, and ignore physical attacks. The caster may cast spells normally while in this state, but any elemental spell (E) the caster attempts automatically fails." } },
      { "name": "13. Major Turbulence", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 target", "duration": "varies", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Minor Turbulence, except maneuver penalty is -50 and attack penalty is -10." } },
      { "name": "14. Long Breath II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Long Breath I, except for duration." } },
      { "name": "15. Long Whisper V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 point", "duration": "C", "range": "500'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Long Whisper I, except for range." } },
      { "name": "16. Fly II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fly I, except rate is 150' per round." } },
      { "name": "17. Cross Winds II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "30'R", "duration": "1 rnd/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Cross Winds I, except for area of effect." } },
      { "name": "18. Whirlwind", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "A 10' radius whirlwind is created. This whirlwind delivers an 'A' Impact critical to all inside (every round). All movement through or within the whirlwind is reduced by 80%. The caster can move the whirlwind 1' per round." } },
      { "name": "20. Fly III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fly I, except rate is 300'." } },
      { "name": "25. Turbulence True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "caster", "duration": "10 min/lvl", "range": "self", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Minor Turbulence, except the maneuver modifier is -100 and the attack penalty is -20." } },
      { "name": "30. Fly True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "caster", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Fly I, except rate is 450'." } },
      { "name": "50. Air Mastery", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "caster", "duration": "1 rnd/lvl", "range": "varies", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can use any one lower level spell on this list each round." } }
    ]
  }
}
