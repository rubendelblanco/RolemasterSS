    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Closed Essence 14.3.7 - Light Mastery. Spells to create light, auras, and flares, blind and stun with bursts of light, and project a beacon visible for miles.",
    "spells": [
      { "name": "01. Flare", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 1, "area_of_effect": "10'R", "duration": "1 rnd/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster launches a flare of light that rapidly flies to a target area within range, where it slowly drifts to the ground. For the duration of the spell, the flare illuminates a 10'R area. If fired at a target, it will do no damage and simply fade away." } },
      { "name": "02. Projected Light", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "50' beam", "duration": "10 min/lvl", "range": "self", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "A beam of light springs from the caster's palm. This light has a 50' effective range. If the caster closes his fist, the light will 'turn off;' when the fist is opened, the light will come back on (so long as the duration has not expired)." } },
      { "name": "03. Glare Vision", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Target is immune to bright light, sun glare, and snow blindness. Target also receives a special bonus of +25 versus all blinding attacks." } },
      { "name": "04. Dancing Lights", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1'R sphere", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates 1 ball of iridescent light per caster's level, which can be made to 'dance' anywhere within the spell's range. These lights cannot harm, and give off light equal to that of a torch. Everyone within sight of the lights (except the caster) must make a RR versus a first level attack (as per a Fear RR) or be transfixed for one round per 10% failure." } },
      { "name": "05. Light I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "10'R", "duration": "10 min/lvl", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Lights a 10' radius area about the point touched. If the point is on a mobile object or being, it will move with the object or being. See Spell Law Section 7.1.17." } },
      { "name": "06. Pyrotechnics", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1cu'/lvl", "duration": "1 rnd/lvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates a multi-colored display of exploding lights." } },
      { "name": "07. Aura I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates a bright aura about the target, making him appear more powerful and subtracting 5 from all attacks against him." } },
      { "name": "08. Sudden Light I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "10'R", "duration": "varies", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes a 10' radius burst of intense light; all those inside are stunned for 1 round per 10% failure." } },
      { "name": "09. Light V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "50'R", "duration": "10 min/lvl", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Light I, except has a 50' radius." } },
      { "name": "10. Photonic Orb", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 target", "duration": "varies", "range": "50'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster creates and releases a sparkling ball of translucent, swirling color which strikes the target, resulting in one round of blindness per 10% failure." } },
      { "name": "11. Hue", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1000 cu'", "duration": "10 min/lvl", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes any object up to 1000 cubic feet to glow any desired color." } },
      { "name": "12. Aura II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Aura, except subtracts 10 from all attacks." } },
      { "name": "13. Sudden Light II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "20'R", "duration": "varies", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Sudden Light I, except has a 20' radius." } },
      { "name": "14. Light X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "100'R", "duration": "10 min/lvl", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Light I, except has a 100' radius." } },
      { "name": "15. Waiting Light", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "varies", "duration": "varies", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "This spell is cast in conjunction with any Light spell (i.e. the Light spell must be cast within 1 minute of casting this spell). It can delay the activation of that spell for up to 24 hours. It can be triggered by one of the following (decided by the caster at the time of casting): time period, specific movements, specific sounds, touch, violent action in the area, etc." } },
      { "name": "16. Beacon V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "5 miles", "duration": "1 min/lvl", "range": "self", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "A ray of light (any color) springs from caster's palm. This ray can be up to 5 miles long." } },
      { "name": "17. Aura III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Aura, except subtracts 15 from all attacks." } },
      { "name": "18. Light XX", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "200'R", "duration": "10 min/lvl", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Light I, except has a 200' radius." } },
      { "name": "19. Sudden Light True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "50'R", "duration": "1 rnd/5% fail", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Sudden Light I, except has a 50' radius." } },
      { "name": "20. Utterlight", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "100'R", "duration": "1 min/lvl", "range": "touch", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Light I, except has a 100' radius." } },
      { "name": "25. Beacon X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "10 miles", "duration": "1 min/lvl", "range": "self", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Beacon V, except ray can be up to 10 miles long." } },
      { "name": "30. Light True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "10'R/lvl", "duration": "1 min/lvl", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Light I, except for area of effect." } },
      { "name": "50. Light Mastery", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "caster", "duration": "1 rnd/lvl", "range": "varies", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster may use any lower level spell on this list each round for the duration of this spell." } }
    ]
  }
}
