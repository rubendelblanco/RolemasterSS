{
  "name": "Earth Law",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "essence",
    "profession": "Magician",
    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Magician Base 5.1 - Earth Law. Spells to build, repair, and curve walls of earth and stone, extend cracks, conjure a field of earthen spikes, transmute earth/stone/mud between each other, disintegrate earth/stone/metal, and shake the ground with tremors, culminating in Earth Mastery. Special Notes: All walls created by spells on this list must rest on a solid surface. See Section 15.7 (p. 97) for more on walls.",
    "spells": [
      { "name": "01. Enchanted Rope", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "10'/lvl", "duration": "C", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "If caster holds one end of a rope he can cause the rope to move up to its length (within the area of effect) in any direction and to tie itself in knots (it cannot attack or tie up a living being)." } },
      { "name": "02. Loosen Earth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Loosens 100 cubic feet of earth to the consistency of plowed ground." } },
      { "name": "04. Earthwall", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "10'x10'x3'", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Creates a wall of earth up to 10' x 10' x (3' at the base, 1' at the top). This wall can be dug through." } },
      { "name": "05. Cracks Call", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "10'x10'x10'", "duration": "—", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Any previous cracks or flaws in material up to 10'x10'x10' section will extend to their limit." } },
      { "name": "06. Repair", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 object", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "The caster may mend a single break in a small (up to 2 pounds) inorganic object or multiple breaks, rips, or cracks in a larger (up to 10 pounds) organic object. All component parts of the object must be within a 10' radius." } },
      { "name": "07. Stonewall", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "10'x10'x1'", "duration": "1 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Earthwall, except wall is up to 10'x10'x1' of stone. It can be chipped through." } },
      { "name": "08. Earthen Spikes", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "20' x 20'", "duration": "10 min/lvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "This spell causes the area of effect to bristle with hundreds of 6\" to 12\" sharp edges and blades. The exact composition of these spikes will depend on the material the ground is made of. The area of effect must be placed horizontally on a surface (i.e., it cannot be placed on walls). Most animals and creatures cannot be induced to walk through the area. Anyone moving through the area must make a maneuver roll (at least Extremely Hard difficulty) for every 5' moved through. Anyone who falls inside the area of effect receives an 'A' Puncture critical strike." } },
      { "name": "09. Stone/Earth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Changes 100 cubic feet of stone to packed earth. This change is gradual (taking three rounds for complete change)." } },
      { "name": "10. Earthwall True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "10'x10'x3'", "duration": "P", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Earthwall, except duration is permanent." } },
      { "name": "11. Earth/Mud", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Stone/Earth, except changes earth to soft mud." } },
      { "name": "12. Earth/Stone", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Stone/Earth, except changes packed earth to solid stone and loose earth to gravel." } },
      { "name": "13. Stonewall True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "10'x10'x1'", "duration": "P", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Stonewall, except duration is permanent." } },
      { "name": "14. Mud/Earth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Stone/Earth, except changes mud to packed earth." } },
      { "name": "15. Unearth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Disintegrates (i.e., nothing is left) 100 cubic feet of earth." } },
      { "name": "16. Meld Wall", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "varies", "duration": "P", "range": "touch", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Fuses two touching walls together (seam can be up to 20' long) or fuses a section of stone blocks (up to 100 cubic feet)." } },
      { "name": "17. Stone/Mud", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Stone/Earth, except changes stone to mud." } },
      { "name": "18. Curved Wall", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "10'x10'x1'", "duration": "P", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "As Stonewall True, except wall may be curved up to a semicircle." } },
      { "name": "20. Unstone", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "100 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unearth, except affects stone." } },
      { "name": "25. Unmetal", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 cu'", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "As Unearth, except affects 1 cubic foot of metal." } },
      { "name": "30. Tremors", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "varies", "duration": "1 rnd", "range": "100'/lvl", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes a very minor earthquake which could cause shoddy construction to collapse (this can be very terrifying). This is approximately 5.5 on the Richter scale." } },
      { "name": "50. Earth Mastery", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "varies", "duration": "1 rnd/lvl", "range": "varies", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Caster can use one lower level spell (on this list) each round." } }
    ]
  }
}
