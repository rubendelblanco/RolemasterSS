    "description": "Essence Training Package Spell List 14.1.9 - Mending Ways. Spells to mend broken string, cloth, wood, metal, stone, and crystal items, mundane or magical, restoring their physical integrity but not any lost enchantment.",
    "spells": [
      { "name": "01. Mend String", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 string", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Mends multiple rips in a piece of string/twine up to 0.25\" diameter. All bits must be collected together (i.e. within a 10' radius). The string is returned to its pre-ripped state. If pieces are missing or destroyed (i.e., burned to ash) the string can still be repaired but it will be structurally weaker and more susceptible to unraveling. Caster may mend up to 5 feet of string." } },
      { "name": "02. Mend Parchment", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 sheet", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends parchment, paper, vellum, etc. Caster may mend 5 square foot of paper." } },
      { "name": "03. Mend Rope", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 rope", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends rope. Caster may mend up to 15 feet of rope." } },
      { "name": "04. Mend Cloth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends cloth. Caster may mend 5 square foot of cloth." } },
      { "name": "05. Mend Leather", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends leather, hide, skin, etc. Caster may mend 5 square foot of leather." } },
      { "name": "06. Mend Wood", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends multiple breaks in non-magical wood. This can be used to repair cracks or to reassemble broken pieces. Caster may mend 5 cubic foot of wood." } },
      { "name": "07. Mend Earth & Ceramics", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends earth, ceramics, etc. Caster may mend 5 cubic foot of ceramics." } },
      { "name": "08. Mend Horn/Bone/Antler", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends hard animal substances such as bone, horn, or antler. Caster may mend 1 bone up to 2 cubic foot." } },
      { "name": "09. Mend Base Metal", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends iron, tin, lead, etc. Caster may mend up to 5 cubic foot." } },
      { "name": "10. Mend Common Stone", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends ordinary stone and glass. Caster may mend up to 5 cubic foot." } },
      { "name": "11. Mend Precious Metal", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends platinum, gold, silver, etc. Caster may mend up to 1 cubic foot." } },
      { "name": "12. Mend Processed Metal", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends alloys, steel, and other hard, processed metals. Weapons and armor mended by use of this spell are returned to normal strength, so long as every fragment of the original was available for the mending process. Otherwise, the GM should determine a reduced strength for the item. Caster may mend up to 1 cubic foot." } },
      { "name": "13. Mend Semi-Precious Stone", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends semi-precious stone." } },
      { "name": "14. Mend Magic Parchment", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend Parchment, except mends magical parchment, etc." } },
      { "name": "15. Mend Magic Cloth/Rope", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend Cloth, except mends magic cloth or rope." } },
      { "name": "16. Mend Magic Leather", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend Leather, except mends magic leather." } },
      { "name": "17. Mend Magic Wood", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend Wood, except mends magic wood." } },
      { "name": "18. Mend Magic Horn", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend Horn, except mends magic horn." } },
      { "name": "19. Mend Magic Earth", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend Earth, except mends magic earth or ceramics." } },
      { "name": "20. Mend Magic Stone", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend Stone, except mends magic stone or glass." } },
      { "name": "25. Mend Magic Metals", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend Metals, except mends magic metals." } },
      { "name": "30. Mending True", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 item", "duration": "P", "range": "touch", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "As Mend String, except mends all facets of any one item regardless of the item's composition. Total mass may not exceed 30 cubic foot. All bits must be within 50'R." } },
      { "name": "50. Mending Mastery", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "caster", "duration": "10 minutes", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Allows caster to use any of the lower level spells on this list each round for the duration of this spell." } }
    ]
  }
}
