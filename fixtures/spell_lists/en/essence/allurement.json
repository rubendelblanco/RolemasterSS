    "description": "Open Essence 14.2.2 - Allurement. Spells to charm people, animals, and plants, seduce, suggest, and bind a target with a geas.",
    "spells": [
      { "name": "01. Empathy I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "self", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "For the duration, the caster gains a +5 bonus to all skills in the Influence skill category (and any other skill that deals with interaction with people)." } },
      { "name": "02. Charm Opposite I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "One humanoid target of the opposite sex believes the caster is a good friend. The target's RR can be modified by racial prejudices." } },
      { "name": "03. Self Aura", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "self", "duration": "1 min/lvl", "range": "self", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Causes a bright aura about the caster, making him appear more powerful and subtracting 10 from all attacks." } },
      { "name": "04. Charm Plant I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Charm Opposite I, but one sentient plant is affected." } },
      { "name": "05. Seduction", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 target", "duration": "varies", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Caster emotionally and/or sensually manipulates one humanoid target (emotional attachment may result). Caster receives a bonus to his Seduction maneuvers against this target equal to the amount the target failed his RR. For example, if a target fails a RR by 15, the caster gets +15 to all Seduction maneuvers for the duration of the spell." } },
      { "name": "06. Charm Opposite II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "2 targets", "duration": "10 min/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Charm Opposite I, except up to two targets may be affected." } },
      { "name": "07. Charm Animal I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Charm Opposite I, except one creature with animal intelligence is affected." } },
      { "name": "08. Suggestion I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 target", "duration": "varies", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Target will follow a single suggested act that is not completely alien (e.g. suicide, blinding himself, etc.). This spell expires when the target completes the action." } },
      { "name": "09. Charm Same I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 target", "duration": "10 min/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Charm Opposite I, except a member of the same sex is affected." } },
      { "name": "10. Charm Opposite III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "3 targets", "duration": "10 min/lvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "As Charm Opposite I, except up to 3 targets may be affected." } },
