    "description": "Esencia Abierta 2.9 - Muro de Hechizos. Hechizos de protección contra ataques elementales, cancelar y disipar hechizos por reino, escudos (Esencia, Mente, Canalización, Hechizo) y resistencia a reinos de hechizos.",
    "spells": [
      {
        "name": "01. Protección I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 objetivo",
          "duration": "1 min/nvl",
          "range": "10'",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Resta 5 a las tiradas de ataque elemental contra el objetivo y añade 5 a todas las TR del objetivo contra hechizos."
        }
      },
      {
        "name": "02. Cancelar Esencia",
