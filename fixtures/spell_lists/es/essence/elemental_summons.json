    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Esencia Cerrada 14.3.4 - Invocación Elemental. Hechizos para repeler, controlar, desterrar e invocar Sirvientes Elementales, elementales Débiles, Fuertes y Guardianes, y comunicarse con elementales.",
    "spells": [
      { "name": "02. Repeler Sirviente Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "El Sirviente Elemental objetivo debe hacer una TR cada asalto. Si falla, intentará alejarse del lanzador." } },
      { "name": "03. Controlar Sirviente Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 3, "area_of_effect": "1 objetivo", "duration": "C", "range": "10'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador el control total de un Sirviente Elemental. Cuando el lanzador deja de concentrarse, el Sirviente regresará a su plano de existencia normal o atacará al invocador (igual probabilidad de cualquiera de los dos)." } },
      { "name": "04. Desterrar Sirviente Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 objetivo", "duration": "—", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Destierra a un Sirviente Elemental a su plano de existencia normal. El Sirviente obtiene una TR para evitarlo." } },
      { "name": "05. Invocar Sirviente Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador invocar a un Sirviente Elemental. El lanzador debe estar en alcance de los materiales necesarios para el tipo de elemental que intenta invocar (una hoguera para un Sirviente de Fuego, hielo para uno de Frío, etc.). El elemental se manifestará gradualmente a lo largo de 2 asaltos." } },
      { "name": "06. Dominar Sirviente Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 6, "area_of_effect": "1 objetivo", "duration": "—", "range": "5'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Controlar Sirviente Elemental, salvo que el lanzador no necesita concentrarse para controlar al elemental. El elemental permanecerá y obedecerá al lanzador hasta que este muera, el elemental salga del alcance, o el elemental sea destruido. Si el elemental se libera alguna vez de este vínculo, regresará a su plano de existencia normal o atacará al invocador (igual probabilidad de cualquiera de los dos). Un mismo ser puede dominar un máximo de tres Sirvientes Elementales a la vez." } },
      { "name": "07. Repeler Elemental Débil", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler Sirviente Elemental, salvo que repele a Elementales Débiles." } },
      { "name": "08. Controlar Elemental Débil", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 8, "area_of_effect": "1 objetivo", "duration": "C", "range": "10'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Controlar Sirviente Elemental, salvo que afecta a Elementales Débiles." } },
      { "name": "09. Desterrar Elemental Débil", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 objetivo", "duration": "—", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Desterrar Sirviente Elemental, salvo que afecta a Elementales Débiles." } },
      { "name": "10. Invocar Elemental Débil", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Invocar Sirviente Elemental, salvo que afecta a Elementales Débiles." } },
      { "name": "11. Comunicación Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Durante la duración, el lanzador puede comunicarse libremente con el Elemental objetivo. Este hechizo no otorga ningún control sobre el elemental ni lo vuelve amistoso automáticamente hacia el lanzador." } },
      { "name": "12. Dominar Elemental Débil", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 12, "area_of_effect": "1 objetivo", "duration": "—", "range": "5'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Dominar Sirviente Elemental, salvo que afecta a Elementales Débiles." } },
      { "name": "14. Repeler Elemental Fuerte", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler Sirviente Elemental, salvo que repele a Elementales Fuertes." } },
      { "name": "15. Controlar Elemental Fuerte", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 15, "area_of_effect": "1 objetivo", "duration": "C", "range": "10'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Controlar Sirviente Elemental, salvo que afecta a Elementales Fuertes." } },
      { "name": "16. Desterrar Elemental Fuerte", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 objetivo", "duration": "—", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Desterrar Sirviente Elemental, salvo que afecta a Elementales Fuertes." } },
      { "name": "18. Comunicación Elemental Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "50' de radio", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Comunicación Elemental, salvo que el lanzador puede comunicarse con todos los Elementales de un tipo dentro de un radio de 50'." } },
      { "name": "20. Invocar Elemental Fuerte", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Invocar Sirviente Elemental, salvo que afecta a Elementales Fuertes." } },
      { "name": "25. Dominar Elemental Fuerte", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 25, "area_of_effect": "1 objetivo", "duration": "—", "range": "5'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Dominar Sirviente Elemental, salvo que afecta a Elementales Fuertes." } },
      { "name": "30. Controlar Guardián Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 objetivo", "duration": "C", "range": "10'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Controlar Sirviente Elemental, salvo que afecta a Guardianes Elementales." } },
