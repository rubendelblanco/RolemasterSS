    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Esencia Cerrada 14.3.7 - Maestría de la Luz. Hechizos para crear luz, auras y bengalas, cegar y aturdir con estallidos de luz, y proyectar una baliza visible a kilómetros de distancia.",
    "spells": [
      { "name": "01. Bengala", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 1, "area_of_effect": "10' de radio", "duration": "1 asalto/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador dispara una bengala de luz que vuela rápidamente hacia un área objetivo dentro del alcance, donde desciende lentamente hasta el suelo. Durante la duración del hechizo, la bengala ilumina un área de 10' de radio. Si se dispara contra un objetivo, no hará daño y simplemente se apagará." } },
      { "name": "02. Luz Proyectada", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "haz de 50'", "duration": "10 min/nvl", "range": "sí mismo", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Un haz de luz brota de la palma del lanzador. Esta luz tiene un alcance efectivo de 50'. Si el lanzador cierra el puño, la luz se 'apaga'; cuando abre el puño, la luz vuelve a encenderse (mientras la duración no haya expirado)." } },
      { "name": "03. Visión Deslumbrante", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo es inmune a la luz brillante, el resplandor solar y la ceguera por nieve. También recibe un bonificador especial de +25 contra todos los ataques cegadores." } },
      { "name": "04. Luces Danzantes", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "esfera de 1' de radio", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea una bola de luz iridiscente por nivel del lanzador, que puede hacerse 'danzar' en cualquier lugar dentro del alcance del hechizo. Estas luces no pueden hacer daño, y emiten luz equivalente a la de una antorcha. Todos los que vean las luces (salvo el lanzador) deben hacer una TR contra un ataque de primer nivel (como una TR de Miedo) o quedar paralizados un asalto por cada 10% de fallo." } },
      { "name": "05. Luz I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Ilumina un área de 10' de radio alrededor del punto tocado. Si el punto está sobre un objeto o ser móvil, se moverá con él. Véase la Sección 7.1.17 de Spell Law." } },
      { "name": "06. Pirotecnia", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 pie cúbico/nvl", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea un despliegue multicolor de luces estallantes." } },
      { "name": "07. Aura I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea un aura brillante alrededor del objetivo, haciéndolo parecer más poderoso y restando 5 a todos los ataques contra él." } },
      { "name": "08. Luz Súbita I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "10' de radio", "duration": "varía", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Provoca un estallido de luz intensa en un radio de 10'; todos los que estén dentro quedan aturdidos 1 asalto por cada 10% de fallo." } },
      { "name": "09. Luz V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "50' de radio", "duration": "10 min/nvl", "range": "toque", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Luz I, salvo que tiene un radio de 50'." } },
      { "name": "10. Orbe Fotónico", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 objetivo", "duration": "varía", "range": "50'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador crea y libera una bola centelleante de color translúcido y arremolinado que golpea al objetivo, resultando en 1 asalto de ceguera por cada 10% de fallo." } },
      { "name": "11. Matiz", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1000 pies cúbicos", "duration": "10 min/nvl", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Hace que cualquier objeto de hasta 1000 pies cúbicos brille del color deseado." } },
      { "name": "12. Aura II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Aura, salvo que resta 10 a todos los ataques." } },
      { "name": "13. Luz Súbita II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "20' de radio", "duration": "varía", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Luz Súbita I, salvo que tiene un radio de 20'." } },
      { "name": "14. Luz X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "100' de radio", "duration": "10 min/nvl", "range": "toque", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Luz I, salvo que tiene un radio de 100'." } },
      { "name": "15. Luz en Espera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "varía", "duration": "varía", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Este hechizo se lanza en conjunción con cualquier hechizo de Luz (es decir, el hechizo de Luz debe lanzarse dentro del minuto siguiente a lanzar este hechizo). Puede retrasar la activación de ese hechizo hasta 24 horas. Puede activarse por uno de los siguientes (decidido por el lanzador al lanzarlo): un periodo de tiempo, movimientos específicos, sonidos específicos, contacto, acción violenta en la zona, etc." } },
      { "name": "16. Baliza V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "5 millas", "duration": "1 min/nvl", "range": "sí mismo", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Un rayo de luz (de cualquier color) brota de la palma del lanzador. Este rayo puede llegar a medir hasta 5 millas." } },
      { "name": "17. Aura III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Aura, salvo que resta 15 a todos los ataques." } },
      { "name": "18. Luz XX", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "200' de radio", "duration": "10 min/nvl", "range": "toque", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Luz I, salvo que tiene un radio de 200'." } },
      { "name": "19. Luz Súbita Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "50' de radio", "duration": "1 asalto/5% fallo", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Luz Súbita I, salvo que tiene un radio de 50'." } },
      { "name": "20. Luz Absoluta", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "100' de radio", "duration": "1 min/nvl", "range": "toque", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Luz I, salvo que tiene un radio de 100'." } },
      { "name": "25. Baliza X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "10 millas", "duration": "1 min/nvl", "range": "sí mismo", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Baliza V, salvo que el rayo puede llegar a medir hasta 10 millas." } },
      { "name": "30. Luz Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "10' de radio/nvl", "duration": "1 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Luz I, salvo por el área de efecto." } },
      { "name": "50. Maestría de la Luz", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "lanzador", "duration": "1 asalto/nvl", "range": "varía", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede usar cualquier hechizo de nivel inferior de esta lista cada asalto durante la duración de este hechizo." } }
    ]
