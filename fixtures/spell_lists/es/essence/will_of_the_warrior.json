    "description": "Lista Base de Guerrero Mago 14.6.6 - Voluntad del Guerrero. Hechizos de fortaleza mental que permiten al lanzador sobreponerse al aturdimiento, el dolor, las heridas y el agotamiento mediante pura fuerza de voluntad.",
    "spells": [
      { "name": "02. Resistencia Extendida I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Mientras este hechizo esté en efecto, el lanzador solo gasta dos tercios de los puntos de agotamiento normales por cualquier acción que realice." } },
      { "name": "03. Alivio de Aturdimiento I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 3, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "El lanzador se libera de un asalto de aturdimiento acumulado." } },
      { "name": "04. Sin Dolor I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 4, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "El lanzador puede soportar un 25% adicional de sus golpes de conmoción totales antes de desmayarse. Los golpes se reciben igualmente y permanecen cuando el hechizo termina." } },
      { "name": "05. Concentración II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 5, "area_of_effect": "lanzador", "duration": "1 asalto", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Añade +20 a cualquier maniobra. No puede realizarse ninguna otra acción el asalto en que se resuelve esta maniobra." } },
      { "name": "06. Resistencia Extendida II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Resistencia Extendida I, salvo que el lanzador solo gasta un tercio de los puntos de agotamiento normales." } },
      { "name": "07. Alivio de Aturdimiento II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 7, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Como Alivio de Aturdimiento I, salvo que se liberan 2 asaltos de aturdimiento." } },
      { "name": "08. Ignorar Herida I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 8, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Reduce a la mitad la penalización de maniobra de cualquier herida durante la duración del hechizo." } },
      { "name": "09. Sin Dolor II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 9, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Como Sin Dolor I, salvo que puede soportarse un 50% adicional de golpes." } },
      { "name": "10. Resistencia a Interrogatorio", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 10, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador obtiene un +50 a las RR contra interrogatorios y un +50 a las RR contra hechizos de lectura mental de los que sea consciente." } },
      { "name": "11. Concentración IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 11, "area_of_effect": "lanzador", "duration": "1 asalto", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Concentración II, salvo que la bonificación es de +40." } },
      { "name": "12. Momento de Claridad", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 12, "area_of_effect": "lanzador", "duration": "1 asalto", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede ignorar todas las penalizaciones y asaltos de aturdimiento acumulados de todas las heridas que haya sufrido durante 1 asalto. También puede ignorar las penalizaciones por el total de golpes de conmoción que haya recibido." } },
      { "name": "13. Resistencia Extendida III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Resistencia Extendida I, salvo que el lanzador solo gasta la mitad de los puntos de agotamiento normales." } },
      { "name": "14. Sin Aturdimiento", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 14, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "El lanzador puede ignorar todos los asaltos de aturdimiento causados por cualquier herida." } },
      { "name": "15. Sin Dolor III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 15, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Como Sin Dolor I, salvo que puede soportarse un 75% adicional de golpes." } },
      { "name": "16. Ignorar Elementos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador no se ve afectado por los extremos naturales de temperatura. Puede moverse cómodamente por el desierto más caluroso (200°F) o el páramo ártico más frío (-100°F) con solo ropa ligera." } },
      { "name": "17. Ignorar Herida II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 17, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Como Ignorar Herida I, salvo que la penalización se reduce en un 75%." } },
      { "name": "18. Concentración V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 18, "area_of_effect": "lanzador", "duration": "1 asalto", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Concentración II, salvo que la bonificación es de +50." } },
      { "name": "19. Enfoque", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 19, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador obtiene una bonificación de +20 a todas las maniobras que intente y que lo acerquen a un objetivo que fije en el momento de lanzar el hechizo. Ese objetivo debe ser alcanzable dentro de la duración del hechizo. Una vez fijado, el lanzador se mostrará reacio a realizar cualquier acción que no lo acerque a su objetivo." } },
      { "name": "20. Sin Dolor IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 20, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Como Sin Dolor I, salvo que puede soportarse un 100% adicional de golpes." } },
      { "name": "25. Resistencia Extendida IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Mientras este hechizo esté en efecto, el lanzador no gasta puntos de agotamiento por ninguna acción que realice." } },
      { "name": "30. Ignorar Herida III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 30, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Como Ignorar Herida I, salvo que la penalización se reduce en un 90%." } },
      { "name": "50. Voluntad del Guerrero Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 50, "area_of_effect": "lanzador", "duration": "1 asalto/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Durante la duración, el lanzador no puede ser aturdido, no sufre penalizaciones de maniobra por heridas, y no gasta puntos de agotamiento. Al finalizar el hechizo, el lanzador queda inconsciente durante 1 hora por cada asalto que el hechizo haya estado en efecto." } }
