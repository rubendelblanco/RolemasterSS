{
  "name": "Defensa de Hechizos",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "essence",
    "profession": "Guerrero Mago",
    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Lista Base de Guerrero Mago 14.6.3 - Defensa de Hechizos. Hechizos de detección y protección que permiten al lanzador percibir magia activa de cualquier reino y protegerse a sí mismo y a sus aliados de ella.",
    "spells": [
      { "name": "01. Detectar Esencia", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "5' de radio", "duration": "1 min/nvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Detecta cualquier hechizo u objeto activo del reino de la Esencia. El lanzador puede concentrarse en un área de 5' de radio cada asalto." } },
      { "name": "02. Protección I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Resta 5 a las tiradas de ataque elemental contra el objetivo y suma 5 a todas las RR del objetivo contra hechizos." } },
      { "name": "03. Detectar Canalización", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "5' de radio", "duration": "1 min/nvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Esencia, salvo que el reino es Canalización." } },
      { "name": "04. Protección de Esencia", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 hechizo", "duration": "varía", "range": "sí mismo", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Cuando el lanzador de este hechizo es objetivo de un hechizo del reino de la Esencia, el hechizo 'entrante' debe primero superar una RR antes de que el lanzador haga la suya. A efectos de RR, cada hechizo usa un nivel igual al de su lanzador. Si el hechizo entrante supera la RR, puede afectar normalmente al lanzador de este hechizo; en caso contrario, el hechizo entrante no tiene efecto sobre este objetivo. Protección de Esencia permanece en efecto hasta que su lanzador haya sido objetivo de 1 hechizo de Esencia." } },
      { "name": "05. Detectar Mentalismo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "5' de radio", "duration": "1 min/nvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Esencia, salvo que el reino es Mentalismo." } },
      { "name": "06. Protección de Mentalismo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 hechizo", "duration": "varía", "range": "sí mismo", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Protección de Esencia, salvo que afecta a hechizos del reino de Mentalismo." } },
      { "name": "07. Detectar Invisible", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "5' de radio", "duration": "1 min/nvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Esencia, salvo que detecta cosas invisibles. Todos los ataques contra algo así detectado se modifican en -50." } },
      { "name": "08. Protección de Canalización", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 hechizo", "duration": "varía", "range": "sí mismo", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Protección de Esencia, salvo que afecta a hechizos del reino de Canalización." } },
      { "name": "09. Esfera de Protección II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "10' de radio", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Protección I, salvo que las bonificaciones son de 10 y todos los seres dentro de 10' de radio del objetivo reciben el beneficio." } },
      { "name": "10. Detección de Hechizos I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "10' de radio", "duration": "1 min/nvl", "range": "sí mismo", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador se percata un instante antes de que cualquiera a menos de 10' lance un hechizo. Esto debería dar tiempo suficiente para lanzar cualquier hechizo instantáneo." } },
      { "name": "11. Parada Elemental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "lanzador", "duration": "1 asalto", "range": "sí mismo", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede usar hasta la mitad de su TA normal con el arma que tenga en las manos para parar un hechizo de proyectil elemental." } },
      { "name": "12. Detectar Intangible", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "5' de radio", "duration": "1 min/nvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Invisible, salvo que también detecta cosas que sean Astrales, Etéreas, fuera de fase, etc." } },
      { "name": "13. Protección III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Protección I, salvo que las bonificaciones son de 15." } },
      { "name": "14. Detectar Poder", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "5' de radio", "duration": "1 min/nvl (C)", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Esencia, salvo que detecta hechizos activos, objetos mágicos, o lanzadores de hechizos de cualquier reino." } },
      { "name": "15. Esfera de Protección III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "10' de radio", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Protección III, salvo que tiene un radio de 10' como en Esfera de Protección II." } },
      { "name": "16. Detección de Hechizos II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "20' de radio", "duration": "1 min/nvl", "range": "sí mismo", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detección de Hechizos I, salvo que detecta hechizos lanzados dentro de 20' de radio y el lanzador averigua quién lo está lanzando." } },
      { "name": "17. Protección IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Protección I, salvo que las bonificaciones son de 20." } },
      { "name": "18. Parada de Hechizos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "lanzador", "duration": "1 asalto", "range": "sí mismo", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede sumar hasta la mitad de su TA normal (con el arma que tenga en las manos) a su RR contra cualquier hechizo que lo tenga como objetivo y del cual sea consciente." } },
      { "name": "19. Esfera de Protección de Reino", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "10' de radio", "duration": "varía", "range": "sí mismo", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Protección de Esencia, salvo que se ven afectados hechizos de cualquier reino y tiene un radio de 10'." } },
      { "name": "20. Esfera de Protección IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "10' de radio", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Protección IV, salvo que tiene un radio de 10' como en Esfera de Protección II." } },
      { "name": "25. Detección de Hechizos III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "30' de radio", "duration": "1 min/nvl", "range": "sí mismo", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detección de Hechizos II, salvo que detecta hechizos lanzados dentro de 30' de radio y el lanzador averigua qué reino está lanzando." } },
      { "name": "30. Detección de Hechizos IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "50' de radio", "duration": "1 min/nvl", "range": "sí mismo", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detección de Hechizos III, salvo que detecta hechizos lanzados dentro de 50' de radio y el lanzador averigua el hechizo exacto que se está lanzando." } },
      { "name": "50. Perdición de Hechizos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "lanzador", "duration": "1 asalto/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede utilizar cualquiera de los hechizos de menor nivel de esta lista cada asalto." } }
    ]
  }
}
