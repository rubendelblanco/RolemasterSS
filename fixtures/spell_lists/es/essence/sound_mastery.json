    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Essencia Abierta 14.2.5 - Maestría del Sonido. Hechizos para potenciar y proyectar el oído y la voz, silenciar y amurallar el sonido, ensordecer y enmudecer a un objetivo, y hacer añicos objetos con sonido.",
    "spells": [
      { "name": "01. Oídos Astutos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo obtiene el doble de audición normal. Esto se traduce en +50 a maniobras de Percepción que involucren solo el oído; +25 si involucran el oído y otros sentidos." } },
      { "name": "02. Control de Volumen", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede modificar el volumen de todos los ruidos naturales producidos por el objetivo entre x0,5 y x2 del volumen original (el volumen debe elegirse en el momento de lanzarlo)." } },
      { "name": "03. Acallar I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea un área de 1' de radio alrededor del objetivo hacia y desde la cual no puede viajar el sonido; si el punto está sobre un objeto o ser móvil, se moverá con él; +25 a los intentos de Sigilo. Véase la Sección 7.1.7 de Spell Law." } },
      { "name": "04. Oído Selectivo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "lanzador", "duration": "C", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede seleccionar una fuente concreta de sonido que pueda oír con claridad. Todas las demás formas de ruido quedarán silenciadas. Este hechizo filtra eficazmente todo ruido de fondo. El lanzador debe realizar una maniobra de Alerta para reconocer cualquier otro sonido durante la duración de este hechizo." } },
      { "name": "05. Voz Lejana I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 punto", "duration": "1 min/nvl (C)", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador designa un punto dentro del alcance del hechizo. El lanzador puede hablar y su voz se oirá como si se originara en ese punto." } },
      { "name": "06. Muro de Sonido I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "20'x20'", "duration": "10 min/nvl", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea un plano (de hasta 20'x20') a través del cual no pasará ningún sonido." } },
      { "name": "07. Oído Lejano I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 punto", "duration": "1 min/nvl (C)", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El punto de audición del lanzador puede desplazarse de forma independiente hasta 100' de distancia (se mueve a un ritmo de 10' por asalto). Debe poder llegar físicamente allí (p. ej., no podría enviar su punto de audición a través de muros o puertas)." } },
      { "name": "08. Silencio I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "10' de radio", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Acallar I, salvo que afecta a un radio de 10'." } },
      { "name": "09. Acallar III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "3 objetivos", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Acallar I, salvo que puede afectar hasta a tres objetivos." } },
      { "name": "10. Resonancia", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "La voz del objetivo cuadruplica su volumen. Esto no tiene efecto en sus capacidades de lanzamiento de hechizos (simplemente le permite hacerse oír sin dificultad a largas distancias)." } },
      { "name": "11. Muro de Sonido V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "(20'x20')x5", "duration": "10 min/nvl", "range": "toque", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Muro de Sonido I, salvo que se crean 5 muros. Cada Muro de Sonido debe estar conectado a al menos otro." } },
      { "name": "12. Voz Lejana III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 punto", "duration": "C", "range": "300'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Voz Lejana I, salvo que el alcance es de 300'." } },
      { "name": "13. Acallar V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "5 objetivos", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Acallar I, salvo que puede afectar hasta a cinco objetivos." } },
      { "name": "14. Oído Lejano III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 punto", "duration": "C", "range": "300'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Oído Lejano I, salvo que el alcance es de 300'." } },
      { "name": "15. Ensordecer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 objetivo", "duration": "1 asalto/5% fallo", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Los oídos del objetivo comienzan a zumbar tan fuerte que no puede oír nada durante la duración." } },
      { "name": "16. Silencio V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "50' de radio", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Acallar I, salvo que afecta a un radio de 50'." } },
      { "name": "17. Voz Lejana V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 punto", "duration": "C", "range": "500'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Voz Lejana I, salvo que el alcance es de 500'." } },
      { "name": "18. Ráfaga Trituradora", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 objeto", "duration": "—", "range": "20'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "El objeto objetivo debe hacer una tirada de resistencia o romperse. Los objetos de vidrio resisten a -25 y los de metal resisten a +25." } },
      { "name": "19. Oído Lejano V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 punto", "duration": "C", "range": "500'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Oído Lejano I, salvo que el alcance es de 500'." } },
      { "name": "20. Enmudecer", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 objetivo", "duration": "1 asalto/5% fallo", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo es incapaz de emitir cualquier sonido durante 1 asalto por cada 5% de fallo." } },
      { "name": "25. Muros de Sonido Masivos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "varía", "duration": "10 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Muro de Sonido V, salvo que pueden crearse tantos Muros de Sonido como el nivel del objetivo." } },
      { "name": "30. Silencio Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "100' de radio", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Acallar I, salvo que afecta a un radio de 100'." } },
      { "name": "50. Maestría del Sonido", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "lanzador", "duration": "1 asalto/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede usar cualquier hechizo de nivel inferior de esta lista cada asalto durante la duración de este hechizo." } }
    ]
  }
}
