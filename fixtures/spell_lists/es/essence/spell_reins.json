    "description": "Esencia Cerrada 3.9 - Riendas de Hechizos. Hechizos para almacenar hechizos, identificar lanzamiento, Retener Hechizo, Desviar Hechizo, Invertir Hechizo, Préstamo de Poder y versiones verdaderas.",
    "spells": [
      {
        "name": "01. Almacenar Hechizo",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 hechizo",
          "duration": "varía",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "El lanzador puede lanzar este hechizo con cualquier hechizo que quiera almacenar. El hechizo a almacenar debe lanzarse en el minuto siguiente. El hechizo almacenado puede lanzarse después como hechizo instantáneo. Cuesta los mismos PP que el hechizo almacenado. No puede lanzarse otro hechizo mientras uno está almacenado."
        }
      },
      {
        "name": "02. Identificar Lanzamiento",
        "img": "systems/rmss/assets/default/spell.svg",
