          "area_of_effect": "1 objetivo",
          "duration": "—",
          "range": "self",
          "type": "P",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Si el objetivo está lanzando un hechizo, el lanzador sabrá de qué reino es y qué tipo de hechizo está lanzando."
        }
      },
      {
