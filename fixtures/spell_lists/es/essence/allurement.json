      { "name": "19. Encantar Mismo Sexo III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "3 objetivos", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Mismo Sexo I, salvo que pueden afectarse hasta 3 objetivos." } },
      { "name": "20. Encantar Sexo Opuesto X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "10 objetivos", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Sexo Opuesto I, salvo que pueden afectarse hasta 10 objetivos." } },
      { "name": "25. Geas Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Geas, salvo que el fallo resulta en la muerte." } },
      { "name": "30. Alkar", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "sí mismo", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Aura Personal, salvo que el lanzador parece un semidiós y la penalización a todos los ataques recibidos es -30." } },
