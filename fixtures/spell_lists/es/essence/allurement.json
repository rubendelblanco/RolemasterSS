    "description": "Esencia Abierta 14.2.2 - Seducción. Hechizos para encantar a personas, animales y plantas, seducir, sugestionar, y atar a un objetivo con un geas.",
    "spells": [
      { "name": "01. Empatía I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "sí mismo", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Durante la duración, el lanzador obtiene un bonificador de +5 a todas las habilidades de la categoría Influencia (y cualquier otra habilidad relacionada con la interacción con personas)." } },
      { "name": "02. Encantar Sexo Opuesto I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Un objetivo humanoide del sexo opuesto cree que el lanzador es un buen amigo. La TR del objetivo puede modificarse por prejuicios raciales." } },
      { "name": "03. Aura Personal", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "sí mismo", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Provoca un aura brillante alrededor del lanzador, haciéndolo parecer más poderoso y restando 10 a todos los ataques recibidos." } },
      { "name": "04. Encantar Planta I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Sexo Opuesto I, salvo que se afecta a una planta sensible." } },
      { "name": "05. Seducción", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El lanzador manipula emocional y/o sensualmente a un objetivo humanoide (puede resultar en apego emocional). El lanzador recibe un bonificador a sus maniobras de Seducción contra este objetivo igual a la cantidad por la que el objetivo falló su TR. Por ejemplo, si un objetivo falla su TR por 15, el lanzador recibe +15 a todas las maniobras de Seducción durante la duración del hechizo." } },
      { "name": "06. Encantar Sexo Opuesto II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "2 objetivos", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Sexo Opuesto I, salvo que pueden afectarse hasta dos objetivos." } },
      { "name": "07. Encantar Animal I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Sexo Opuesto I, salvo que se afecta a una criatura con inteligencia animal." } },
      { "name": "08. Sugestión I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo seguirá un único acto sugerido que no sea completamente ajeno a su naturaleza (p. ej., suicidarse, cegarse a sí mismo, etc.). Este hechizo expira cuando el objetivo completa la acción." } },
      { "name": "09. Encantar Mismo Sexo I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Sexo Opuesto I, salvo que se afecta a un miembro del mismo sexo." } },
      { "name": "10. Encantar Sexo Opuesto III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "3 objetivos", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Sexo Opuesto I, salvo que pueden afectarse hasta 3 objetivos." } },
      { "name": "11. Empatía II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "sí mismo", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Empatía I, salvo que el bonificador es +10." } },
      { "name": "12. Encanto Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Sexo Opuesto I, salvo que afecta a cualquier ser sensible." } },
      { "name": "13. Gran Aura", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "sí mismo", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Aura Personal, salvo que se restan 20 a todos los ataques recibidos." } },
      { "name": "14. Encantar Sexo Opuesto V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "5 objetivos", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Sexo Opuesto I, salvo que pueden afectarse hasta 5 objetivos." } },
      { "name": "15. Geas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Se impone al objetivo una tarea que debe estar dentro de sus capacidades. El fallo o la negativa a realizar la tarea provoca que el objetivo reciba 3 críticos eléctricos 'E'." } },
      { "name": "16. Encantar Planta III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "3 objetivos", "duration": "10 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encantar Planta I, salvo que pueden afectarse hasta 3 plantas." } },
