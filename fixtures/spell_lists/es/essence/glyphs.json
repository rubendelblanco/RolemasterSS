    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Lista Base de Moldeador de Mana 14.5.6 - Glifos. Hechizos para embeber hechizos en aire, agua u otros medios en flujo como glifos activables, y para descifrarlos, extenderlos o borrarlos. Investigar Glifo es también la única forma de aprender la tabla aparte de glifos especiales investigados de la lista (Luz, Sueño, Aturdir, Miedo, Muerte, etc., no modelados aquí como hechizos individuales).",
    "spells": [
      { "name": "01. Investigar Glifo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "varía", "duration": "8 horas", "range": "sí mismo", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador conocer el origen y los parámetros de un glifo. Esta es la única forma en que el lanzador puede aprender glifos especiales." } },
      { "name": "02. Glifo I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador 'trazar' un glifo visible y luminoso sobre un medio en flujo, que puede activarse por uno de los siguientes (decidido por el lanzador al lanzarlo): a) ha transcurrido un tiempo especificado, b) movimientos específicos dentro de 20', c) sonidos específicos dentro de 20', o d) contacto. Deben gastarse puntos de poder tanto para el hechizo como para el glifo, pero solo se usa el tiempo de lanzamiento del glifo. Un glifo puede ser un hechizo de primer nivel o un glifo especial que se haya investigado." } },
      { "name": "03. Descifrar Glifo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 glifo", "duration": "1 asalto/nvl", "range": "sí mismo", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador descifrar un glifo y saber exactamente qué hace sin activarlo (suponiendo que no se haya activado ya). Tarda un asalto por nivel del glifo en descifrarlo. No se aprende nada si este hechizo expira antes de completar el descifrado." } },
      { "name": "04. Glifo II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de segundo nivel." } },
      { "name": "05. Glifo en Espera II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "10' de radio", "duration": "1 día/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Extiende la duración de un Glifo I o Glifo II." } },
      { "name": "06. Glifo III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de 3er nivel." } },
      { "name": "07. Desglifar III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 glifo", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador borrar un glifo de hasta tercer nivel. Esto no activará el glifo en cuestión (a menos que el disparador especificado para el glifo fuera precisamente que el glifo se borre)." } },
      { "name": "08. Glifo IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de cuarto nivel." } },
      { "name": "09. Glifo en Espera IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "10' de radio", "duration": "1 día/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo en Espera II, salvo que se aplica a glifos de hasta cuarto nivel." } },
      { "name": "10. Glifo V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de quinto nivel." } },
      { "name": "11. Multi-Glifo II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador colocar dos hechizos en el mismo glifo. El hechizo de glifo solo necesita lanzarse una vez (pero debe lanzarse dentro del minuto siguiente a completar este hechizo)." } },
      { "name": "12. Glifo VI", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de sexto nivel." } },
      { "name": "13. Desglifar VI", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 glifo", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Desglifar III, salvo que pueden afectarse glifos de hasta sexto nivel." } },
      { "name": "14. Glifo VII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de séptimo nivel." } },
      { "name": "15. Glifo en Espera VII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "10' de radio", "duration": "1 día/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo en Espera II, salvo que extiende la duración de un glifo de hasta séptimo nivel." } },
      { "name": "16. Glifo VIII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de octavo nivel." } },
      { "name": "17. Multi-Glifo III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Multi-Glifo II, salvo que pueden colocarse tres hechizos en el mismo glifo." } },
      { "name": "18. Glifo IX", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de noveno nivel." } },
      { "name": "19. Glifo X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de décimo nivel." } },
      { "name": "20. Glifo en Espera X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "10' de radio", "duration": "1 día/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo en Espera II, salvo que puede retrasarse un glifo de hasta décimo nivel." } },
      { "name": "25. Desglifar X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 glifo", "duration": "P", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Desglifar III, salvo que pueden afectarse glifos de hasta décimo nivel." } },
      { "name": "30. Glifo del Señor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "10' de radio", "duration": "10 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Glifo I, salvo que puede trazarse un glifo de hasta vigésimo nivel." } },
