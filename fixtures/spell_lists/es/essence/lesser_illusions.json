    "description": "Esencia Abierta 2.6 - Ilusiones Menores. Hechizos de ventriloquia, espejismos (sonido/luz, sabor/olor), ilusiones, fantasmas, glamour de luz e ilusiones en espera (retardadas).",
    "spells": [
      {
        "name": "01. Ventriloquia",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 1,
          "area_of_effect": "1 punto",
          "duration": "C",
          "range": "100'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "El lanzador puede hablar y su voz parecerá provenir de cualquier punto que desee dentro de 100' (el punto debe estar en su campo de visión)."
        }
      },
      {
        "name": "02. Espejismo Sonido/Luz",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 2,
          "area_of_effect": "10'R",
          "duration": "10 min/nvl",
          "range": "100'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Crea cualquier imagen, escena o sonidos simples e inmóviles en un área de hasta 10' de radio, o un conjunto de sonidos inmóviles en un área de hasta 10' de radio."
        }
      },
      {
        "name": "03. Espejismo Sabor/Olor",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 3,
          "area_of_effect": "10'R",
          "duration": "10 min/nvl",
          "range": "100'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Como Espejismo Sonido/Luz, excepto que crea un conjunto de olores inmóviles en el área de efecto, o un conjunto de sabores inmóviles en el área de efecto."
        }
      },
      {
        "name": "04. Ilusiones II",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 4,
          "area_of_effect": "10'R",
          "duration": "1 min/nvl",
          "range": "100'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Crea una imagen o escena simple e inmóvil en un área de hasta 10' de radio. También puede elegirse una opción: a) añadir un sentido extra (no táctil ni Presencia), b) duplicar la duración, c) duplicar el alcance, o d) duplicar el radio del área de efecto. Toda el área debe estar dentro del alcance y en el campo de visión del lanzador."
        }
      },
      {
        "name": "05. Fantasma I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 5,
          "area_of_effect": "10'R",
          "duration": "1 min/nvl (C)",
          "range": "100'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Crea la imagen de un objeto o ser que se moverá como el lanzador quiera (mientras se concentre). Al dejar de concentrarse, la imagen permanece pero deja de moverse. Puede retomar la concentración más tarde para moverla de nuevo (si la duración no ha expirado). La imagen puede ser de cualquier tamaño que quepa en el radio."
        }
      },
      {
        "name": "06. Glamour de Luz",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": false,
          "level": 6,
          "area_of_effect": "1 objeto",
          "duration": "1 día/nvl",
          "range": "50'",
          "type": "E",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Cambia la apariencia visual de un objeto. El objetivo no puede ser mayor de 10 libras por nivel."
        }
      },
      {
