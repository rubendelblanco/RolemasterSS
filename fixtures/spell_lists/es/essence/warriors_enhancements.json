{
  "name": "Mejoras del Guerrero",
  "type": "spell_list",
  "img": "systems/rmss/assets/default/spell.svg",
  "system": {
    "type": "base",
    "realm": "essence",
    "profession": "Guerrero Mago",
    "is_container": true,
    "container": { "maxCapacity": 50, "usedCapacity": 0, "capacityType": "quantity", "allowedTags": ["spell"] },
    "description": "Lista Base de Guerrero Mago 14.6.4 - Mejoras del Guerrero. Hechizos de mejora personal que otorgan sentidos aumentados y la capacidad de sobrevivir y actuar en entornos hostiles (agua, fuego, vacío, veneno, temperaturas extremas).",
    "spells": [
      { "name": "01. Percepción de Batalla I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 1, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede realizar una maniobra de Percepción Situacional (Combate) con una modificación especial de +25. Esta maniobra la otorga el hechizo y no requiere que se declare una acción aparte." } },
      { "name": "02. Visión Nocturna", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede ver a 100' en una noche normal como si fuera de día." } },
      { "name": "03. Visión Lateral", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador tiene un campo de visión de 300 grados. La bonificación de flanco para los ataques contra el lanzador se reduce a +5 y la de espalda se reduce a +15." } },
      { "name": "04. Visión Acuática", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Visión Nocturna, salvo que el lanzador puede ver a 100' incluso en agua turbia." } },
      { "name": "05. Percepción de Batalla II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 5, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Percepción de Batalla I, salvo que la bonificación a la maniobra es de +50." } },
      { "name": "06. Pulmones Acuáticos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede respirar agua pero no aire." } },
      { "name": "07. Guerrero Acuático", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede nadar sin gastar energía (es decir, no gastará puntos de agotamiento)." } },
      { "name": "08. Visión de Gas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Visión Nocturna, salvo que el lanzador puede ver a 100' en humo, niebla, lluvia, o cualquier gas que normalmente impida la visión." } },
      { "name": "09. Pulmones de Gas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Pulmones Acuáticos, salvo que el lanzador puede respirar cualquier gas como aire normal." } },
      { "name": "10. Visión en la Oscuridad", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Visión Nocturna, salvo que puede verse a través de cualquier oscuridad. Además, no se necesita luz para que este hechizo funcione." } },
      { "name": "11. Resistir Veneno", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "lanzador", "duration": "1 hora/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Retrasa el efecto de un veneno sobre el lanzador. Si el veneno no se elimina antes de que expire el hechizo, el lanzador se verá afectado por él en ese momento." } },
      { "name": "12. Maniobra Acuática", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Natación, salvo que el lanzador también puede realizar cualquier maniobra (incluido el combate cuerpo a cuerpo) como si estuviera en tierra firme." } },
      { "name": "13. Cambiar Pulmones", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Pulmones Acuáticos, salvo que el lanzador puede respirar agua, aire, y/o cualquier gas a voluntad." } },
      { "name": "14. Ignorar Presión", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede ignorar los efectos de altas presiones, como las que se encuentran en las profundidades submarinas." } },
      { "name": "15. Maniobra en el Fuego", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador y su equipo son inmunes a los efectos del fuego normal (no mágico) durante la duración. Puede realizar cualquier movimiento o maniobra con normalidad." } },
      { "name": "17. Morador Acuático", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Combina los efectos de Visión Acuática, Pulmones Acuáticos, y Maniobra Acuática." } },
      { "name": "18. Pulmones sin Aire", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador no necesita respirar para sobrevivir durante la duración." } },
      { "name": "19. Morador del Fuego", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Combina los efectos de Visión de Gas, Pulmones de Gas, y Maniobra en el Fuego." } },
      { "name": "20. Ignorar Vacío", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador y su equipo son inmunes a los efectos de entornos sin aire durante la duración. Este hechizo otorga al lanzador una RR de +50 contra ataques de vacío. Nótese que este hechizo no otorga ninguna protección contra el calor o el frío del vacío del espacio." } },
      { "name": "25. Resistencia a la Temperatura", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador y su equipo pueden ignorar los efectos de cualquier temperatura natural (no mágica)." } },
      { "name": "30. Morador Acuático Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "lanzador", "duration": "1 hora/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Morador Acuático, salvo por la duración." } },
      { "name": "50. Cambiar Entorno", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede sobrevivir cómodamente y moverse y maniobrar con normalidad en cualquiera de los entornos hostiles contra los que protegen los hechizos de menor nivel de esta lista." } }
    ]
  }
}
