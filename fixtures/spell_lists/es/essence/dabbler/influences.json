    "description": "Lista Base de Indagador 6.2 - Influencias. Hechizos para dormir objetivos, encantar animales y humanoides, sugerir o imponer un curso de acción, retener a un objetivo inmóvil, leer pensamientos superficiales, y encomendar una misión a un objetivo, culminando en Misión Verdadera.",
    "spells": [
      { "name": "01. Sueño III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "varía", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Hace que el objetivo (u objetivos) caiga en un sueño natural. Este hechizo puede afectar a un número de objetivos cuyos niveles sumen hasta 3. El lanzador debe poder ver a todos los objetivos. En el momento de lanzar el hechizo, el lanzador debe designar la prioridad de los objetivos (p. ej., afectar primero al 1er objetivo; si quedan niveles, afectar al 2º; etc.). Los primeros 2 asaltos de sueño son mágicos (el objetivo no puede ser despertado por medios normales)." } },
      { "name": "02. Encanto de Animales", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 animal/nvl", "duration": "1 hora", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El animal (o animales) objetivo creerá que el lanzador es un buen amigo." } },
      { "name": "03. Encanto de Especie", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 objetivo", "duration": "1 hora/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El humanoide objetivo cree que el lanzador es un buen amigo." } },
      { "name": "04. Sueño V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "varía", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sueño III, salvo que afecta a un total de 5 niveles." } },
      { "name": "05. Sugestión", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 objetivo", "duration": "varía", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo seguirá un único acto sugerido que no le resulte completamente ajeno (p. ej., ninguna sugerencia de suicidio, ninguna sugerencia de cegarse a sí mismo, etc.)." } },
      { "name": "06. Telepatía I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 objetivo", "duration": "1 asalto/nvl(C)", "range": "2'/nvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El lanzador recibe los pensamientos superficiales del objetivo. Si el objetivo supera su TR por más de 25, se da cuenta de que alguien está intentando leer su mente." } },
      { "name": "07. Sueño VII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "varía", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sueño III, salvo que afecta a un total de 7 niveles." } },
      { "name": "08. Retener Especie", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 objetivo", "duration": "C", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El humanoide objetivo queda retenido al 25% de su actividad." } },
      { "name": "09. Encanto de Especie Mayor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 objetivo/5 nvl", "duration": "1 hora/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Encanto de Especie, salvo que afecta a un objetivo por cada cinco niveles (o fracción) del lanzador." } },
      { "name": "10. Sueño X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "varía", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sueño III, salvo que afecta a un total de 10 niveles." } },
      { "name": "11. Sugestión Mayor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 objetivo/5 nvl", "duration": "1 hora/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sugestión, salvo que afecta a un objetivo por cada cinco niveles (o fracción) del lanzador." } },
      { "name": "12. Amo de la Especie", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El humanoide objetivo debe obedecer al lanzador. Sin embargo, no realizará ningún acto que le resulte completamente ajeno (p. ej., ninguna orden de suicidio, ninguna orden de cegarse, etc.)." } },
      { "name": "13. Sueño XII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "varía", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sueño III, salvo que afecta a un total de 12 niveles." } },
      { "name": "14. Retener Especie Mayor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 objetivo/5 nvl", "duration": "C", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Retener Especie, salvo que afecta a un objetivo por cada cinco niveles (o fracción) del lanzador." } },
      { "name": "15. Telepatía II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 objetivo", "duration": "1 asalto/nvl(C)", "range": "5'/nvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Telepatía I, salvo por el alcance." } },
      { "name": "16. Sueño XV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "varía", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sueño III, salvo que afecta a un total de 15 niveles." } },
      { "name": "18. Amo de la Especie Mayor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 objetivo/5 nvl", "duration": "10 min/nvl", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Amo de la Especie, salvo que afecta a un objetivo por cada cinco niveles (o fracción) del lanzador." } },
      { "name": "19. Misión", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Se encomienda al objetivo una única tarea. El fracaso conlleva una penalización determinada por el DJ (la tarea debe estar dentro de las capacidades del objetivo). Si el objetivo ignora la misión, sufrirá los mismos efectos que si hubiera fracasado." } },
      { "name": "20. Señor del Sueño", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "varía", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sueño III, salvo que afecta a un total de 20 niveles." } },
      { "name": "25. Sueño Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "varía", "duration": "—", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sueño III, salvo que afecta a un número total de niveles igual al nivel del lanzador." } },
      { "name": "30. Telepatía Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 objetivo", "duration": "1 asalto/nvl(C)", "range": "10'/nvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Telepatía I, salvo por el alcance." } },
      { "name": "50. Misión Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Misión, salvo que el fracaso se castiga con cinco críticos 'E' sufridos por el objetivo (elegidos al azar entre los distintos tipos de crítico)." } }
    ]
  }
