    "description": "Canalización Cerrada 3.5 - Caminos de Localización. Hechizos para encontrar caminos, recibir guía de la deidad, localizar objetos y lugares, y recordar rutas.",
    "spells": [
      { "name": "02. Suposición", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Cuando se enfrenta a una elección sobre la que tiene poca o ninguna información (p. ej., qué pasillo lleva antes al exterior), el lanzador puede lanzar este hechizo y el Director de Juego determinará qué camino toma, con un sesgo favorable del 25% (p. ej., tirada 1-100: acierto en 26-100, fallo en 01-25)." } },
      { "name": "03. Hallar Camino I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "lanzador", "duration": "—", "range": "100'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador conoce la ubicación de cualquier \"camino(s)\" dentro de 100'; da el punto más cercano del camino, pero no su trazado." } },
      { "name": "04. Guía", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "lanzador", "duration": "10 min/nvl(C)", "range": "100'/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador es dirigido sutilmente (pistas e indicios) hacia un destino concreto (dentro de 100' por nivel del lanzador) por guía de su deidad. La forma exacta de la guía puede variar de una deidad a otra (p. ej., una deidad del agua podría dejar pistas en las rocas de un arroyo, etc.). Durante la duración del hechizo, el lanzador debe concentrarse en seguir la guía." } },
      { "name": "05. Localización I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 objetivo", "duration": "—", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Da la dirección y distancia a cualquier objeto o lugar concreto que el lanzador conozca o le hayan descrito en detalle." } },
      { "name": "06. Hallar Camino III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "lanzador", "duration": "—", "range": "300'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Hallar Camino I, salvo que el alcance es de 300'." } },
      { "name": "08. Localización III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 objetivo", "duration": "—", "range": "300'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Localización I, salvo que el alcance es de 300'." } },
      { "name": "09. Hallar Camino V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "lanzador", "duration": "—", "range": "500'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Hallar Camino I, salvo que el alcance es de 500'." } },
      { "name": "10. Localización V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 objetivo", "duration": "—", "range": "500'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Localización I, salvo que el alcance es de 500'." } },
      { "name": "11. Camino de la Memoria", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "lanzador", "duration": "1 hora/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede recordar la ruta exacta que recorrió, tuviera o no alguno de sus sentidos durante el viaje original (p. ej., un lanzador de nivel 12 podría recordar el trayecto de un viaje de 12 horas aunque hubiera ido con los ojos vendados). Para ser efectivo, este hechizo debe lanzarse dentro del mes siguiente al viaje." } },
      { "name": "12. Hallar Camino X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "lanzador", "duration": "—", "range": "1 milla", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Hallar Camino I, salvo que el alcance es de 1 milla." } },
      { "name": "13. Guía Divina", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "lanzador", "duration": "1 hora/nvl", "range": "1 milla/nvl", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Guía, salvo que la forma de la guía es un animal compañero enviado por la deidad. El lanzador puede seguir al animal hasta un destino concreto. Si pasan más de 24 horas sin que el lanzador avance hacia el destino, el animal se marchará." } },
      { "name": "15. Hallazgo I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 objeto", "duration": "—", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede localizar cualquier 1 objeto que describa, si realmente existe y está dentro del alcance (p. ej., el lanzador podría describir un tipo de maza que nunca hubiera visto ni oído nombrar)." } },
      { "name": "16. Localización X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 objetivo", "duration": "—", "range": "1 milla", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Localización I, salvo que el alcance es de 1 milla." } },
      { "name": "17. Hallar Camino Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "lanzador", "duration": "—", "range": "10 millas", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Hallar Camino I, salvo que el alcance es de 10 millas." } },
      { "name": "18. Hallazgo III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 objeto", "duration": "—", "range": "300'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Hallazgo I, salvo que el alcance es de 300'." } },
      { "name": "20. Localización del Señor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 objetivo", "duration": "—", "range": "20 millas", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Localización I, salvo que el alcance es de 20 millas." } },
      { "name": "25. Caminos Verdaderos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 milla R/nvl", "duration": "—", "range": "1 milla/nvl", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Hallar Camino I, salvo que el alcance es de 1 milla por nivel y se conoce el trazado exacto de los caminos dentro del alcance." } },
      { "name": "30. Localización Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 objetivo", "duration": "—", "range": "1 milla/nvl", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Localización I, salvo que el alcance es de 1 milla por nivel." } },
      { "name": "50. Hallazgo Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 objeto", "duration": "—", "range": "100'/nvl", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Hallazgo, salvo que el alcance es de 100' por nivel." } }
