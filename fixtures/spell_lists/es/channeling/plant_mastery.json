    "description": "Lista Base de Animista 4.6 - Maestría de Plantas. Hechizos para conocer, hacer crecer, restaurar, controlar y animar plantas, e invocar un muro de espinas.",
    "spells": [
      { "name": "01. Saber de Plantas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 planta", "duration": "—", "range": "toque", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador aprende la naturaleza e historia de cualquier 1 planta." } },
      { "name": "02. Crecimiento Rápido I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "10'R", "duration": "1 día", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador multiplicar por 10 la velocidad de crecimiento de cualquier 1 especie de planta dentro del área de efecto." } },
      { "name": "03. Lenguas Vegetales", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "toque", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador entender y \"hablar\" el idioma de cualquier 1 especie vegetal." } },
      { "name": "04. Restaurar Planta", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 planta", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Cura el daño de una planta menos compleja que un árbol (un daño especialmente severo puede permitir una TR para evitar el efecto, a discreción del DJ)." } },
      { "name": "05. Crecimiento Rápido II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "10'R", "duration": "1 día", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Crecimiento Rápido I, salvo que el ritmo de crecimiento es 100 veces mayor." } },
      { "name": "06. Localizar Planta", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 milla R", "duration": "—", "range": "sí mismo", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede localizar ejemplares de cualquier 1 especie de planta, o averiguar qué especies hay en el área de efecto." } },
      { "name": "07. Crecimiento Vegetal II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 planta", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador duplicar el tamaño de cualquier 1 planta. El crecimiento tiene lugar a lo largo de 1 día." } },
      { "name": "08. Control Vegetal I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 planta", "duration": "1 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El lanzador puede controlar los procesos automáticos y/o mentales de cualquier 1 planta. También puede controlar sus movimientos, aunque este hechizo no permite movimiento más allá de lo normalmente posible." } },
      { "name": "09. Crecimiento Rápido III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "100'R", "duration": "1 día", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Crecimiento Rápido I, salvo que el área de efecto es un radio de 100' y el alcance es 100'." } },
      { "name": "10. Crecimiento Vegetal III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 planta", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Crecimiento Vegetal I, salvo que el aumento de tamaño es de 3 veces." } },
      { "name": "11. Control Vegetal III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "3 plantas", "duration": "1 min/nvl", "range": "toque", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Control Vegetal I, salvo que el lanzador puede controlar cualquier 3 plantas." } },
      { "name": "12. Restaurar Árbol", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 árbol", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Restaurar Planta, salvo que puede afectar a cualquier planta (incluidos árboles)." } },
      { "name": "13. Crecimiento Vegetal V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 planta", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Crecimiento Vegetal I, salvo que el aumento de tamaño es de 5 veces." } },
      { "name": "14. Crecimiento Rápido IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "100'R", "duration": "1 día", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Crecimiento Rápido II, salvo que el área de efecto es un radio de 100' y el alcance es 100'." } },
      { "name": "15. Control Vegetal V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "5 plantas", "duration": "1 min/nvl", "range": "toque", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Control Vegetal I, salvo que el lanzador puede controlar cualquier 5 plantas." } },
      { "name": "16. Muro de Espinas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "10'x10'x5'", "duration": "10 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Invoca un muro de espinas muy resistentes (pero flexibles). El muro mide hasta 10' x 10' x 5'. Cualquiera que atraviese el muro recibe d10 ataques de daga (usa un ataque de daga +50 en la Tabla de Ataque de Daga, si está disponible) por cada pie de muro atravesado. El muro debe descansar sobre una superficie sólida." } },
      { "name": "17. Detener Fuego", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "10'R/nvl", "duration": "10 min/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Este hechizo apaga cualquier fuego sobre materiales vivos dentro del área de efecto." } },
      { "name": "18. Crecimiento Vegetal X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 planta", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Crecimiento Vegetal I, salvo que el aumento de tamaño es de 10 veces." } },
      { "name": "20. Crecimiento Vegetal Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "100'R", "duration": "P", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Crecimiento Vegetal I, salvo que afecta a todas las plantas del área de efecto." } },
      { "name": "25. Crecimiento Rápido Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "10'R/nvl", "duration": "1 día", "range": "10'/nvl", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Crecimiento Rápido I, salvo por el alcance y el área de efecto." } },
      { "name": "30. Control Vegetal Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "100'R", "duration": "1 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Control Vegetal I, salvo que el lanzador puede controlar todas las plantas dentro del área de efecto." } },
      { "name": "50. Animación Vegetal", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 planta", "duration": "1 min/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede animar cualquier 1 planta. La planta podrá entonces moverse lentamente, arrastrando consigo cualquier sistema de raíces que posea." } }
