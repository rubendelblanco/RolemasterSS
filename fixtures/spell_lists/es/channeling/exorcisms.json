    "description": "Lista Base de Paladín 6.2 - Exorcismos. Hechizos para repeler y desintegrar No Muertos, repeler y desterrar Demonios, y neutralizar o disipar maldiciones.",
    "spells": [
      { "name": "01. Repeler No Muertos I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "varía", "duration": "1 min/nvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Hace que los No Muertos huyan o se desintegren. Todos los No Muertos tienen una clase asignada. Este hechizo afecta a 1 punto de No Muertos (los de Clase I cuentan como 1 punto, los de Clase II como 2 puntos, etc.). Los Muertos Animados se tratan como No Muertos de Clase I y no tienen derecho a TR (se desintegran automáticamente si el hechizo no falla). Cada objetivo tiene derecho a una TR. Si el objetivo falla la TR por 50 o menos, huirá (si no puede huir, permanecerá inmóvil). Si falla por más de 50, se desintegra. Se aplica una única Tirada de Ataque Base a todos los objetivos. La TR de un No Muerto concreto puede modificarse concentrando el efecto del hechizo en él: por cada punto adicional del hechizo asignado a un objetivo (más allá de lo normalmente necesario para afectarlo), su TR se modifica en -5." } },
      { "name": "02. Detectar No Muertos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "10'R", "duration": "1 min/nvl(C)", "range": "10'/nvl", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Detecta la presencia de No Muertos en el área de efecto. El lanzador puede mover el área de efecto 5' cada asalto." } },
      { "name": "03. Repeler No Muertos III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "varía", "duration": "1 min/nvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler No Muertos I, salvo que afecta a 3 puntos de No Muertos." } },
      { "name": "04. Repeler Demonio I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "5'R/nvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Mientras el lanzador concentre, los Demonios de Tipo I que estén dentro del área de efecto no podrán salir, y los que estén fuera no podrán entrar." } },
      { "name": "05. Repeler No Muertos V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "varía", "duration": "1 min/nvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler No Muertos I, salvo que afecta a 5 puntos de No Muertos." } },
      { "name": "06. Repeler Demonio II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "5'R/nvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler Demonio I, salvo que afecta hasta Demonios de Tipo II." } },
      { "name": "07. Desterrar Demonio I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 demonio", "duration": "1 mes/nvl", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Destierra al Demonio de Tipo I objetivo de este plano de existencia durante la duración del hechizo." } },
      { "name": "08. Neutralizar Maldición I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "[Mod. TR: -20] Anula una maldición durante la duración de este hechizo. La maldición no queda disipada y vuelve a hacer efecto al terminar la duración de este hechizo." } },
      { "name": "09. Repeler Demonio III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "5'R/nvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler Demonio I, salvo que afecta hasta Demonios de Tipo III." } },
