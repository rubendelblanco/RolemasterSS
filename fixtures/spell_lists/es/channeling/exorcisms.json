      { "name": "14. Neutralizar Maldición II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 objetivo", "duration": "1 hora/nvl", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Neutralizar Maldición I, salvo por la duración." } },
