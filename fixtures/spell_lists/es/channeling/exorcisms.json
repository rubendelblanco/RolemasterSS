      { "name": "19. Repeler Demonio VI", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "5'R/nvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler Demonio I, salvo que afecta hasta Demonios de Tipo VI." } },
      { "name": "20. Repeler No Muertos Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "varía", "duration": "1 min/nvl", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler No Muertos I, salvo que un No Muerto de Tipo V o inferior se desintegra. Los de Tipo VI son puestos en fuga." } },
      { "name": "25. Repeler Demonio Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "10'R/nvl", "duration": "C", "range": "10'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Repeler Demonio VI, salvo por el área de efecto." } },
      { "name": "30. Deshacer Maldición Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "[Mod. TR: -50] Disipa una maldición si esta falla una TR. El nivel de la maldición es el del lanzador de la maldición original. Si no se disipa, el lanzador no puede volver a intentarlo hasta subir otro nivel de experiencia." } },
