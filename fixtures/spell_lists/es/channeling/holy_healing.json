      { "name": "13. Alivio de Congelación/Quemadura III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Alivio de Congelación/Quemadura I, salvo que el lanzador puede curar 3 áreas de daño leve o 1 área de daño severo (p. ej. quemaduras de 3er grado) o una combinación de 1 leve y 1 moderada." } },
      { "name": "14. Alivio de Aturdimiento II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 14, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Como Alivio de Aturdimiento I, salvo que alivia 2 asaltos de aturdimiento." } },
