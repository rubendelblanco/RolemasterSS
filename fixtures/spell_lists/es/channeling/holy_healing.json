    "description": "Lista Base de Paladín 6.4 - Curación Sagrada. Hechizos para curar golpes de conmoción, detener hemorragias, soldar fracturas, aliviar aturdimiento y daño por frío/quemadura, resistir enfermedades y venenos, y curar parálisis.",
    "spells": [
      { "name": "01. Curación I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo cura d10 golpes de conmoción." } },
      { "name": "02. Detener Flujo I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador detener la hemorragia de una herida que sangra 1 golpe por asalto. El objetivo no puede moverse, o la hemorragia se reanudará al ritmo anterior." } },
      { "name": "03. Alivio de Congelación/Quemadura I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo cura un área de congelación leve o quemadura de 1er grado." } },
      { "name": "04. Reparación de Fractura Menor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador soldar una fractura simple (no fracturas compuestas, astillamientos, daño articular, etc.). El tiempo de recuperación es de un día." } },
      { "name": "05. Curación III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Curación I, salvo que cura 3d10 golpes de conmoción." } },
      { "name": "06. Alivio de Aturdimiento I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 6, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "El objetivo se libera de 1 asalto de aturdimiento acumulado." } },
      { "name": "07. Reparación de Fractura Mayor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Reparación de Fractura Menor, salvo que el lanzador también puede reparar fracturas compuestas. El tiempo de recuperación es de un día." } },
      { "name": "08. Resistencia a Enfermedad I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Durante la duración de este hechizo, el objetivo obtiene una TR adicional contra cualquier enfermedad." } },
      { "name": "09. Resistencia a Veneno I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 objetivo", "duration": "10 min/nvl", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Durante la duración de este hechizo, el objetivo obtiene una TR adicional contra cualquier veneno." } },
      { "name": "10. Reparación Menor de Vaso", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador sanar por completo un vaso sanguíneo menor dañado (uno que sangre hasta 2 golpes por asalto, no arterias o venas mayores)." } },
      { "name": "11. Curación V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Curación I, salvo que cura 5d10 golpes de conmoción." } },
