      { "name": "18. Deshacer Enfermedad", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede eliminar cualquier enfermedad del objetivo." } },
