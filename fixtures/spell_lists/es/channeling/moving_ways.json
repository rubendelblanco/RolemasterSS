    "description": "Lista Base de Guardabosques 7.2 - Caminos del Movimiento. Hechizos para correr y nadar sin cansarse por roca, ramas, agua y arena, ocultar huellas, pasar sin dejar rastro, y fundirse en material orgánico.",
    "spells": [
      { "name": "01. Correr sobre Roca", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede correr por superficies rocosas y de tierra casi horizontales como si estuviera en terreno llano. Gasta puntos de agotamiento como si caminara." } },
      { "name": "02. Caminar por Ramas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador caminar por ramas de árbol como si estuviera en terreno llano." } },
      { "name": "03. Nadar", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede nadar sin gastar energía (es decir, sin gastar puntos de agotamiento)." } },
      { "name": "04. Caminar sobre Agua", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede caminar sobre el agua como si estuviera en tierra firme. No puede usarse sobre agua agitada." } },
      { "name": "05. Correr sobre Arena", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede correr por superficies de arena como si estuviera en terreno llano. Gasta puntos de agotamiento como si caminara." } },
      { "name": "06. Correr por Ramas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Caminar por Ramas, salvo que el lanzador puede moverse al doble de su ritmo normal (ritmo de Carrera). Gasta puntos de agotamiento como si caminara." } },
      { "name": "07. Paso sin Rastro", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "lanzador", "duration": "C", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede caminar sin dejar huellas ni otras señales visibles de su paso." } },
      { "name": "08. Ocultar Huellas I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "huellas de 1", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede ocultar las huellas de cualquier 1 ser. Este hechizo y Paso sin Rastro pueden usarse simultáneamente, manteniendo el lanzador un 50% de actividad (puede concentrarse en ambos hechizos a la vez)." } },
      { "name": "09. Correr sobre Agua", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Caminar sobre Agua, salvo que el lanzador puede moverse al doble de su ritmo normal (ritmo de Carrera). Gasta puntos de agotamiento como si caminara." } },
      { "name": "10. Ocultar Huellas II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "huellas de 2", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Ocultar Huellas I, salvo que oculta las huellas de 2 seres." } },
      { "name": "11. Nadar Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Nadar, salvo que el objetivo puede nadar tan rápido como podría correr. Gasta puntos de agotamiento como si caminara." } },
      { "name": "12. Ocultar Huellas V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "huellas de 5", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Ocultar Huellas I, salvo que oculta las huellas de 5 seres." } },
      { "name": "13. Correr Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como cualquiera de los hechizos de Correr anteriores, salvo que puede usarse cualquiera de ellos cada asalto (p. ej., el lanzador podría correr sobre arena, luego sobre agua, luego por ramas, etc.)." } },
      { "name": "14. Paso sin Rastro Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Paso sin Rastro, salvo que el lanzador no necesita concentrarse." } },
      { "name": "15. Fundirse en lo Orgánico", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede fundirse en material orgánico (vivo o muerto). Mientras esté fundido, no puede moverse ni percibir. Al emerger del material, puede salir por cualquier cara o lado. No puede moverse \"a través\" de material con una anchura mayor que su propio tamaño corporal más 2 pies." } },
      { "name": "16. Ocultar Huellas X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "huellas de 10", "duration": "C", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Ocultar Huellas I, salvo que oculta las huellas de 10 seres." } },
      { "name": "17. Correr sin Rastro", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "lanzador", "duration": "C", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Paso sin Rastro, salvo que el lanzador puede moverse al doble de su ritmo normal (ritmo de Carrera)." } },
      { "name": "18. Ocultar Huellas XV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "huellas de 15", "duration": "C", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Ocultar Huellas I, salvo que oculta las huellas de 15 seres." } },
      { "name": "19. Correr sin Rastro Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "lanzador", "duration": "C", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Paso sin Rastro Verdadero, salvo que el lanzador puede moverse al doble de su ritmo normal (ritmo de Carrera)." } },
      { "name": "20. Gran Fusión con lo Orgánico", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Fundirse en lo Orgánico, salvo que el lanzador puede girar dentro del material y percibir el mundo exterior." } },
      { "name": "25. Ocultar Huellas XX", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "huellas de 20", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Ocultar Huellas I, salvo que oculta las huellas de 20 seres." } },
      { "name": "30. Fusión Verdadera con lo Orgánico", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Gran Fusión con lo Orgánico, salvo que el lanzador puede lanzarse hechizos a sí mismo mientras está fundido." } },
      { "name": "50. Ocultar Huellas Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "varía", "duration": "C", "range": "50'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Ocultar Huellas I, salvo que el lanzador puede ocultar por completo sus propias huellas (impidiendo su descubrimiento por cualquier método, incluida la magia) o puede ocultar las huellas de un número de seres igual a su nivel." } }
    ]
