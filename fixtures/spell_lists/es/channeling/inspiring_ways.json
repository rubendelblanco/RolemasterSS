    "description": "Lista Base de Paladín 6.6 - Caminos Inspiradores. Hechizos para infundir valor e inspirar aliados en combate, y hechizos de ataque mental para que un objetivo crea las palabras del lanzador como amistad, razón, cautela o mandato.",
    "spells": [
      { "name": "01. Valor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "10'R", "duration": "1 asalto/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Durante la duración de este hechizo, todos dentro del área de efecto (incluido el lanzador) pueden hacer una segunda TR contra cualquier efecto de miedo o pánico. Esta segunda TR se hace con un modificador adicional de +10." } },
      { "name": "02. Inspiraciones I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 2, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador inspira a todos los aliados dentro del área de efecto (deben ser conscientes del lanzador). Todos los aliados obtienen +5 a ataques cuerpo a cuerpo y maniobras de movimiento durante la duración del hechizo. Este hechizo solo funciona en combate o en momentos de fuerte carga religiosa (p. ej., una arenga antes de una gran batalla). Estos bonificadores no se aplican al lanzador." } },
      { "name": "03. Voz de la Amistad", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 3, "area_of_effect": "1 objetivo", "duration": "varía", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Mientras hablen juntos, el objetivo de este hechizo creerá que el lanzador es un buen amigo y que actúa en su mejor interés." } },
      { "name": "04. Inspiraciones II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 4, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Inspiraciones I, salvo que los bonificadores son +10." } },
      { "name": "05. Voz de la Razón", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 5, "area_of_effect": "1 objetivo", "duration": "varía", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Mientras el lanzador hable, el objetivo creerá que el razonamiento y las ideas que expresa el lanzador son correctos y válidos." } },
      { "name": "06. Inspiraciones III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 6, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Inspiraciones I, salvo que los bonificadores son +15." } },
      { "name": "07. Voz de la Cautela", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 7, "area_of_effect": "1 objetivo", "duration": "varía", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Mientras el lanzador hable, el objetivo se volverá más cauto (menos temerario) y tenderá a obedecer las advertencias del lanzador sin dudar." } },
      { "name": "08. Mandato I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 8, "area_of_effect": "1 objetivo", "duration": "C", "range": "10'/nvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo debe obedecer al lanzador. Sin embargo, no realizará ningún acto que le sea completamente ajeno (p. ej., ninguna sugerencia de suicidio, de cegarse a sí mismo, etc.)." } },
      { "name": "09. Inspiraciones IV", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 9, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Inspiraciones I, salvo que los bonificadores son +20." } },
      { "name": "10. Palabras de Amistad", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 10, "area_of_effect": "varía", "duration": "varía", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Voz de la Amistad, salvo que afecta a todos los que puedan oír al lanzador." } },
      { "name": "11. Inspiraciones V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 11, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Inspiraciones I, salvo que los bonificadores son +25." } },
      { "name": "13. Mandato II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 13, "area_of_effect": "2 objetivos", "duration": "C", "range": "10'/nvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Mandato I, salvo que afecta a dos objetivos." } },
      { "name": "14. Palabras de Razón", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 14, "area_of_effect": "varía", "duration": "varía", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Voz de la Razón, salvo que afecta a todos los que puedan oír al lanzador." } },
      { "name": "15. Inspiraciones VI", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 15, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Inspiraciones I, salvo que los bonificadores son +30." } },
      { "name": "16. Valor Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "10'R", "duration": "1 asalto/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Valor, salvo que la segunda TR tiene éxito automáticamente." } },
      { "name": "17. Inspiraciones VII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 17, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Inspiraciones I, salvo que los bonificadores son +35." } },
      { "name": "18. Palabras de Cautela", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 18, "area_of_effect": "varía", "duration": "varía", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Voz de la Cautela, salvo que afecta a todos los que puedan oír al lanzador." } },
      { "name": "19. Inspiraciones VIII", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 19, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Inspiraciones I, salvo que los bonificadores son +40." } },
      { "name": "20. Voz de la Convicción", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 objetivo", "duration": "varía", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "[Mod. TR: -50] Tras lanzar este hechizo, el lanzador debe decir la verdad (tal como la conoce). Todos los objetivos que fallen su TR creerán que el lanzador dice la pura verdad." } },
      { "name": "25. Inspiraciones Verdaderas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 25, "area_of_effect": "20'R", "duration": "1 asalto/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Inspiraciones I, salvo que los bonificadores son +50." } },
      { "name": "30. Palabras de Convicción", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "varía", "duration": "varía", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Voz de la Convicción, salvo que afecta a todos los que puedan oír al lanzador." } },
      { "name": "50. Maestría de las Inspiraciones", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "varía", "duration": "1 asalto/nvl", "range": "varía", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede usar cualquier hechizo de nivel inferior de esta lista una vez por asalto." } }
    ]
  }
