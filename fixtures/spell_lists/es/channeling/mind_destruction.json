    "description": "Lista Base de Hechicero 9.4 - Destrucción de la Mente. Hechizos de ataque mental que infligen dolor, aturdimiento, desorientación, olvido, mentes en blanco, horror y pérdida de experiencia.",
    "spells": [
      { "name": "01. Dolor Menor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 objetivo", "duration": "10 min/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo pierde el 25% de sus golpes de conmoción restantes (los no recibidos aún). Estos golpes se restauran cuando termina la duración, siempre que el objetivo no haya muerto." } },
      { "name": "02. Sacudidas I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 objetivo", "duration": "1 asalto/10 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo queda aturdido." } },
      { "name": "03. Desorientación", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 objetivo", "duration": "1 día/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo resta 25 a todas las tiradas de orientación y percepción, y 5 a todas las de iniciativa." } },
      { "name": "04. Desequilibrio", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 objetivo", "duration": "1 día/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo resta 25 a todas sus tiradas de maniobra." } },
      { "name": "05. Distorsiones", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 objetivo", "duration": "1 día/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo resta 25 a todas sus tiradas de ataque." } },
      { "name": "06. Sacudidas III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 objetivo", "duration": "3 asaltos/10 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sacudidas I, salvo por la duración." } },
      { "name": "07. Dolor Mayor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 objetivo", "duration": "10 min/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Dolor Menor, salvo que se pierde el 50% de los golpes restantes." } },
      { "name": "08. Olvido", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 objetivo", "duration": "P", "range": "10'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo olvida un periodo de su pasado (1 minuto por nivel), según decida el lanzador." } },
      { "name": "09. Palabra de Dolor", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 9, "area_of_effect": "1 objetivo", "duration": "P", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Dolor Mayor, salvo que los golpes deben curarse con normalidad." } },
      { "name": "10. Choque Mental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 objetivo", "duration": "1 día/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Desorientación, Desequilibrio y Distorsiones (todo a la vez)." } },
      { "name": "11. Muerte de la Mente", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 objetivo", "duration": "P", "range": "50'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "La mente del objetivo se queda en blanco durante 10 minutos cada día, al azar. El objetivo es incapaz de actuar o pensar durante ese periodo." } },
      { "name": "12. Sacudidas V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 objetivo", "duration": "5 asaltos/10 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Sacudidas I, salvo por la duración." } },
      { "name": "13. Desmentalizar", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 objetivo", "duration": "10 asaltos/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "La mente del objetivo queda completamente en blanco durante la duración. No puede percibir eventos, el tiempo ni la actividad. Al terminar la duración, queda aturdido durante 1 asalto tras recuperar la mente." } },
      { "name": "14. Desorientación Masiva", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 objetivo/nvl", "duration": "1 hora/5 fallo", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Desorientación, salvo que afecta a un número de objetivos igual al nivel del lanzador." } },
      { "name": "15. Ruptura Mental", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 objetivo", "duration": "1 día/10 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo queda como un idiota balbuceante. Puede ser guiado, pero no puede realizar ninguna acción." } },
      { "name": "16. Desequilibrio Masivo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 objetivo/nvl", "duration": "1 día/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Desequilibrio, salvo que afecta a un número de objetivos igual al nivel del lanzador." } },
      { "name": "17. Destrucción de la Mente Prolongada", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 objetivo", "duration": "varía", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como cualquier hechizo único de nivel 10 o inferior de esta lista, salvo que el alcance es de 300'." } },
      { "name": "18. Distorsiones Masivas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 objetivo/nvl", "duration": "1 día/5 fallo", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Distorsiones, salvo que afecta a un número de objetivos igual al nivel del lanzador." } },
      { "name": "19. Horror", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "1 objetivo", "duration": "varía", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "[Mod. TR: -20] El objetivo cree que está siendo atacado por una criatura de sus peores miedos. Cada asalto recibe un ataque de la criatura (con un ataque de Artes Marciales Rango I de +100; el daño es real). Sin importar el daño que el objetivo inflija a la criatura, esta solo será derrotada cuando el objetivo supere su TR (una TR cada minuto), o cuando pierda la consciencia." } },
      { "name": "20. Pérdida de Experiencia I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 objetivo", "duration": "P", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El objetivo pierde el 5% de su experiencia acumulada (puntos de experiencia). El objetivo no pierde ningún nivel, solo puntos de experiencia (deberá obtener esa cantidad de más para subir de nivel)." } },
      { "name": "25. Dolor Masivo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 objetivo/nvl", "duration": "10 min/5 fallo", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Dolor Mayor, salvo que afecta a tantos objetivos como el nivel del lanzador, la duración es hasta curarse, y el alcance es de 300'." } },
      { "name": "30. Choque Mental Masivo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 objetivo/nvl", "duration": "1 día/5 fallo", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Choque Mental, salvo que afecta a tantos objetivos como el nivel del lanzador y el alcance es de 300'." } },
      { "name": "50. Desmentalizar Masivo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 objetivo/nvl", "duration": "1 asalto/5 fallo", "range": "300'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Desmentalizar, salvo que afecta a tantos objetivos como el nivel del lanzador y el alcance es de 300'." } }
    ]
