    "description": "Canalización Abierta 2.3 - Maestría de Detección. Hechizos pasivos para detectar reinos de magia, vida, maldiciones, no muertos, trampas, invisibilidad, venenos y poder de hechizos, además de hechizos de localización.",
    "spells": [
      { "name": "01. Detectar Canalización", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Detecta cualquier hechizo u objeto activo del reino de Canalización; el lanzador puede concentrarse en un radio de 5' distinto cada asalto." } },
      { "name": "02. Detectar Esencia", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que el reino es Esencia." } },
      { "name": "03. Detectar Mentalismo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que el reino es Mentalismo." } },
      { "name": "04. Detectar Vida", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que detecta seres vivos." } },
      { "name": "05. Detectar Maldición", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que detecta maldiciones sobre personas u objetos." } },
      { "name": "06. Detectar No Muertos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que detecta la presencia de No Muertos." } },
      { "name": "07. Detectar Trampas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que da un 75% de probabilidad de detectar una trampa (los modificadores de sofisticación de la trampa pueden reducir o aumentar esta probabilidad)." } },
      { "name": "08. Perfil Vital", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "1 objetivo", "duration": "—", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que analiza a un ser vivo; da raza, edad y estado de salud actual." } },
      { "name": "09. Detectar Invisible", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que detecta cosas invisibles. Todos los ataques contra un objetivo invisible sufren una penalización de -50 (en vez de la -100 estándar)." } },
      { "name": "10. Percibir Poder I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que da una estimación del poder (es decir, nivel) de la persona, objeto o hechizo examinado." } },
      { "name": "11. Análisis de Veneno", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 objetivo", "duration": "—", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que da un análisis de cualquier veneno en un único objeto o ser." } },
      { "name": "13. Tipificar Poder", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que analiza el tipo general de hechizo (en objeto o lanzado) y de qué lista de hechizos procede. En el caso de una persona, da su profesión exacta." } },
      { "name": "15. Detectar Hechizo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que detecta cualquier hechizo que se haya lanzado alguna vez en el área examinada." } },
      { "name": "17. Percibir Poder II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "50'R", "duration": "1 min/nvl (C)", "range": "500'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Percibir Poder I, salvo que el alcance es 500' y el área es un radio de 50'." } },
      { "name": "18. Localización", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "lanzador", "duration": "—", "range": "300'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Da la dirección y distancia a cualquier objeto o lugar concreto que el lanzador conozca o le hayan descrito en detalle. El lanzador debe conocer las dimensiones exactas del objeto (con un margen del 10%) y al menos otros dos atributos que lo hagan único (color, textura, peso, etc.)." } },
      { "name": "20. Análisis de Maldición", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "5'R", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que se puede analizar una maldición para conocer su nivel, efecto y cura necesaria." } },
      { "name": "25. Análisis Vital", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 objetivo", "duration": "—", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Perfil Vital, salvo que también da la profesión exacta, la alineación y otros detalles pertinentes." } },
      { "name": "30. Detectar Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "varía", "duration": "1 min/nvl (C)", "range": "50'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Detectar Canalización, salvo que cualquiera de los hechizos de nivel inferior de esta lista puede usarse una vez por asalto." } },
      { "name": "50. Localización Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "lanzador", "duration": "—", "range": "1 milla/nvl", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Localización, salvo que el alcance es de 1 milla por nivel." } }
    ]
