    "description": "Canalización Abierta 2.8 - Camino del Sonido. Hechizos de habla, silencio, muros de sonido, zonas de quietud y amplificación de voz.",
    "spells": [
      { "name": "01. Habla I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 objetivo", "duration": "C", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede comunicar ideas básicas en el idioma de un ser concreto (p. ej., hambre, sed, baño, paz, etc.). Durante la duración del hechizo, el objetivo tiene el equivalente al rango de habilidad 2 en ese idioma." } },
      { "name": "03. Quietud I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea un área de 1' de radio en torno al objetivo, dentro y fuera de la cual el sonido no puede viajar; si el punto está sobre un objeto o ser móvil, se moverá con él. +25 a cualquier maniobra de Acecho." } },
      { "name": "05. Muro de Sonido I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "20'x20'", "duration": "10 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea un plano (hasta 20' x 20') a través del cual el sonido no puede pasar." } },
      { "name": "06. Habla II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 objetivo", "duration": "C", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Habla I, salvo que el objetivo puede comunicar conceptos más complejos, aunque hay una buena probabilidad de malentendidos. Durante la duración del hechizo, el objetivo tiene el equivalente al rango de habilidad 4 en ese idioma." } },
      { "name": "07. Silencio I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "10'R", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Quietud I, salvo que el radio es de 10'." } },
      { "name": "08. Quietud III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "3 objetivos", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Quietud I, salvo que pueden afectarse 3 objetivos." } },
      { "name": "10. Muro de Sonido V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "(20'x20')x5", "duration": "10 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Muro de Sonido I, salvo que se crean 5 muros de este tipo. Cada Muro de Sonido debe estar conectado a al menos otro Muro de Sonido." } },
      { "name": "11. Quietud V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "5 objetivos", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Quietud I, salvo que pueden afectarse 5 objetivos." } },
      { "name": "13. Silencio V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "50'R", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Silencio I, salvo que el radio es de 50'." } },
      { "name": "15. Habla III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 objetivo", "duration": "C", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Habla II, salvo que el objetivo es razonablemente fluido en el idioma. Su acento es imperfecto, pero hay solo una leve probabilidad de malentendido. Durante la duración del hechizo, el objetivo tiene el equivalente al rango de habilidad 6 en ese idioma." } },
      { "name": "17. Resonar", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 17, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede hablar 5 veces más alto de lo normal." } },
      { "name": "20. Silencio X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "100'R", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Silencio I, salvo que el radio es de 100'." } },
      { "name": "25. Muros de Sonido Masivos", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "varía", "duration": "10 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Muro de Sonido V, salvo que pueden crearse tantos Muros de Sonido como el nivel del objetivo." } },
      { "name": "30. Quietud Masiva", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "varía", "duration": "1 min/nvl", "range": "100'", "type": "E", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Quietud I, salvo que pueden afectarse tantos objetivos como el nivel del objetivo." } },
      { "name": "50. Habla Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Habla III, salvo por la duración, y el objetivo habla el idioma especificado como si fuera nativo. Durante la duración del hechizo, el objetivo tiene el equivalente al rango de habilidad 8 en ese idioma." } }
    ]
