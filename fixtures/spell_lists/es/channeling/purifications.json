      { "name": "01. Purificación de Enfermedad", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "1 objetivo", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Detiene la infección y/o propagación de una enfermedad en 1 objetivo después de haberla contraído. No se producirá más daño en las áreas del cuerpo no infectadas." } },
