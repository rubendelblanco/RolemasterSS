      { "name": "13. Apuntar Falso I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 13, "area_of_effect": "1 proyectil", "duration": "—", "range": "100'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede desviar cualquier proyectil que pase a menos de 100' de él (el lanzador debe poder ver el proyectil). Esto hace que el proyectil falle automáticamente." } },
