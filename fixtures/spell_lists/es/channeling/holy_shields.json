    "description": "Lista Base de Paladín 6.5 - Escudos Sagrados. Hechizos protectores: plegarias de protección, aura, escudo, difuminado, soportar golpes extra, y desviar proyectiles y ataques cuerpo a cuerpo.",
    "spells": [
      { "name": "01. Plegaria de Protección I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 1, "area_of_effect": "10'R", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Todos en el área de efecto que estén alineados con el lanzador (a discreción del DJ) restan 5 a todos los ataques elementales contra ellos. También pueden sumar 5 a todas las TR contra hechizos. Estos bonificadores no se aplican al lanzador." } },
      { "name": "02. Aura", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea un aura brillante en torno al lanzador, haciéndolo parecer más poderoso y restando 10 a todos los ataques contra él." } },
      { "name": "03. Escudo", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 3, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Crea un escudo de fuerza invisible frente al lanzador. Funciona como un escudo normal (restando 25 a los ataques correspondientes, etc.), salvo que no ocupa una mano. Este hechizo no puede combinarse con un escudo \"real\"." } },
      { "name": "04. Difuminado", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 4, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Hace que el objetivo aparezca borroso a los atacantes. Resta 10 a todos los ataques dirigidos contra el objetivo." } },
      { "name": "05. Sin Dolor I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 5, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "El lanzador puede soportar un 25% adicional de sus golpes de conmoción totales antes de desmayarse. Los golpes se siguen recibiendo y permanecen cuando el hechizo termina." } },
      { "name": "06. Plegaria de Protección II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "10'R", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Plegaria de Protección I, salvo que los bonificadores son de 10." } },
      { "name": "07. Deflexiones I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 7, "area_of_effect": "1 proyectil", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede desviar cualquier proyectil que pase a menos de 10' de él (el lanzador debe poder ver el proyectil). Esto resta 100 al ataque del proyectil." } },
      { "name": "08. Aura Verdadera", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "lanzador", "duration": "10 min/nvl", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Aura, salvo que hace que el lanzador parezca muy poderoso; resta 15 a todos los ataques contra él." } },
      { "name": "09. Desviar Hoja I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 9, "area_of_effect": "1 ataque", "duration": "—", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede desviar cualquier ataque cuerpo a cuerpo que pueda ver (y esté dentro del alcance). Esto resta 50 al ataque." } },
      { "name": "10. Sin Dolor II", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 10, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "U", "subType": "s", "attack_table": "", "skillName": "", "description": "Como Sin Dolor I, salvo que puede soportarse un 50% adicional." } },
