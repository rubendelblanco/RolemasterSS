    "description": "Canalización Abierta 2.6 - Ley de la Naturaleza. Hechizos de saber sobre plantas/hierbas/piedras, lenguas animales y vegetales, dominio y empatía animal, y percepción de la naturaleza.",
    "spells": [
      { "name": "02. Saber de Plantas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 planta", "duration": "—", "range": "10'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador aprende la naturaleza, historia y valor de cualquier 1 planta." } },
      { "name": "03. Saber de Hierbas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 3, "area_of_effect": "1 hierba", "duration": "—", "range": "10'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede entender la naturaleza, origen y valor de cualquier 1 hierba; si la planta no es una hierba, no se obtendrá información." } },
      { "name": "05. Saber de Piedras", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 piedra", "duration": "—", "range": "10'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador aprende la naturaleza, historia y origen de cualquier 1 piedra." } },
      { "name": "06. Crecimiento Rápido", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 especie", "duration": "1 día", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede multiplicar por 10 la velocidad de crecimiento de cualquier 1 especie de planta dentro del radio." } },
      { "name": "07. Lenguas Animales", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador entender y \"hablar\" el idioma de cualquier 1 especie animal." } },
      { "name": "09. Dominio Animal I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 animal", "duration": "C", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El lanzador puede controlar las acciones de cualquier 1 animal." } },
      { "name": "10. Percepción de la Naturaleza I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "lanzador", "duration": "C", "range": "100'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede monitorizar la actividad animada en el área (será consciente de movimientos sutiles). Durante la duración del hechizo, el lanzador no puede moverse." } },
      { "name": "11. Lenguas Vegetales", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "lanzador", "duration": "1 min/nvl", "range": "sí mismo", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Permite al lanzador entender y \"hablar\" el idioma de cualquier 1 especie vegetal." } },
      { "name": "12. Dominio Animal III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "3 animales", "duration": "C", "range": "100'", "type": "F", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Dominio Animal I, salvo que el lanzador puede controlar 3 animales." } },
      { "name": "13. Empatía Animal", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "1 animal", "duration": "C", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede entender y/o visualizar los pensamientos y emociones de cualquier 1 animal." } },
      { "name": "14. Control Vegetal I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 14, "area_of_effect": "1 planta", "duration": "1 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "El lanzador puede controlar los procesos automáticos y/o mentales de cualquier 1 planta. También puede controlar sus movimientos. Este hechizo no permite movimiento más allá de lo normalmente posible." } },
      { "name": "15. Habla de Piedra", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 piedra", "duration": "1 min/nvl", "range": "sí mismo", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede comunicarse con cualquier 1 piedra si esta posee alguna cualidad animada (p. ej., el lanzador podría hablar con una piedra sagrada que posea inteligencia)." } },
      { "name": "16. Producción de Hierba", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "1 semilla", "duration": "P", "range": "toque", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede hacer crecer una hierba plantando la semilla adecuada. La hierba es estéril; el crecimiento tarda 1-10 asaltos." } },
      { "name": "18. Dominio Animal V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "5 animales", "duration": "C", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Dominio Animal I, salvo que el lanzador puede controlar 5 animales." } },
      { "name": "19. Control Vegetal III", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "3 plantas", "duration": "1 min/nvl", "range": "100'", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Control Vegetal I, salvo que el lanzador puede controlar cualquier 3 plantas." } },
      { "name": "20. Percepción de la Naturaleza V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "lanzador", "duration": "C", "range": "500'", "type": "I", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Percepción de la Naturaleza I, salvo que el radio es de 500'." } },
      { "name": "25. Empatía de la Tierra", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 objeto", "duration": "1 min/nvl", "range": "100'", "type": "P", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede entender y/o visualizar los pensamientos y emociones de cualquier 1 animal, planta, piedra u objeto orgánico muerto. El lanzador puede cambiar de objetivo una vez por asalto." } },
      { "name": "30. Dominio", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 30, "area_of_effect": "1 especie", "duration": "C", "range": "10'/nvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Dominio Animal I, salvo que el lanzador puede controlar a todos los animales de una especie dada dentro de un alcance igual a 10' por su nivel (p. ej., a nivel 30 podría controlar a todos los hurones o visones en 300')." } },
      { "name": "50. Dominio Animal Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 50, "area_of_effect": "1 especie", "duration": "P", "range": "10'/nvl", "type": "F", "subType": "m", "attack_table": "", "skillName": "", "description": "Como Dominio Animal I, salvo que la duración es permanente y no requiere concentración. En un momento dado, solo puede haber 1 animal controlado por el lanzador mediante este hechizo." } }
    ]
  }
