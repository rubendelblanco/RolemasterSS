    "description": "Canalización Abierta 2.5 - Movimientos Elevados. Hechizos para caminar o correr por bordes, ramas, piedra, agua y viento, fundirse en material orgánico y regresar a un santuario guardado.",
    "spells": [
      { "name": "02. Caminar por Bordes", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 2, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede caminar por bordes estrechos (hasta 2\" de ancho) que puedan soportar su peso. Normalmente no se requieren tiradas de maniobra." } },
      { "name": "04. Caminar por Ramas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 4, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede caminar por ramas de árbol como si estuviera en terreno llano." } },
      { "name": "05. Caminar sobre Piedra", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 5, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede caminar por superficies de piedra de hasta 60° como si estuviera en terreno llano." } },
      { "name": "06. Caminar sobre Agua", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 6, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede caminar sobre el agua como si estuviera en terreno llano; no puede usarse sobre agua agitada." } },
      { "name": "07. Fundirse en lo Orgánico", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 7, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede fundirse en material orgánico (vivo o muerto). Mientras esté fundido, no puede moverse ni percibir. Al emerger del material, puede salir por cualquier cara o lado de este. El objetivo no puede moverse \"a través\" de material con una anchura mayor que su propio tamaño corporal más 2 pies." } },
      { "name": "08. Guardar Santuario", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 8, "area_of_effect": "lanzador", "duration": "P", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador \"guarda\" un lugar para usarlo con otros hechizos de esta lista. Al lanzar este hechizo, el lanzador debe meditar durante una hora en el lugar que quedará guardado. El lanzador solo puede tener un santuario guardado a la vez. Mientras este lugar permanezca \"guardado\", se detectará como un sitio mágico (es decir, \"sagrado\")." } },
      { "name": "09. Correr por Ramas", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 9, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Caminar por Ramas, salvo que el objetivo puede correr." } },
      { "name": "10. Correr sobre Piedra", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 10, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Caminar sobre Piedra, salvo que el objetivo puede correr." } },
      { "name": "11. Correr sobre Agua", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 11, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Caminar sobre Agua, salvo que el objetivo puede correr." } },
      { "name": "12. Caminar sobre Viento", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 12, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El objetivo puede caminar sobre aire en calma. Este hechizo solo permite movimiento horizontal. El movimiento vertical debe lograrse por otros medios." } },
      { "name": "13. Regreso I", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 13, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede regresar a su santuario guardado siempre que este no esté a más de 1 milla de distancia." } },
      { "name": "15. Gran Fusión con lo Orgánico", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 15, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Fundirse en lo Orgánico, salvo que el objetivo puede girar dentro del material y percibir el mundo exterior a él." } },
      { "name": "16. Regreso V", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 16, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Regreso I, salvo que el santuario puede estar hasta a 5 millas de distancia." } },
      { "name": "18. Correr sobre Viento", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 18, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Caminar sobre Viento, salvo que el objetivo puede correr." } },
      { "name": "19. Regreso X", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 19, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Regreso I, salvo que el santuario puede estar hasta a 10 millas de distancia." } },
      { "name": "20. Fusión Verdadera con lo Orgánico", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 20, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Gran Fusión con lo Orgánico, salvo que el objetivo puede lanzarse hechizos a sí mismo mientras está fundido." } },
      { "name": "25. Correr sobre Viento Verdadero", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": false, "level": 25, "area_of_effect": "1 objetivo", "duration": "1 min/nvl", "range": "10'", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Correr sobre Viento, salvo que el objetivo puede correr hasta el doble de su velocidad normal sobre aire en calma sin gastar energía." } },
      { "name": "30. Palabra de Regreso", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 30, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "Como Regreso I, salvo que el santuario puede estar a cualquier distancia, hasta 10 millas por nivel del lanzador." } },
      { "name": "50. Re-regreso", "img": "systems/rmss/assets/default/spell.svg", "system": { "favorite": false, "instant": true, "level": 50, "area_of_effect": "lanzador", "duration": "—", "range": "sí mismo", "type": "U", "subType": "-", "attack_table": "", "skillName": "", "description": "El lanzador puede ir a su santuario (como con Palabra de Regreso), permanecer hasta 1 asalto por nivel, y luego regresar al punto donde lanzó el hechizo (haciendo así un viaje de ida y vuelta)." } }
    ]
  }
