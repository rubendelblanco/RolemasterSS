          "level": 2,
          "area_of_effect": "1 objeto",
          "duration": "—",
          "range": "touch",
          "type": "I",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "Como Valorar Joya/Metal, salvo que determina el valor del objeto incluyendo su artesanía. No incluye capacidades mágicas."
        }
      },
