          "level": 1,
          "area_of_effect": "10'R/nvl",
          "duration": "C",
          "range": "self",
          "type": "U",
          "subType": "-",
          "attack_table": "",
          "skillName": "",
          "description": "El lanzador es consciente de la presencia de todos los seres sintientes/pensantes dentro de su alcance."
        }
      },
      {
        "name": "02. Percibir I",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": true,
          "level": 2,
          "area_of_effect": "1 objetivo",
          "duration": "—",
          "range": "10'/nvl",
          "type": "P",
          "subType": "m",
          "attack_table": "",
          "skillName": "",
          "description": "El lanzador obtiene una idea general de la raza y el nivel de un ser. El objetivo debe haber sido localizado previamente mediante Presencia o Presencia Verdadera."
        }
      },
      {
        "name": "03. Impronta Mental",
        "img": "systems/rmss/assets/default/spell.svg",
        "system": {
          "favorite": false,
          "instant": true,
          "level": 3,
          "area_of_effect": "1 objetivo",
          "duration": "—",
          "range": "10'/nvl",
          "type": "P",
          "subType": "m",
          "attack_table": "",
          "skillName": "",
          "description": "Como Percibir I, salvo que el lanzador almacena el patrón mental del objetivo. Puede usarse con otros hechizos (tanto de esta lista como de otras). El lanzador solo puede tener tantos patrones almacenados como la suma de sus atributos temporales de Memoria y Presencia (no los bonos). El lanzador puede liberar un patrón almacenado en cualquier momento (el DJ debería exigir que el personaje lleve constancia de todos los patrones que tiene almacenados)."
        }
      },
      {
        "name": "04. Transferir Impronta Mental",
